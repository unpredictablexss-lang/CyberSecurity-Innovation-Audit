{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohscanner.a-exp-01-human-review-form-v1",
  "type": "object",
  "required": [
    "experiment_item_id",
    "group",
    "repetition",
    "reviewer_id",
    "input_bundle_sha256",
    "evidence_gate",
    "mechanism_label",
    "product_assessment",
    "evidence_gate_status",
    "claims",
    "missing_evidence",
    "limitations",
    "blindness_checks"
  ],
  "properties": {
    "experiment_item_id": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "enum": [
        "R0",
        "R1",
        "R2"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timing": {
      "type": "object"
    },
    "tool_usage": {
      "type": "object"
    },
    "evidence_gate": {
      "type": "object"
    },
    "mechanism_label": {
      "enum": [
        "vulnerable",
        "fixed",
        "safe",
        "unrelated",
        "unknown"
      ]
    },
    "product_assessment": {
      "enum": [
        "reportable_vulnerability",
        "not_reportable",
        "unknown"
      ]
    },
    "evidence_gate_status": {
      "enum": [
        "met",
        "partial",
        "not_met",
        "unknown"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommended_probes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blindness_checks": {
      "type": "object",
      "required": [
        "truth_hidden",
        "historical_labels_hidden",
        "other_reviews_hidden",
        "no_mutation"
      ]
    }
  },
  "additionalProperties": false
}
