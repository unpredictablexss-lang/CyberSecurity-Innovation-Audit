{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohscanner.a-exp-01-run-record-v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "group",
    "repetition",
    "seed",
    "experiment_item_id",
    "input_bundle_sha256",
    "prompt_sha256",
    "status",
    "model",
    "sampling",
    "usage",
    "cost",
    "timing",
    "tool_calls",
    "output",
    "failure",
    "integrity",
    "input_bundle_serialization",
    "attempt_log",
    "persisted_tool_results"
  ],
  "properties": {
    "schema_version": {
      "const": "ohscanner.a-exp-01-run-record-v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "const": "A-EXP-01"
    },
    "group": {
      "enum": [
        "R0",
        "R1",
        "R2"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "experiment_item_id": {
      "type": "string",
      "minLength": 1
    },
    "input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timed_out",
        "budget_exhausted",
        "cancelled",
        "unexecuted"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "binding_id",
        "provider",
        "model_name",
        "model_version",
        "api_version",
        "endpoint_kind",
        "api_endpoint",
        "data_processing_record_sha256",
        "pricing_record_id"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint_or_runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "binding_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint_kind": {
          "enum": [
            "remote_http_api",
            "local_runtime",
            null
          ]
        },
        "api_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_processing_record_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "pricing_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": [
        "temperature",
        "top_p",
        "seed",
        "max_output_tokens",
        "tool_choice"
      ],
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_choice": {
          "enum": [
            "none",
            "auto"
          ]
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "provider_usage_raw"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "provider_usage_raw": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "pricing_record",
        "computed_by"
      ],
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "pricing_record": {
          "type": [
            "string",
            "null"
          ]
        },
        "computed_by": {
          "enum": [
            "provider",
            "pricing_record",
            "local_compute_not_costed",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": [
        "started_at",
        "ended_at",
        "wall_ms",
        "active_ms"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "wall_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_call_id",
          "tool_id",
          "tool_version",
          "request",
          "request_sha256",
          "status",
          "evidence_ids",
          "coverage",
          "truncation",
          "output_bytes",
          "elapsed_ms",
          "failure",
          "attempt_id",
          "experiment_item_id"
        ],
        "properties": {
          "tool_call_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "tool_version": {
            "type": "string"
          },
          "request": {
            "type": "object"
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "not_found",
              "out_of_scope",
              "failed",
              "timed_out",
              "budget_exhausted"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object"
          },
          "truncation": {
            "type": "object"
          },
          "output_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "failure": {
            "type": [
              "object",
              "null"
            ]
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "experiment_item_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "required": [
        "status",
        "payload",
        "output_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid_json",
            "invalid_json",
            "missing",
            "timeout",
            "budget_exhausted"
          ]
        },
        "payload": {
          "type": [
            "object",
            "null"
          ]
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "status",
        "failure_code",
        "message",
        "retries",
        "timed_out",
        "budget_exhausted"
      ],
      "properties": {
        "status": {
          "enum": [
            "none",
            "failed",
            "timed_out",
            "budget_exhausted",
            "cancelled"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "budget_exhausted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "ground_truth_visible",
        "self_eval_used_as_truth",
        "historical_records_modified",
        "candidate_id_modified",
        "confirmed_status_modified"
      ],
      "properties": {
        "ground_truth_visible": {
          "const": false
        },
        "self_eval_used_as_truth": {
          "const": false
        },
        "historical_records_modified": {
          "const": false
        },
        "candidate_id_modified": {
          "const": false
        },
        "confirmed_status_modified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "input_bundle_serialization": {
      "const": "ohscanner.canonical-json-v1"
    },
    "attempt_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "ordinal",
          "kind",
          "logical_id",
          "retry_of_attempt_id",
          "run_id",
          "experiment_item_id",
          "repetition",
          "status",
          "started_at",
          "ended_at",
          "wall_ms",
          "usage",
          "cost",
          "tool_call_id",
          "budget_effects",
          "prior_attempt_preserved",
          "failure"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "human_review",
              "model_provider",
              "tool"
            ]
          },
          "logical_id": {
            "type": "string",
            "minLength": 1
          },
          "retry_of_attempt_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{16}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "experiment_item_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "repetition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timed_out",
              "budget_exhausted",
              "cancelled"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "wall_ms": {
            "type": "integer",
            "minimum": 0
          },
          "usage": {
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "provider_usage_raw"
            ],
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "provider_usage_raw": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "cost": {
            "type": "object",
            "required": [
              "amount",
              "currency",
              "pricing_record_id",
              "computed_by"
            ],
            "properties": {
              "amount": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pricing_record_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "computed_by": {
                "enum": [
                  "provider",
                  "pricing_record",
                  "local_compute_not_costed",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "budget_effects": {
            "type": "object",
            "required": [
              "tool_call",
              "token_usage_if_any",
              "wall_time",
              "repetition",
              "source_and_output_bytes"
            ],
            "properties": {
              "tool_call": {
                "enum": [
                  "always",
                  "if_used",
                  "not_applicable"
                ]
              },
              "token_usage_if_any": {
                "enum": [
                  "always",
                  "if_used",
                  "not_applicable"
                ]
              },
              "wall_time": {
                "enum": [
                  "always",
                  "if_used",
                  "not_applicable"
                ]
              },
              "repetition": {
                "enum": [
                  "always",
                  "if_used",
                  "not_applicable",
                  "never"
                ]
              },
              "source_and_output_bytes": {
                "enum": [
                  "always",
                  "if_used",
                  "not_applicable"
                ]
              }
            },
            "additionalProperties": false
          },
          "prior_attempt_preserved": {
            "type": "boolean"
          },
          "failure": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "persisted_tool_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "persistence_id",
          "tool_call_id",
          "attempt_id",
          "experiment_item_id",
          "persisted",
          "artifact_sha256",
          "evidence_ids"
        ],
        "properties": {
          "persistence_id": {
            "type": "string",
            "minLength": 1
          },
          "tool_call_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "experiment_item_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "persisted": {
            "const": true
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
