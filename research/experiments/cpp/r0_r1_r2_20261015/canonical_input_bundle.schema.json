{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohscanner.a-exp-01-canonical-input-bundle-schema-v1",
  "type": "object",
  "required": [
    "bundle_schema_version",
    "serialization",
    "experiment_id",
    "experiment_item_id",
    "group",
    "repetition",
    "seed",
    "prompt",
    "candidate",
    "evidence_catalog_scope",
    "contract_files",
    "input_files"
  ],
  "properties": {
    "bundle_schema_version": {
      "const": "ohscanner.a-exp-01-input-bundle-v1"
    },
    "serialization": {
      "const": "ohscanner.canonical-json-v1"
    },
    "experiment_id": {
      "const": "A-EXP-01"
    },
    "experiment_item_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "group": {
      "enum": [
        "R0",
        "R1",
        "R2"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "seed": {
      "type": "integer",
      "enum": [
        20261015,
        20261016,
        20261017
      ]
    },
    "prompt": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object"
    },
    "evidence_catalog_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "contract_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "optional_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
