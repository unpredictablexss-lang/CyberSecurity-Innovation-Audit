From: baldnotstronger <17770177822@163.com>
Date: Mon, 19 Oct 2026 13:17:07 +0800
Subject: [PATCH 1/4] fix(cpp): detect uncontained DeleteFile path traversal

---
 .../detectors/cpp/path_traversal_detector.py  | 57 +++++++++++-
 .../test_cpp_path_traversal_detector.py       | 93 +++++++++++++++++++
 2 files changed, 149 insertions(+), 1 deletion(-)

diff --git a/src/ohscanner/detectors/cpp/path_traversal_detector.py b/src/ohscanner/detectors/cpp/path_traversal_detector.py
index f8bd1a3..2593666 100644
--- a/src/ohscanner/detectors/cpp/path_traversal_detector.py
+++ b/src/ohscanner/detectors/cpp/path_traversal_detector.py
@@ -52,6 +52,8 @@ _SAFE_FILENAME = re.compile(
     r"\s*\.\s*filename\s*\(\s*\)"
 )
 _CANONICAL = re.compile(r"(?:weakly_)?canonical\s*\(")
+_REVIEWED_FILE_DELETE = "DeleteFile"
+_REVIEWED_FILE_DELETE_RECEIVER = re.compile(r"(?P<receiver>[A-Za-z_]\w*)\s*(?:\.|->)\s*$")
 _SINK_CALLS = {
     "open": (0,),
     "openat": (1,),
@@ -111,6 +113,31 @@ class _CallSite:
     assigned_to: str = ""
 
 
+def _call_arguments(function: "_Function", masked: str, match: re.Match[str]) -> Tuple[str, ...]:
+    open_pos = function.body_start + 1 + match.end() - 1
+    depth = 1
+    cursor = open_pos + 1
+    while cursor < function.body_end - 1 and depth:
+        if masked[cursor] == "(":
+            depth += 1
+        elif masked[cursor] == ")":
+            depth -= 1
+        cursor += 1
+    return () if depth else _split_args(masked[open_pos + 1:cursor - 1])
+
+
+def _reviewed_member_file_delete(
+    function: "_Function", masked: str, match: re.Match[str]
+) -> Tuple[int, str] | None:
+    absolute = function.body_start + 1 + match.start()
+    prefix = masked[max(function.body_start + 1, absolute - 96):absolute]
+    receiver = _REVIEWED_FILE_DELETE_RECEIVER.search(prefix)
+    if not receiver or receiver.group("receiver").lower() != "fileutils":
+        return None
+    args = _call_arguments(function, masked, match)
+    return (absolute, args[0]) if len(args) == 1 and args[0].strip() else None
+
+
 def _split_args(value: str) -> Tuple[str, ...]:
     parts: List[str] = []
     start = 0
@@ -470,7 +497,8 @@ def _analyze_unit(unit: SourceUnit) -> Tuple[List[DetectorFinding], List[str], b
                 continue
             args = _split_args(masked[open_pos + 1:cursor - 1])
             if any(_identifiers(arg) & flow for arg in args):
-                unresolved_path_calls.add(name)
+                if name != _REVIEWED_FILE_DELETE or not _reviewed_member_file_delete(function, masked, call):
+                    unresolved_path_calls.add(name)
         # Member calls are excluded: project methods named open/remove/unlink
         # are not silently treated as libc sinks.
         for match in _CALL.finditer(function.body):
@@ -509,6 +537,32 @@ def _analyze_unit(unit: SourceUnit) -> Tuple[List[DetectorFinding], List[str], b
                     findings.append(_finding(unit, absolute, name))
                 sinks.append((function, absolute, name, ",".join(sorted(path_vars))))
 
+        # The reviewed project file-delete wrapper is a member call. Accept
+        # only the exact `fileUtils.DeleteFile(path)` shape; unknown receivers,
+        # arities and static/wrapper overloads remain unresolved rather than
+        # being guessed as equivalent to libc deletion semantics.
+        for match in _ANY_CALL.finditer(function.body):
+            if match.group("name") != _REVIEWED_FILE_DELETE:
+                continue
+            parsed = _reviewed_member_file_delete(function, masked, match)
+            if parsed is None:
+                if any(_identifiers(arg) & flow for arg in _call_arguments(function, masked, match)):
+                    unresolved_path_calls.add(_REVIEWED_FILE_DELETE)
+                continue
+            absolute, path_arg = parsed
+            path_vars = _identifiers(path_arg) & flow
+            if not path_vars:
+                continue
+            original_body = unit.text[function.body_start + 1:function.body_end - 1]
+            sink_offset = absolute - function.body_start - 1
+            safe = all(
+                _safe_path_value(function, variable, flow, original_body, sink_offset)
+                for variable in path_vars
+            )
+            if not safe:
+                findings.append(_finding(unit, absolute, _REVIEWED_FILE_DELETE))
+            sinks.append((function, absolute, _REVIEWED_FILE_DELETE, ",".join(sorted(path_vars))))
+
     has_source = bool(sources or any(receivers.values()))
     if unresolved_path_calls:
         limitations.append(
@@ -567,3 +621,4 @@ class CppPathTraversalDetector:
             analyzed_files=tuple(analyzed), findings=_stable_findings(findings),
             limitations=tuple(sorted(set(limitations))),
         )
+
diff --git a/tests/detectors/test_cpp_path_traversal_detector.py b/tests/detectors/test_cpp_path_traversal_detector.py
index fbf39cf..84891a3 100644
--- a/tests/detectors/test_cpp_path_traversal_detector.py
+++ b/tests/detectors/test_cpp_path_traversal_detector.py
@@ -52,6 +52,16 @@ class CppPathTraversalDetectorTests(unittest.TestCase):
         unit = make_unit(FIXTURES / name, parse_status)
         return self.detector.detect(make_context(unit), (unit,)), unit
 
+    def run_text(self, name: str, text: str):
+        unit = SourceUnit(
+            path="tests/detectors/fixtures/cpp_path_traversal/" + name,
+            language="cpp",
+            text=text,
+            sha256=hashlib.sha256(text.encode("utf-8")).hexdigest(),
+            parse_status="complete",
+        )
+        return self.detector.detect(make_context(unit), (unit,)), unit
+
     def test_identity_and_positive_file_operation_controls(self) -> None:
         self.assertEqual(self.detector.detector_id, "ohscanner.cpp.path_traversal")
         self.assertEqual(self.detector.version, RULE_VERSION)
@@ -161,5 +171,88 @@ class CppPathTraversalDetectorTests(unittest.TestCase):
         self.assertIn("RuntimeError", " ".join(failed_closed.limitations))
 
 
+    def test_contacts_exact_excerpt_directly_hits_reviewed_member_delete(self) -> None:
+        run, unit = self.run_fixture("contacts_exact_excerpt.cpp")
+        self.assertEqual(run.status, "blocked")
+        delete_findings = [item for item in run.findings if item.symbol == "DeleteFile"]
+        self.assertTrue(delete_findings, "the exact excerpt must directly produce DeleteFile candidates")
+        self.assertEqual(len(delete_findings), 3)
+        for finding in delete_findings:
+            self.assertEqual(finding.file, unit.path)
+            self.assertEqual(finding.rule_id, RULE_ID)
+            self.assertEqual(finding.candidate_cwe, "CWE-22")
+            self.assertEqual(finding.source_sha256, unit.sha256)
+
+    def test_reviewed_member_delete_fixed_basename_canonical_and_allowlist(self) -> None:
+        prefix = (
+            "struct DataShareValuesBucket { std::string GetString(const std::string &) const; };\n"
+            "struct FileUtils { void DeleteFile(const std::string &); };\n"
+        )
+        cases = {
+            "member_fixed_basename.cpp": prefix + (
+                "void f(DataShareValuesBucket &value) { auto input = value.GetString(\"field\"); "
+                "std::string name = std::filesystem::path(input).filename(); "
+                "FileUtils fileUtils; fileUtils.DeleteFile(name); }\n"
+            ),
+            "member_fixed_canonical_containment.cpp": prefix + (
+                "void f(DataShareValuesBucket &value, const std::string &root) { "
+                "auto input = value.GetString(\"field\"); "
+                "auto rootCanon = std::filesystem::canonical(root); "
+                "auto candidate = std::filesystem::canonical(root / input); "
+                "auto rel = candidate.lexically_relative(rootCanon); "
+                "if (rel.empty() || *rel.begin() == \"..\") { return; } "
+                "FileUtils fileUtils; fileUtils.DeleteFile(candidate); }\n"
+            ),
+            "member_fixed_literal_allowlist.cpp": prefix + (
+                "void f(DataShareValuesBucket &value) { auto input = value.GetString(\"field\"); "
+                "if (input != \"a.txt\" && input != \"b.txt\") { return; } "
+                "FileUtils fileUtils; fileUtils.DeleteFile(input); }\n"
+            ),
+        }
+        for name, text in cases.items():
+            run, _ = self.run_text(name, text)
+            self.assertEqual(run.status, "completed", name)
+            self.assertEqual(run.findings, (), name)
+
+    def test_reviewed_member_delete_no_source_and_unrelated_do_not_false_positive(self) -> None:
+        prefix = (
+            "struct DataShareValuesBucket { std::string GetString(const std::string &) const; };\n"
+            "struct FileUtils { void DeleteFile(const std::string &); };\n"
+        )
+        no_source = prefix + (
+            "void f(const std::string &path) { FileUtils fileUtils; fileUtils.DeleteFile(path); }\n"
+        )
+        run, _ = self.run_text("member_no_source.cpp", no_source)
+        self.assertEqual(run.status, "completed")
+        self.assertEqual(run.findings, ())
+        unrelated, _ = self.run_fixture("unrelated_same_api_name.cpp")
+        self.assertEqual(unrelated.status, "completed")
+        self.assertEqual(unrelated.findings, ())
+
+    def test_reviewed_member_delete_unknown_shapes_fail_closed_without_findings(self) -> None:
+        prefix = (
+            "struct DataShareValuesBucket { std::string GetString(const std::string &) const; };\n"
+            "struct FileUtils { void DeleteFile(const std::string &); };\n"
+        )
+        cases = {
+            "member_unknown_receiver.cpp": prefix + (
+                "void f(DataShareValuesBucket &value) { auto input = value.GetString(\"field\"); "
+                "Storage storage; storage.DeleteFile(input); }\n"
+            ),
+            "member_multi_arg.cpp": prefix + (
+                "void f(DataShareValuesBucket &value) { auto input = value.GetString(\"field\"); "
+                "FileUtils fileUtils; fileUtils.DeleteFile(input, true); }\n"
+            ),
+            "member_unknown_static.cpp": prefix + (
+                "void f(DataShareValuesBucket &value) { auto input = value.GetString(\"field\"); "
+                "DeleteFile(input); }\n"
+            ),
+        }
+        for name, text in cases.items():
+            run, _ = self.run_text(name, text)
+            self.assertEqual(run.status, "blocked", name)
+            self.assertEqual(run.findings, (), name)
+            self.assertTrue(any("unresolved external call" in item for item in run.limitations), name)
+
 if __name__ == "__main__":
     unittest.main()
