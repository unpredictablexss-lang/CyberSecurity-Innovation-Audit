+    if (!arksteed::HandleArkSteedDeoptNoGC(thread, returnPc, inputFp, snapshot, &context)) {
+        LOG_FULL(FATAL) << "ArkSteed eager deopt metadata or runtime ABI is corrupted";
+        UNREACHABLE();
+    }
+    return static_cast<uintptr_t>(context);
+}
