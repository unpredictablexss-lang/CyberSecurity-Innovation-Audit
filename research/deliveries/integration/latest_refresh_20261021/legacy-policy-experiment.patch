+        amount = (Decimal(cost["maximum_usd"]) * Decimal(max_candidates)
+                  + Decimal(r2_cost["maximum_usd"]) * Decimal(max_r2_candidates)
+                  if r2_cost is not None else Decimal(cost["maximum_usd"]) * Decimal(max_candidates))
+        aggregate_cost = {
