+                    "text": json.dumps(answer)}]}], "usage": {"input_tokens": 1000, "output_tokens": 120}}
+        return ledger, policy, evidence, authorization, answer, response
+
+    def test_quick_screen_is_single_call_no_tools_and_keeps_candidate_unconfirmed(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, _, response = self.quick_inputs(temp)
+            client = MockProvider(result=response)
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={"rule_id": "R1", "severity": "high"}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "completed")
+            self.assertEqual(result["quick_assessment"], "investigate")
+            self.assertEqual(result["finding_state"], "candidate")
+            self.assertEqual(result["validated_vulnerability"], 0)
+            self.assertEqual(len(client.calls), 1)
+            payload, timeout, retries = client.calls[0]
+            self.assertNotIn("tools", payload)
+            self.assertEqual(payload["max_output_tokens"], 512)
+            self.assertEqual(timeout, 60)
+            self.assertEqual(retries, 0)
+            self.assertEqual(ledger.summary("audit-parent")["input_tokens_actual"], 1000)
+
+    def test_quick_screen_without_explicit_authorization_never_sends(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, _, response = self.quick_inputs(temp)
+            auth["authorized"] = False
+            client = MockProvider(result=response)
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "quick_unknown")
+            self.assertEqual(client.calls, [])
+            self.assertEqual(ledger.summary("audit-parent")["calls_committed_or_reserved"], 0)
+
+    def test_quick_screen_rejects_mixed_source_before_provider_request(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, _, response = self.quick_inputs(temp)
+            evidence[0]["commit"] = "f" * 40
+            client = MockProvider(result=response)
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "quick_unknown")
+            self.assertEqual(client.calls, [])
+
+    def test_quick_screen_requires_same_task_level_consent_binding(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, _, response = self.quick_inputs(temp)
+            auth["report_sha256"] = "f" * 64
+            client = MockProvider(result=response)
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "quick_unknown")
+            self.assertEqual(client.calls, [])
+
+    def test_quick_screen_bad_citation_is_unknown_and_never_refutes_candidate(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, answer, _ = self.quick_inputs(temp)
+            answer["quick_assessment"] = "possible_refutation"
+            answer["evidence_citations"] = ["not-supplied"]
+            response = {"output": [{"type": "message", "content": [{"type": "output_text",
+                        "text": json.dumps(answer)}]}], "usage": {"input_tokens": 1000, "output_tokens": 90}}
+            client = MockProvider(result=response)
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "quick_unknown")
+            self.assertEqual(result["finding_state"], "candidate")
+            self.assertEqual(result["validated_vulnerability"], 0)
+
+    def test_quick_screen_provider_unknown_outcome_consumes_reservation(self):
+        with tempfile.TemporaryDirectory() as temp:
+            ledger, policy, evidence, auth, _, _ = self.quick_inputs(temp)
+            client = MockProvider(error=TimeoutError("unknown outcome"))
+            result = execute_quick_screen(ledger=ledger, task_id="audit-parent", group_id="g1",
+                authorization=auth, client=client, evidence=evidence,
+                candidate_summary={}, policy_snapshot=policy)
+            self.assertEqual(result["quick_status"], "quick_unknown")
+            summary = ledger.summary("audit-parent")
+            self.assertEqual(summary["status"], "stopped")
+            self.assertEqual(summary["input_tokens_reserved"], 12000)
+            self.assertEqual(summary["output_tokens_reserved"], 512)
+
+
+if __name__ == "__main__":
+    unittest.main()
