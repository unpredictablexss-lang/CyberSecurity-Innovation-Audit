+                except Exception as exc:
+                    self.store.event(
+                        task["spec"].get("job_id", ""), "triage_r2_enqueue_failed",
+                        "R1 result remains available; conditional R2 scheduling failed closed: "
+                        + type(exc).__name__ + ": " + str(exc)[:600],
