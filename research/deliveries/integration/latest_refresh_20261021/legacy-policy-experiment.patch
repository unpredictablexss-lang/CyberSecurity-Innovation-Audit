+import React, { useEffect, useState } from "react";
+import { Alert, Button, Card, Descriptions, Form, InputNumber, Select, Space, Tag, message } from "antd";
+import { api, apiPut } from "../../api";
+
+const labels: Record<string, string> = { economy: "经济模式", standard: "标准模式", deep: "深度模式", custom: "自定义" };
+const fields: Array<[string, string]> = [
+  ["quick_screen_limit", "快速研判组数（整个任务）"],
+  ["deep_investigation_limit", "深度调查组数（整个任务）"],
+  ["max_tool_steps_per_deep_group", "每组跨文件工具步数"],
+  ["max_model_concurrency", "模型请求并发"],
+  ["max_ai_duration_seconds", "AI 调查时间预算（秒）"],
+  ["max_input_tokens", "最大输入 Token"], ["max_output_tokens", "最大输出 Token"],
+  ["max_model_calls", "模型调用总数"],
+];
+
+export default function IntelligentAuditPolicySettings() {
+  const [saved, setSaved] = useState<any>(null);
+  const [profile, setProfile] = useState("standard");
+  const [limits, setLimits] = useState<any>({});
+  const [cost, setCost] = useState(25);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const refresh = async () => {
+    setError("");
+    try {
+      const current = await api("/agent/triage-policy");
+      setSaved(current); setProfile(current.policy.profile); setLimits(current.policy.limits || {});
+      setCost(Number(current.policy.limits?.max_cost_usd || 0));
+    } catch (e) { setError(String(e)); }
+  };
+  useEffect(() => { void refresh(); }, []);
+  const changeProfile = async (next: string) => {
+    setProfile(next);
+    if (next === "custom") return;
+    try {
+      const data = await api("/agent/triage-policy/preview", { audit_mode: "intelligent", policy: { profile: next }, candidate_count: 0 });
+      setLimits(data.policy.limits); setCost(Number(data.policy.limits.max_cost_usd || 0));
+    } catch (e) { setError(String(e)); }
+  };
+  const save = async () => {
+    setBusy(true); setError("");
+    try {
+      const policy = await apiPut("/agent/triage-policy", { profile, limits: profile === "custom" ? { ...limits, max_cost_usd: cost.toFixed(2) } : {}, family_quotas: profile === "standard" || profile === "deep" });
+      setSaved(policy); message.success("智能审计策略已保存到本机服务");
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  };
+  return <Card title="智能审计策略与资源预算" extra={<Button onClick={() => void refresh()} disabled={busy}>刷新</Button>}>
+    <Alert type="info" showIcon className="section-gap" message="新建渐进研判任务会冻结并使用此策略。"
+      description="静态审计始终不会发起模型请求。显示的 USD 是策略建议值，不是 Provider 账单硬上限；只有接入并核验 Provider 侧硬限后才能称为硬封顶。" />
+    {error && <Alert type="error" showIcon className="section-gap" message="策略设置失败" description={error} />}
+    <Space direction="vertical" size="middle" style={{ width: "100%" }}>
+      <Select aria-label="审计策略预设" value={profile} style={{ maxWidth: 320 }} onChange={(v) => void changeProfile(v)}
+        options={Object.entries(labels).map(([value, label]) => ({ value, label }))} />
+      <Descriptions bordered size="small" column={1}>
+        {fields.map(([key, label]) => <Descriptions.Item key={key} label={label}>
+          {profile === "custom" ? <InputNumber min={1} value={limits[key]} onChange={(v) => setLimits({ ...limits, [key]: v })} /> : (limits[key] ?? "—")}
+        </Descriptions.Item>)}
+        <Descriptions.Item label="任务费用策略（USD）">{profile === "custom" ? <InputNumber min={0} precision={2} value={cost} onChange={(v) => setCost(v || 0)} /> : (limits.max_cost_usd ?? "—")}</Descriptions.Item>
+        <Descriptions.Item label="家族覆盖配额">{profile === "standard" || profile === "deep" ? "开启" : "关闭"}</Descriptions.Item>
+      </Descriptions>
+      {saved && <Space wrap><Tag color="blue">{labels[saved.policy.profile] || saved.policy.profile}</Tag><Tag>版本 {saved.policy.policy_version}</Tag><Tag>修订 {saved.revision}</Tag><span>策略 SHA-256：{saved.policy_sha256}</span></Space>}
+      {saved && <Alert type="warning" showIcon message="仅新渐进研判任务读取该策略" description="已有任务继续使用其冻结授权。时间范围、跨分支和版本矩阵的父级总预算尚未接入这版策略。" />}
+      <Button type="primary" onClick={() => void save()} loading={busy}>保存策略</Button>
+    </Space>
+  </Card>;
+}
