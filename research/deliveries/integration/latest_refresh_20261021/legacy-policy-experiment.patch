+            os.chmod(temp, 0o700)
+            ledger = BudgetLedger(temp)
+            ledger.create_task("audit-parent", {"profile": "static"})
+            result = ledger.reserve("audit-parent", stage="quick_screen", group_id="g1",
+                idempotency_key="req1", input_tokens=1000, output_tokens=100)
+            self.assertFalse(result["reserved"])
+            self.assertEqual(result["stop_reason"], "static_mode_no_model_calls")
+
+    def quick_inputs(self, temp):
+        os.chmod(temp, 0o700)
+        policy = resolve_policy({"profile": "standard"})
+        excerpt = "if (length > capacity) return ERROR;"
+        evidence = [{"evidence_id": "e1", "repository": "openharmony/demo", "commit": "a" * 40,
+            "report_sha256": "b" * 64, "file": "src/a.cpp", "source_sha256": "d" * 64,
+            "excerpt": excerpt, "excerpt_sha256": hashlib.sha256(excerpt.encode()).hexdigest(),
+            "source_binding_verified": True, "redaction_applied": True,
+            "redaction_policy_version": "redaction-v1"}]
+        authorization = {"audit_mode": "intelligent", "authorized": True,
+            "consent_sha256": "e" * 64, "repository": "openharmony/demo", "commit": "a" * 40,
+            "report_sha256": "b" * 64, "provider_fingerprint": "c" * 64,
+            "model": "mock-small", "redaction_policy_version": "redaction-v1"}
+        ledger = BudgetLedger(temp)
+        ledger.create_task("audit-parent", policy, consent_binding={key: authorization[key] for key in
+            ("consent_sha256", "repository", "commit", "report_sha256", "provider_fingerprint", "model")})
+        answer = {"quick_assessment": "investigate", "rationale": "Length validation depends on caller input.",
+            "evidence_citations": ["e1"], "missing_obligations": ["caller_length_origin"],
+            "next_tool_hints": ["find_callers"], "uncertainties": ["runtime reachability unknown"]}
