+"""Settings API for local progressive-triage policy."""
+import hashlib
+import json
+from datetime import datetime, timezone
+from fastapi import APIRouter, FastAPI
+from pydantic import BaseModel, ConfigDict, Field
+
+from .contracts import PRESETS, policy_hash, resolve_policy
+from .grouping import build_groups
+from .ledger import BudgetLedger
+from .policy_store import PolicyStore
+from .ranking import rank_groups, select_groups
+from .. import service
+
+
+class StrictPolicyInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    profile: str = Field(default="standard", max_length=20)
+    limits: dict = Field(default_factory=dict)
+    family_quotas: bool | None = None
+
+
+class TriagePreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    audit_mode: str = Field(pattern="^(static_only|intelligent)$")
+    endpoint_count: int = Field(default=1, ge=1, le=8)
+    policy: StrictPolicyInput | None = None
+    candidate_count: int = Field(default=0, ge=0, le=10000)
+
+
+class QuickScreenPreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    group_ids: list[str] = Field(min_length=1, max_length=100)
+    consent_nonce: str = Field(pattern="^[a-f0-9]{32}$")
+
+
+class QuickScreenStartInput(QuickScreenPreviewInput):
+    expected_preview_sha256: str = Field(pattern="^[a-f0-9]{64}$")
+
+
+class DeepInvestigationPreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    group_id: str = Field(min_length=16, max_length=128)
+    consent_nonce: str = Field(pattern="^[a-f0-9]{32}$")
+
+
+class DeepInvestigationStartInput(DeepInvestigationPreviewInput):
+    expected_preview_sha256: str = Field(pattern="^[a-f0-9]{64}$")
+
+
+def install_routes(app: FastAPI, settings, scan_store=None):
+    router = APIRouter(prefix="/api/v1/agent/triage-policy")
+    store = PolicyStore(settings.data_dir)
+
+    def budget_task_id(audit_id):
+        """Share one progressive ledger across the endpoints of a parent audit operation."""
+        if scan_store is None or not hasattr(scan_store, "connect"):
+            return audit_id
+        # Operations.list() is intentionally paginated to recent records; using it
+        # here could silently fall back to a per-endpoint budget for older scans.
+        with scan_store.connect() as db:
+            rows = db.execute("SELECT id,spec FROM operations WHERE kind IN "
+                "('revision_range','branch_comparison','version_matrix') ORDER BY created_at DESC").fetchall()
+        for row in rows:
+            spec = json.loads(row["spec"])
+            if spec.get("audit_mode") != "static_only" and audit_id in spec.get("scan_ids", []):
+                return row["id"]
+        return audit_id
+
+    @router.get("")
+    def get_policy():
+        return {**store.get(), "presets": PRESETS,
+                "worker_enforcement": "progressive_quick_screen_and_read_only_agent",
+                "cost_hard_cap": False}
+
+    @router.put("")
+    def put_policy(body: StrictPolicyInput):
+        saved = store.put(body.model_dump(exclude_none=True))
+        return {**saved, "presets": PRESETS,
+                "worker_enforcement": "future_progressive_tasks_only",
+                "cost_hard_cap": False}
+
+    @router.post("/preview")
+    def preview_policy(body: TriagePreviewInput):
+        selected = (body.policy.model_dump(exclude_none=True) if body.policy
+                    else store.get()["policy"])
+        policy = resolve_policy({key: selected[key] for key in
+            ("profile", "limits", "family_quotas") if key in selected})
+        mode = body.audit_mode
+        limits = policy["limits"] if mode == "intelligent" else {}
+        return {"audit_mode": mode, "endpoint_count": body.endpoint_count,
+                "policy": policy, "policy_sha256": store.get()["policy_sha256"]
+                    if body.policy is None else policy_hash(policy),
+                "max_quick_screen_groups_for_entire_task":
+                    limits.get("quick_screen_limit", 0),
+                "max_deep_investigation_groups_for_entire_task":
+                    limits.get("deep_investigation_limit", 0),
+                "source_disclosure": mode == "intelligent" and policy["profile"] != "static",
+                "model_calls_allowed": mode == "intelligent" and policy["profile"] != "static",
+                "cost_enforcement": ("provider_cap_required_for_hard_cap"
+                                     if mode == "intelligent" else "no_model_calls"),
+                "worker_enforcement": "single_and_parent_multi_endpoint_progressive_flow",
+                "raw_candidates_retained": body.candidate_count}
+
+    @app.get("/api/v1/audits/{audit_id}/triage-groups")
+    def triage_groups(audit_id: str, offset: int = 0, limit: int = 100):
+        if scan_store is None:
+            raise ValueError("scan report store is unavailable")
+        if offset < 0 or not 1 <= limit <= 200:
+            raise ValueError("invalid triage group pagination")
+        job = scan_store.job(audit_id)
+        if job["status"] not in {"completed", "completed_with_limitations"} or not job.get("report_sha256"):
+            raise ValueError("triage groups require a completed fixed report")
+        report = service.read_report(settings, job)
+        inventory = {item.get("file"): item for item in
+                     report.get("_workbench", {}).get("source_inventory", [])
+                     if isinstance(item, dict) and isinstance(item.get("file"), str)}
+        findings = []
+        for item in service.findings(report):
+            file = item.get("file")
+            source = inventory.get(file, {})
+            source_sha = item.get("source_sha256")
+            findings.append({**item, "candidate_id": item.get("id"),
+                "repository": report.get("repository"), "commit": report.get("commit"),
+                "report_sha256": job["report_sha256"],
+                "source_binding_verified": bool(source_sha and source.get("sha256") == source_sha
+                    and report.get("repository") and report.get("commit")),
+                "coverage_unknown": item.get("coverage_status") in {"partial", "blocked", "not_analyzed"},
+                "has_entry_or_sink_evidence": bool(item.get("evidence_obligations")),
+                "changed_in_range": bool(item.get("change_status") in {"added", "changed"})})
+        manifest = build_groups(findings)
+        ranked = rank_groups(manifest["groups"])
+        current_policy = store.get()
+        static_only = job.get("spec", {}).get("audit_mode") == "static_only"
+        task_id = budget_task_id(audit_id)
+        ledger = BudgetLedger(settings.data_dir)
+        try:
+            budget = ledger.summary(task_id)
+            quick_results = ledger.quick_results(task_id)
+            # Once the user authorizes a task, its exact policy is immutable even
+            # if an administrator changes the system default while it is running.
+            policy = budget["policy_snapshot"]
+            policy_sha = budget["policy_sha256"]
+        except KeyError:
+            budget, quick_results = None, {}
+            policy, policy_sha = current_policy["policy"], current_policy["policy_sha256"]
+        attempted = ledger.reserved_group_ids(task_id, "quick_screen") if budget else set()
+        remaining_quick = max(0, policy["limits"].get("quick_screen_limit", 0) -
+                              (budget["quick_screen_groups_attempted"] if budget else 0))
+        selected = select_groups([row for row in ranked if row["group_id"] not in attempted],
+            remaining_quick if not static_only else 0, policy["family_quotas"])
+        prior_rows = [row for row in ranked if row["group_id"] in attempted]
+        for row in prior_rows:
+            row["selected"] = False
+            row["reason_codes"] = sorted(set(row.get("reason_codes", [])) | {"already_attempted"})
+        selected.extend(prior_rows)
+        selected.sort(key=lambda row: (row.get("rank", 0), row["group_id"]))
+        for row in selected:
+            recorded = quick_results.get(row["group_id"])
+            row["quick_screen_status"] = (recorded["result"].get("quick_status")
+                                           if recorded else "not_started")
+            row["quick_assessment"] = (recorded["result"].get("quick_assessment")
+                                       if recorded else None)
+            row["deep_investigation_status"] = "not_started"
+        if scan_store is not None:
+            from ..operations_store import Operations
+            for operation in Operations(scan_store).list():
+                spec = operation.get("spec", {})
+                if spec.get("progressive_task_id") != task_id and spec.get("ledger_task_id") != task_id:
+                    continue
+                row = next((item for item in selected if item["group_id"] ==
+                            spec.get("progressive_group_id")), None)
+                if row:
+                    row["deep_investigation_status"] = operation["status"]
+                elif operation.get("kind") == "progressive_quick_screen":
+                    row = next((item for item in selected if item["group_id"] ==
+                                spec.get("group_id")), None)
