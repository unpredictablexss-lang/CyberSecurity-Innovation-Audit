+})
+MAX_RESPONSE_BYTES = 2 * 1024 * 1024
+MAX_TOOL_RESULT_BYTES = 24 * 1024
+MAX_CONTEXT_FILE_BYTES = 1024 * 1024
+MAX_SYMBOL_GREP_BYTES = 128 * 1024
+MAX_SYMBOL_CONTEXT_FILES = 8
