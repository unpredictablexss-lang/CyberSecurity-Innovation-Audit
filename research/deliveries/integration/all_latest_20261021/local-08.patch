diff --git a/web/tests/agentEvidenceLocation.test.js b/web/tests/agentEvidenceLocation.test.js
new file mode 100644
index 00000000..0f0cce30
--- /dev/null
+++ b/web/tests/agentEvidenceLocation.test.js
@@ -0,0 +1,76 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { evidenceLocation, evidenceSourceLocation } from "../src/features/audits/agentEvidenceLocation.js";
+
+test("initial candidate citations point to the bound source excerpt range", () => {
+  const result = { binding: { file: "src/candidate.cpp" }, initial_evidence: {
+    evidence_id: "initial-1", source_excerpt_start_line: 10, source_excerpt_end_line: 20,
+  } };
+  assert.equal(evidenceLocation(result, "initial-1"), "src/candidate.cpp:10-20 · 初始候选");
+});
+
+test("symbol-search citations resolve to exact matching lines and file", () => {
+  const result = { tool_calls: [{ evidence_id: "tool-1", result: { matches: [
+    { file: "src/a.cpp", line: 40, context_start_line: 38, text: "38: before\n42: const int UID = 3020;\n43: after" },
+    { file: "src/b.cpp", line: 8, context_start_line: 6, text: "6: unrelated\n8: const int UID = 3020;" },
+  ] } }] };
+  assert.equal(evidenceLocation(result, "tool-1", "const int UID = 3020;"),
+    "src/a.cpp:42-42；src/b.cpp:8-8 · 固定提交");
+});
+
+test("missing exact quote falls back to the bounded source context", () => {
+  const result = { tool_calls: [{ evidence_id: "tool-2", result: { matches: [
+    { file: "src/a.cpp", line: 12, context_start_line: 10, text: "10: a\n11: b\n12: c\n13: d\n14: e" },
+  ] } }] };
+  assert.equal(evidenceLocation(result, "tool-2", "not present"), "src/a.cpp:10-14 · 固定提交");
+});
+
+test("unavailable evidence is explicit and does not invent a source location", () => {
+  assert.equal(evidenceLocation({ tool_calls: [] }, "missing"), "证据记录不可用");
+});
+
+test("source locations identify the exact cited line for deep links", () => {
+  const result = { binding: { job_id: "job-1", file: "src/candidate.cpp" }, initial_evidence: {
+    evidence_id: "initial-1", source_excerpt_start_line: 10, context: { source_excerpt: "before\nreturn false;" },
+  }, tool_calls: [{ evidence_id: "tool-1", result: { matches: [
+    { file: "src/helper.cpp", line: 40, context_start_line: 38, text: "38: before\n42: verify_access();" },
+  ] } }] };
+  assert.deepEqual(evidenceSourceLocation(result, "initial-1", "return false;"), { file: "src/candidate.cpp", line: 11 });
+  assert.deepEqual(evidenceSourceLocation(result, "tool-1", "verify_access();"), { file: "src/helper.cpp", line: 42 });
+  assert.equal(evidenceSourceLocation(result, "missing"), null);
+});
+
+test("multiline initial-source citations open at the exact first line and show the full range", () => {
+  const result = { binding: { job_id: "job-1", file: "src/candidate.cpp" }, initial_evidence: {
+    evidence_id: "initial-multiline", source_excerpt_start_line: 50, source_excerpt_end_line: 54,
+    source_excerpt: "before();\nif (!authorized) {\n  return false;\n}\nafter();",
+  } };
+  const quote = "if (!authorized) {\n  return false;\n}";
+  assert.deepEqual(evidenceSourceLocation(result, "initial-multiline", quote),
+    { file: "src/candidate.cpp", line: 51 });
+  assert.equal(evidenceLocation(result, "initial-multiline", quote),
+    "src/candidate.cpp:51-53 · 初始候选");
+});
+
+test("multiline fixed-source citations strip displayed line numbers and resolve exact bounds", () => {
+  const result = { binding: { job_id: "job-1" }, tool_calls: [{
+    evidence_id: "range-1", result: { file: "src/helper.cpp", start_line: 100, end_line: 103,
+      text: "100: if (!authorized) {\n101:   return false;\n102: }\n103: after();" },
+  }] };
+  const quote = "100: if (!authorized) {\n101:   return false;\n102: }";
+  assert.deepEqual(evidenceSourceLocation(result, "range-1", quote),
+    { file: "src/helper.cpp", line: 100 });
+  assert.equal(evidenceLocation(result, "range-1", quote),
+    "src/helper.cpp:100-102 · 固定提交");
+});
+
+test("explicit line-range citations stay bound to one file when symbol search found several files", () => {
+  const result = { tool_calls: [{ evidence_id: "lookup-1", result: { matches: [
+    { file: "src/a.cpp", line: 40, context_start_line: 38, text: "38: before\n40: check();" },
+    { file: "src/b.cpp", line: 8, context_start_line: 6, text: "6: before\n8: check();" },
+  ] } }] };
+  const citation = { file: "src/b.cpp", line_start: 8, line_end: 8 };
+  assert.equal(evidenceLocation(result, "lookup-1", "check();", citation), "src/b.cpp:8-8");
+  assert.deepEqual(evidenceSourceLocation(result, "lookup-1", "check();", citation),
+    { file: "src/b.cpp", line: 8 });
+});
diff --git a/web/tests/agentToolIssues.test.js b/web/tests/agentToolIssues.test.js
new file mode 100644
index 00000000..fbae5e11
--- /dev/null
+++ b/web/tests/agentToolIssues.test.js
@@ -0,0 +1,36 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { agentToolIssues } from "../src/features/audits/agentToolIssues.js";
+
+test("tool range rejection is visible with the real limit and safe retry guidance", () => {
+  const issues = agentToolIssues([{ tool: "read_fixed_source_range", status: "rejected",
+    result: { error_code: "source_range_too_large", message: "provider-controlled text" } }]);
+  assert.equal(issues.length, 1);
+  assert.equal(issues[0].tool, "read_fixed_source_range");
+  assert.match(issues[0].message, /最多读取 40 行/);
+  assert.doesNotMatch(issues[0].message, /provider-controlled/);
+});
+
+test("legacy generic rejection can be explained from its recorded oversized line count", () => {
+  const issues = agentToolIssues([{ tool: "read_fixed_source_range", status: "rejected",
+    arguments: { file: "src/fixed.cpp", start_line: 180, line_count: 70 },
+    result: { error_code: "query_rejected" } }]);
+  assert.equal(issues[0].errorCode, "source_range_too_large");
+  assert.match(issues[0].message, /最多读取 40 行/);
+});
+
+test("unavailable tool evidence is surfaced while completed calls are omitted", () => {
+  const issues = agentToolIssues([
+    { tool: "lookup_symbol_in_fixed_commit", status: "completed", result: {} },
+    { tool: "read_candidate_source", status: "unavailable", result: { error_code: "fixed_evidence_unavailable" } },
+  ]);
+  assert.equal(issues.length, 1);
+  assert.equal(issues[0].status, "unavailable");
+  assert.match(issues[0].message, /保持未决/);
+});
+
+test("missing or malformed trace remains safe", () => {
+  assert.deepEqual(agentToolIssues(null), []);
+  assert.equal(agentToolIssues([{ status: "rejected", result: {} }])[0].message,
+    "工具未能提供证据；相关义务应保持未决。");
+});
diff --git a/web/tests/agentValidationMessage.test.js b/web/tests/agentValidationMessage.test.js
new file mode 100644
index 00000000..928058b6
--- /dev/null
+++ b/web/tests/agentValidationMessage.test.js
@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { structuredAnswerRejection } from "../src/features/audits/agentValidationMessage.js";
+
+test("policy gate rejection explains why the answer was discarded", () => {
+  const message = structuredAnswerRejection("rejected_after_one_repair", "unresolved_authorization_policy_claim");
+  assert.match(message, /关闭仍需人工复核的调用方授权策略义务/);
+  assert.match(message, /服务端已拒绝并丢弃答复/);
+  assert.match(message, /所有义务仍保持未决/);
+  assert.match(message, /unresolved_authorization_policy_claim/);
+});
+
+test("unknown rejection codes get a safe fallback without implying a vulnerability verdict", () => {
+  const message = structuredAnswerRejection("rejected_after_one_repair", "future_unknown_code");
+  assert.match(message, /未通过服务端的结构、引用或策略校验/);
+  assert.match(message, /当前“未知”结果不构成漏洞判断/);
+  assert.match(message, /future_unknown_code/);
+});
+
+test("provider output truncation is explicit and retry requires a fresh preview and consent", () => {
+  const message = structuredAnswerRejection("provider_incomplete", "max_output_tokens");
+  assert.match(message, /达到本次输出 token 上限/);
+  assert.match(message, /已丢弃不完整答复/);
+  assert.match(message, /所有证据义务仍保持未决/);
+  assert.match(message, /重新预览并单独授权/);
+  assert.match(message, /不代表候选误报或安全/);
+});
+
+test("other incomplete provider responses stay fail-closed and explain retry boundary", () => {
+  const message = structuredAnswerRejection("provider_incomplete", "provider_incomplete");
+  assert.match(message, /响应未完整结束/);
+  assert.match(message, /已丢弃不完整答复/);
+  assert.match(message, /重新预览并单独授权/);
+});
+
+test("accepted and legacy statuses do not show a rejection alert", () => {
+  assert.equal(structuredAnswerRejection("accepted", "invalid_json"), null);
+  assert.equal(structuredAnswerRejection(undefined, undefined), null);
+});
