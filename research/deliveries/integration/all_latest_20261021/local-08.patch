+                                binding.get("source_sha256")))
+            items.append({
+                "blind_item_id": item["blind_item_id"],
+                "order": item["order"],
+                "packet_sha256": item["packet_sha256"],
+                "packet": item["packet"],
+                "review": item["review"],
+                "review_sha256": item["review_sha256"],
+                "operation_id": operation_id,
