+    def close_agent_blind_session(self, session_id):
+        with self.store.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            session = db.execute("SELECT * FROM agent_blind_sessions WHERE id=?", (session_id,)).fetchone()
+            if session is None:
