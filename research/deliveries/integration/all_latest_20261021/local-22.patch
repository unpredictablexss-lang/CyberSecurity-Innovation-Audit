+++ b/src/workbench/progressive_triage/policy.py
@@ -0,0 +1,313 @@
+"""Versioned policy presets and protected local persistence.
+
+The values here are policy defaults. They are not enforcement until an audit task
+freezes and the Worker consumes the policy snapshot in a later integration phase.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from decimal import Decimal, InvalidOperation
+import fcntl
+import json
+import os
+from pathlib import Path
+import re
+import uuid
+from typing import Any
+
+from .contracts import POLICY_VERSION, content_sha256
+
+
+class PolicyError(ValueError):
+    """The requested policy is malformed or exceeds local service limits."""
+
+
+class PolicyRevisionConflict(PolicyError):
+    """The settings page attempted to overwrite a newer revision."""
+
+
+class PolicyStoreError(PolicyError):
+    """The protected policy sidecar cannot be read or safely replaced."""
+
+
+_LIMIT_BOUNDS = {
+    "quick_screen_groups_per_audit": (1, 10_000),
+    "deep_groups_per_audit": (0, 1_000),
+    "max_tool_steps_per_group": (1, 32),
+    "max_model_concurrency": (1, 8),
+    "max_model_calls_per_audit": (1, 10_000),
+    "max_input_tokens_per_audit": (1_024, 2_000_000),
+    "max_output_tokens_per_audit": (256, 500_000),
+    "max_ai_wall_seconds": (60, 14_400),
+}
+_LIMIT_KEYS = frozenset((*_LIMIT_BOUNDS, "max_cost_usd"))
+_COST_RE = re.compile(r"^(?:0|[1-9]\d{0,5})(?:\.\d{1,8})?$")
+_STORAGE_SCHEMA = 1
+_MAX_STORE_BYTES = 4 * 1024 * 1024
+_MAX_HISTORY = 10_000
+
+
+def _limits(*, quick, deep, steps, concurrency, calls, input_tokens,
+            output_tokens, seconds, cost):
+    return {
+        "quick_screen_groups_per_audit": quick,
+        "deep_groups_per_audit": deep,
+        "max_tool_steps_per_group": steps,
+        "max_model_concurrency": concurrency,
+        "max_model_calls_per_audit": calls,
+        "max_input_tokens_per_audit": input_tokens,
+        "max_output_tokens_per_audit": output_tokens,
+        "max_ai_wall_seconds": seconds,
+        "max_cost_usd": cost,
+    }
+
+
+# The taskbook marks these as initial product defaults, not measured optima.
+PRESETS = {
+    "economical": {
+        "limits": _limits(
+            quick=10, deep=2, steps=6, concurrency=1, calls=40,
+            input_tokens=100_000, output_tokens=20_000, seconds=900, cost="5.00",
+        ),
+        "family_quotas": True,
+    },
+    "standard": {
+        "limits": _limits(
+            quick=30, deep=6, steps=8, concurrency=2, calls=120,
+            input_tokens=400_000, output_tokens=100_000, seconds=1_800, cost="25.00",
+        ),
+        "family_quotas": True,
+    },
+    "deep": {
+        "limits": _limits(
+            quick=100, deep=20, steps=12, concurrency=3, calls=500,
+            input_tokens=2_000_000, output_tokens=500_000, seconds=5_400, cost="100.00",
+        ),
+        "family_quotas": True,
+    },
+}
+PROFILES = frozenset((*PRESETS, "custom"))
+
+
+def _strict_int(value: Any, name: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise PolicyError(f"{name} must be an integer")
+    low, high = _LIMIT_BOUNDS[name]
+    if not low <= value <= high:
+        raise PolicyError(f"{name} must be between {low} and {high}")
+    return value
+
+
+def _validate_limits(value: Any) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise PolicyError("limits must be an object")
+    if set(value) != _LIMIT_KEYS:
+        missing = sorted(_LIMIT_KEYS - set(value))
+        extra = sorted(set(value) - _LIMIT_KEYS)
+        raise PolicyError(f"invalid limit fields (missing={missing}, extra={extra})")
+    result = {key: _strict_int(value[key], key) for key in _LIMIT_BOUNDS}
+    cost = value["max_cost_usd"]
+    if not isinstance(cost, str) or not _COST_RE.fullmatch(cost):
+        raise PolicyError("max_cost_usd must be a non-negative decimal string")
+    try:
+        decimal_cost = Decimal(cost)
+    except InvalidOperation as error:
+        raise PolicyError("max_cost_usd is not a valid decimal") from error
+    if not decimal_cost.is_finite() or decimal_cost <= 0 or decimal_cost > Decimal("1000"):
+        raise PolicyError("max_cost_usd must be greater than 0 and no more than 1000")
+    if result["deep_groups_per_audit"] > result["quick_screen_groups_per_audit"]:
+        raise PolicyError("deep group limit cannot exceed quick-screen group limit")
+    if result["max_model_calls_per_audit"] < (
+        result["quick_screen_groups_per_audit"] + result["deep_groups_per_audit"]
+    ):
+        raise PolicyError("model-call limit must cover at least one call for each selected group")
+    result["max_cost_usd"] = cost
+    return result
+
+
+def build_policy(profile: str = "standard", limits: dict[str, Any] | None = None,
+                 family_quotas: bool | None = None) -> dict[str, Any]:
+    """Create a strict, JSON-safe policy snapshot from a preset or custom values."""
+    if profile not in PROFILES:
+        raise PolicyError("profile must be economical, standard, deep, or custom")
+    if profile == "custom":
+        resolved_limits = _validate_limits(limits if limits is not None else PRESETS["standard"]["limits"])
+        resolved_family_quotas = family_quotas if family_quotas is not None else True
+    else:
+        preset = PRESETS[profile]
+        expected_limits = preset["limits"]
+        if limits is not None and _validate_limits(limits) != expected_limits:
+            raise PolicyError("preset limits are fixed; choose custom to edit them")
+        if family_quotas is not None and family_quotas is not preset["family_quotas"]:
+            raise PolicyError("preset family quota settings are fixed; choose custom to edit them")
+        resolved_limits = dict(expected_limits)
+        resolved_family_quotas = preset["family_quotas"]
+    if not isinstance(resolved_family_quotas, bool):
+        raise PolicyError("family_quotas must be a boolean")
+    return {
+        "policy_version": POLICY_VERSION,
+        "profile": profile,
+        "limits": resolved_limits,
+        "family_quotas": resolved_family_quotas,
+        "preserve_all_candidates": True,
+        "consent_required": True,
+    }
+
+
+def validate_policy(value: Any) -> dict[str, Any]:
+    """Validate a stored policy, rejecting unknown fields and unsafe coercions."""
+    expected = {
+        "policy_version", "profile", "limits", "family_quotas",
+        "preserve_all_candidates", "consent_required",
+    }
+    if not isinstance(value, dict) or set(value) != expected:
+        raise PolicyError("policy fields do not match the supported schema")
+    if value["policy_version"] != POLICY_VERSION:
+        raise PolicyError("unsupported policy version")
+    if value["preserve_all_candidates"] is not True:
+        raise PolicyError("preserving every original candidate is mandatory")
+    if value["consent_required"] is not True:
+        raise PolicyError("task-level consent is mandatory")
+    return build_policy(value["profile"], value["limits"], value["family_quotas"])
+
+
+def policy_envelope(policy: dict[str, Any]) -> dict[str, Any]:
+    normalized = validate_policy(policy)
+    return {
+        "policy": normalized,
+        "policy_sha256": content_sha256(normalized),
+    }
+
+
+class PolicyStore:
+    """Process-safe JSON settings store with atomic replacement and revisions."""
+
+    def __init__(self, data_dir: str | Path):
+        self.data_dir = Path(data_dir)
+        self.path = self.data_dir / "progressive-triage-policy.json"
+        self.lock_path = self.data_dir / ".progressive-triage-policy.lock"
+
+    def _read_unlocked(self) -> dict[str, Any]:
+        if self.path.is_symlink():
+            raise PolicyStoreError("policy file cannot be a symlink")
+        if not self.path.exists():
+            envelope = policy_envelope(build_policy())
+            return {
+                "storage_schema": _STORAGE_SCHEMA,
+                "revision": 0,
+                "updated_at": None,
+                "updated_by": None,
+                **envelope,
+                "history": [],
+            }
+        try:
+            if self.path.stat().st_size > _MAX_STORE_BYTES:
+                raise PolicyStoreError("policy file exceeds the local size limit")
+            stored = json.loads(self.path.read_text(encoding="utf-8"))
+        except PolicyStoreError:
+            raise
+        except (OSError, UnicodeError, json.JSONDecodeError) as error:
+            raise PolicyStoreError("policy file is unreadable or invalid") from error
+        if not isinstance(stored, dict) or stored.get("storage_schema") != _STORAGE_SCHEMA:
+            raise PolicyStoreError("unsupported policy storage schema")
+        try:
+            policy = validate_policy(stored.get("policy"))
+        except PolicyError as error:
+            raise PolicyStoreError("stored policy failed schema validation") from error
+        expected_keys = {
+            "storage_schema", "revision", "updated_at", "updated_by",
+            "policy", "policy_sha256", "history",
+        }
+        if set(stored) != expected_keys:
+            raise PolicyStoreError("policy store contains unknown or missing fields")
+        revision = stored["revision"]
+        history = stored["history"]
+        if (not isinstance(revision, int) or isinstance(revision, bool) or revision < 0
+                or not isinstance(history, list) or len(history) > _MAX_HISTORY):
+            raise PolicyStoreError("policy revision history is malformed")
+        envelope = policy_envelope(policy)
+        if stored["policy_sha256"] != envelope["policy_sha256"]:
+            raise PolicyStoreError("policy hash does not match its stored contents")
+        return {
+            "storage_schema": _STORAGE_SCHEMA,
+            "revision": revision,
+            "updated_at": stored["updated_at"],
+            "updated_by": stored["updated_by"],
+            **envelope,
+            "history": history,
+        }
+
+    def read(self) -> dict[str, Any]:
+        self.data_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
+        lock_fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
+        try:
+            fcntl.flock(lock_fd, fcntl.LOCK_SH)
+            return self._read_unlocked()
+        except OSError as error:
+            raise PolicyStoreError("policy store cannot be locked safely") from error
+        finally:
+            os.close(lock_fd)
+
+    def update(self, policy: dict[str, Any], expected_revision: int,
+               actor: str = "local-workbench") -> dict[str, Any]:
+        normalized = validate_policy(policy)
+        if not isinstance(expected_revision, int) or isinstance(expected_revision, bool) or expected_revision < 0:
+            raise PolicyError("expected_revision must be a non-negative integer")
+        self.data_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
+        lock_fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
+        try:
+            fcntl.flock(lock_fd, fcntl.LOCK_EX)
+            current = self._read_unlocked()
+            if current["revision"] != expected_revision:
+                raise PolicyRevisionConflict("policy changed; reload before saving")
+            if current["policy"] == normalized:
+                return current
+            if current["revision"] >= _MAX_HISTORY:
+                raise PolicyStoreError("policy history limit reached; archive the local settings first")
+            updated_at = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+            envelope = policy_envelope(normalized)
+            event = {
+                "revision": current["revision"] + 1,
+                "updated_at": updated_at,
+                "updated_by": actor,
+                "policy_sha256": envelope["policy_sha256"],
+                "profile": normalized["profile"],
+            }
+            stored = {
+                "storage_schema": _STORAGE_SCHEMA,
+                "revision": event["revision"],
+                "updated_at": updated_at,
+                "updated_by": actor,
+                **envelope,
+                "history": [*current["history"], event],
+            }
+            payload = json.dumps(stored, ensure_ascii=False, sort_keys=True, indent=2).encode("utf-8") + b"\n"
+            if len(payload) > _MAX_STORE_BYTES:
+                raise PolicyStoreError("policy history would exceed the local size limit")
+            temporary = self.data_dir / (".progressive-triage-policy." + uuid.uuid4().hex + ".tmp")
+            fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+            try:
+                with os.fdopen(fd, "wb") as target:
+                    target.write(payload)
+                    target.flush()
+                    os.fsync(target.fileno())
+                os.replace(temporary, self.path)
+                dir_fd = os.open(self.data_dir, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+                try:
+                    os.fsync(dir_fd)
+                finally:
+                    os.close(dir_fd)
+            except Exception:
+                try:
+                    temporary.unlink()
+                except OSError:
+                    pass
+                raise
+            return stored
+        except PolicyError:
+            raise
+        except OSError as error:
+            raise PolicyStoreError("policy settings could not be replaced atomically") from error
+        finally:
+            os.close(lock_fd)
diff --git a/src/workbench/progressive_triage/ranking.py b/src/workbench/progressive_triage/ranking.py
new file mode 100644
index 00000000..5a14f815
--- /dev/null
+++ b/src/workbench/progressive_triage/ranking.py
@@ -0,0 +1,214 @@
+"""Deterministic local-evidence ranking with a family-diversity first pass."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+import re
+from typing import Any, Iterable
+
+from .contracts import RANKING_VERSION, GIT_COMMIT_RE, SHA256_RE
+
+
+_SEVERITY_POINTS = {"critical": 12, "severe": 12, "high": 9, "medium": 5, "low": 2}
+
+
+def _family_bucket(group: dict[str, Any]) -> str:
+    explicit = group.get("family_bucket")
+    if isinstance(explicit, str) and explicit.strip() and len(explicit) <= 80:
+        return explicit.strip()
+    members = group.get("members") or group.get("candidates") or []
+    detector = " ".join(
+        str(item.get("detector_id") or item.get("tool") or "")
+        for item in members if isinstance(item, dict)
+    ).lower()
+    if any(token in detector for token in ("ipc", "permission", "auth")):
+        return "ipc_authorization"
+    if any(token in detector for token in ("cpp", "cxx", "memory", "bounds", "use-after")):
+        return "cpp_memory_safety"
+    if any(token in detector for token in ("arkts", "javascript", "typescript", "js.")):
+        return "script_api"
+    if any(token in detector for token in ("sensitive", "privacy", "logging", "data-leak")):
+        return "sensitive_data"
+    if any(token in detector for token in ("known-cve", "disclosed", "cve")):
+        return "disclosed_vulnerability"
+    if detector:
+        token = re.sub(r"[^a-z0-9_.-]+", "_", detector.split()[0])[:60]
+        return "detector:" + token
+    return "unknown_family"
+
+
+def _members(group: dict[str, Any]) -> list[dict[str, Any]]:
+    values = group.get("members")
+    if values is None:
+        values = group.get("candidates")
+    return [item for item in values or [] if isinstance(item, dict)]
+
+
+def _member_is_bound(member: dict[str, Any], scope: dict[str, Any]) -> bool:
+    repository = member.get("repository") or member.get("repository_id") or scope.get("repository")
+    commit = member.get("commit") or scope.get("commit")
+    snapshot = (member.get("snapshot_sha256") or member.get("report_sha256")
+                or scope.get("snapshot_sha256") or scope.get("report_sha256"))
+    source_hash = member.get("source_sha256")
+    file = member.get("file")
+    return bool(
+        isinstance(repository, str) and repository
+        and isinstance(commit, str) and GIT_COMMIT_RE.fullmatch(commit)
+        and isinstance(snapshot, str) and SHA256_RE.fullmatch(snapshot)
+        and isinstance(source_hash, str) and SHA256_RE.fullmatch(source_hash)
+        and isinstance(file, str) and file and not file.startswith(("/", "\\"))
+        and ".." not in file.replace("\\", "/").split("/")
+    )
+
+
+def _member_unknown(member: dict[str, Any]) -> bool:
+    status = str(member.get("parse_status") or member.get("coverage_status") or "").lower()
+    return status in {"partial", "blocked", "not_analyzed", "failed", "unknown"}
+
+
+def _facts(member: dict[str, Any]) -> set[str]:
+    evidence = member.get("evidence")
+    if not isinstance(evidence, dict):
+        evidence = {}
+    signals = member.get("evidence_signals")
+    found = set()
+    if isinstance(signals, dict):
+        found.update(key for key, enabled in signals.items() if enabled is True and key in {
+            "entry", "source", "guard", "sink", "effect", "dataflow", "authorization_boundary",
+        })
+    for key in ("entry", "source", "guard", "sink", "effect", "dataflow", "authorization_boundary"):
+        if evidence.get(key):
+            found.add(key)
+    return found
+
+
+def _obligations(member: dict[str, Any]) -> set[str]:
+    values = member.get("evidence_obligations")
+    if values is None and isinstance(member.get("evidence"), dict):
+        values = member["evidence"].get("obligations")
+    if not isinstance(values, list):
+        return set()
+    result = set()
+    for value in values:
+        if isinstance(value, str) and value.strip():
+            result.add(value.strip())
+        elif isinstance(value, dict):
+            identifier = value.get("id") or value.get("obligation") or value.get("name")
+            status = str(value.get("status") or "unresolved").lower()
+            if isinstance(identifier, str) and status not in {"complete", "resolved", "satisfied"}:
+                result.add(identifier)
+    return result
+
+
+def _score(group: dict[str, Any]) -> tuple[int, dict[str, int], list[str], bool, str]:
+    members = _members(group)
+    scope = group.get("source_scope") if isinstance(group.get("source_scope"), dict) else {}
+    bound = bool(members) and all(_member_is_bound(item, scope) for item in members)
+    unknown = bool(group.get("coverage_unknown")) or any(_member_unknown(item) for item in members)
+    facts = set().union(*(_facts(item) for item in members)) if members else set()
+    obligations = set().union(*(_obligations(item) for item in members)) if members else set()
+    severities = []
+    for item in members:
+        assessment = item.get("risk_assessment")
+        if not isinstance(assessment, dict):
+            assessment = {}
+        severities.append(str(item.get("severity") or assessment.get("severity") or "").lower())
+    risk_points = max((_SEVERITY_POINTS.get(value, 0) for value in severities), default=0)
+    changes = any(str(item.get("change_status") or item.get("diff_status") or "").lower()
+                  in {"new", "added", "changed", "modified"} for item in members)
+    components = {
+        "source_binding": 30 if bound and not unknown else 0,
+        "local_security_facts": min(5, len(facts)) * 6,
+        "unresolved_evidence_obligations": min(5, len(obligations)) * 4,
+        "potential_impact": risk_points,
+        "version_change": 8 if changes else 0,
+        "root_cause_signal": 3 if group.get("group_kind") == "root_cause_candidate" else 0,
+    }
+    reasons = []
+    if not bound:
+        reasons.append("source_binding_incomplete")
+    if unknown:
+        reasons.append("coverage_unknown")
+    if obligations:
+        reasons.append("unresolved_evidence_obligations")
+    if facts:
+        reasons.append("source_bound_security_facts")
+    if changes:
+        reasons.append("version_change_observed")
+    family = _family_bucket(group)
+    return sum(components.values()), components, reasons, (not bound or unknown), family
+
+
+def rank_groups(groups: Iterable[dict[str, Any]], limit: int, *,
+                family_quotas: bool = True) -> dict[str, Any]:
+    """Rank groups for optional model spend; never remove or clear any candidate.
+
+    This is a local selection decision only. Non-selected/unknown findings remain
+    available and are not marked safe, false positive, or validated.
+    """
+    if not isinstance(limit, int) or isinstance(limit, bool) or not 0 <= limit <= 10_000:
+        raise ValueError("limit must be an integer between 0 and 10000")
+    if not isinstance(family_quotas, bool):
+        raise ValueError("family_quotas must be boolean")
+    groups = list(groups)
+    prepared = []
+    seen_ids = set()
+    for group in groups:
+        if not isinstance(group, dict):
+            raise ValueError("every group must be an object")
+        group_id = group.get("group_id")
+        if not isinstance(group_id, str) or not group_id or group_id in seen_ids:
+            raise ValueError("group_id must be unique and non-empty")
+        seen_ids.add(group_id)
+        score, components, reasons, blocked, family = _score(group)
+        prepared.append({
+            "group_id": group_id,
+            "score": score,
+            "components": components,
+            "evidence_gaps": sorted(set().union(*(_obligations(item) for item in _members(group)))),
+            "family_bucket": family,
+            "coverage_unknown": blocked,
+            "reason_codes": reasons,
+            "selected": False,
+        })
+    ordered = sorted(prepared, key=lambda item: (-item["score"], item["group_id"]))
+    eligible = [item for item in ordered if not item["coverage_unknown"]]
+    selected_ids = set()
+    family_selected = set()
+    if family_quotas and limit:
+        family_best = {}
+        for item in eligible:
+            family_best.setdefault(item["family_bucket"], item)
+        for family, item in sorted(
+            family_best.items(), key=lambda pair: (-pair[1]["score"], pair[0], pair[1]["group_id"])
+        ):
+            if len(selected_ids) >= limit:
+                break
+            selected_ids.add(item["group_id"])
+            family_selected.add(family)
+            item["reason_codes"].append("family_quota_coverage")
+    for item in eligible:
+        if len(selected_ids) >= limit:
+            break
+        if item["group_id"] not in selected_ids:
+            selected_ids.add(item["group_id"])
+            item["reason_codes"].append("within_model_selection_budget")
+    rank_by_id = {item["group_id"]: index + 1 for index, item in enumerate(ordered)}
+    for item in prepared:
+        item["rank"] = rank_by_id[item["group_id"]]
+        item["selected"] = item["group_id"] in selected_ids
+        if item["coverage_unknown"]:
+            item["reason_codes"].append("retained_for_manual_review_not_auto_selected")
+        elif not item["selected"]:
+            item["reason_codes"].append("model_selection_budget_exhausted")
+        item["reason_codes"] = sorted(set(item["reason_codes"]))
+    decisions = sorted(prepared, key=lambda item: (item["rank"], item["group_id"]))
+    return {
+        "ranking_version": RANKING_VERSION,
+        "selection_limit": limit,
+        "family_quotas": family_quotas,
+        "group_count": len(decisions),
+        "selected_group_count": len(selected_ids),
+        "retained_candidate_count": sum(len(_members(group)) for group in groups),
+        "decisions": decisions,
+    }
