+        if (source.get("commit") != expected_commit or source.get("sha256") != candidate_sha256
+                or observed_sha256 != candidate_sha256):
+            return {"state": "unknown", "reason": "候选源码与扫描提交/源码哈希不匹配。"}
+        lines = source_text.splitlines()
