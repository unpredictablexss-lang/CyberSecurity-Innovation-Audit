+      card.append(node("h3", "候选源码")); card.append(node("pre", candidate.source_excerpt || ""));
+      card.append(node("h3", "证据义务")); card.append(node("p", (candidate.evidence_obligations || []).join("；") || "无记录"));
+      card.append(node("h3", "Agent 分诊材料"));
+      card.append(node("p", `${assessment.assessment || "unknown"} · ${assessment.summary || ""}`));
+      for (const claim of assessment.supported_claims || []) {
+        const block = node("div", undefined, "card"); block.append(node("p", claim.claim || ""));
+        for (const citation of claim.citations || []) block.append(node("p", `${citation.evidence_id}: “${citation.quote}”`, "muted"));
+        card.append(block);
+      }
+      for (const [label, values] of [["无证据支持的陈述", assessment.unsupported_claims], ["未知项", assessment.unknowns], ["建议下一步", assessment.next_steps]]) {
+        card.append(node("h3", label)); card.append(node("p", (values || []).join("；") || "无"));
+      }
+      card.append(node("h3", "匿名证据包")); card.append(node("pre", JSON.stringify(packet.evidence || [], null, 2)));
+      const form = node("form", undefined, "card");
+      form.append(node("h3", "你的评价"));
+      const grid = node("div", undefined, "grid");
+      textField(grid, "reviewer", "复核人", false, 100).required = true;
+      selectField(grid, "usefulness", "分诊实用性", choices.usefulness, "partially_useful");
+      selectField(grid, "citation_accuracy", "引文准确性", choices.citation_accuracy, "not_checked");
+      selectField(grid, "post_review_disposition", "人工分诊（不是漏洞真值）", choices.post_review_disposition, "");
+      textField(grid, "elapsed_seconds", "复核耗时秒（可留空）", false, 6).type = "number";
+      form.append(grid);
+      textField(form, "claims_to_correct", "需更正陈述", true, 1200);
+      textField(form, "missed_evidence", "遗漏证据", true, 1200);
+      const notes = textField(form, "notes", "备注；若猜到实验组别请在此说明", true, 1000);
+      form.addEventListener("submit", (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        const record = Object.fromEntries(data.entries());
+        record.elapsed_seconds = record.elapsed_seconds === "" ? null : Number(record.elapsed_seconds);
+        record.post_review_disposition = record.post_review_disposition || null;
+        record.reviewer = String(record.reviewer).trim();
+        if (!record.reviewer) return;
+        if (record.elapsed_seconds === null) record.elapsed_seconds = Math.round((Date.now() - startedAt) / 1000);
+        reviews.set(item.blind_item_id, { blind_item_id: item.blind_item_id,
+          packet_sha256: item.packet_sha256, ...record });
+        form.querySelector("button").disabled = true;
+        form.querySelector("button").textContent = "已保存到本页";
+        notes.readOnly = true;
+        updateProgress();
+      });
+      const submit = node("button", "保存此条评价"); submit.type = "submit"; form.append(submit);
+      if (reviews.has(item.blind_item_id)) {
+        const previous = reviews.get(item.blind_item_id);
+        for (const key of ["reviewer", "usefulness", "citation_accuracy", "post_review_disposition",
+                           "elapsed_seconds", "claims_to_correct", "missed_evidence", "notes"]) {
+          const field = form.elements.namedItem(key);
+          if (field && previous[key] !== null && previous[key] !== undefined) field.value = previous[key];
+        }
+        submit.disabled = true; submit.textContent = "已保存到本页";
+      }
+      card.append(form);
+      return card;
+    }
+    function updateProgress() {
+      const total = session?.items?.length || 0;
+      progressNode.textContent = `${reviews.size} / ${total} 条已评价`;
+      downloadButton.disabled = reviews.size === 0;
+    }
+    async function parseFile(file) { return JSON.parse(await file.text()); }
+    async function loadFiles() {
+      try {
+        if (!packetInput.files?.[0]) return;
+        const value = await parseFile(packetInput.files[0]);
+        if (value.schema_version !== 1 || !Array.isArray(value.items) || !value.blind_session_id) throw new Error("不是 OHScanner blind-session v1 文件");
+        session = value; reviews.clear();
+        if (priorInput.files?.[0]) {
+          const prior = await parseFile(priorInput.files[0]);
+          if (prior.blind_session_id !== session.blind_session_id || !Array.isArray(prior.reviews)) throw new Error("评价文件与盲审会话不匹配");
+          const known = new Map(session.items.map((item) => [item.blind_item_id, item.packet_sha256]));
+          for (const review of prior.reviews) {
+            if (known.get(review.blind_item_id) !== review.packet_sha256) throw new Error("评价文件中的条目或包哈希与当前盲审包不匹配");
+            reviews.set(review.blind_item_id, review);
+          }
+        }
+        startedAt = Date.now(); itemsNode.replaceChildren(...session.items.map(renderItem));
+        statusNode.textContent = `已加载 ${session.items.length} 条匿名条目；session ${session.blind_session_id}。请勿查询实验组别。`;
+        updateProgress();
+      } catch (error) { statusNode.textContent = String(error); }
+    }
+    packetInput.addEventListener("change", () => void loadFiles());
+    priorInput.addEventListener("change", () => void loadFiles());
+    downloadButton.addEventListener("click", () => {
+      const output = { schema_version: 1, blind_session_id: session.blind_session_id,
+        reviews: [...reviews.values()] };
+      const blob = new Blob([JSON.stringify(output, null, 2)], { type: "application/json" });
+      const link = document.createElement("a"); link.href = URL.createObjectURL(blob);
+      link.download = `ohscanner-blind-reviews-${session.blind_session_id}.json`; link.click();
+      URL.revokeObjectURL(link.href);
+    });
+  </script>
+</body>
+</html>
