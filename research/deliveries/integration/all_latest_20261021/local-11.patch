+    def test_partial_parse_candidates_remain_candidates_with_unknown_obligations(self):
+        text=(BASE/'auth_positive.cpp').read_text()
+        complete=context(text)
+        partial_unit=SourceUnit(
+            complete.units[0].path, complete.units[0].language, text,
+            complete.units[0].sha256, 'partial', ('synthetic parser gap',))
+        partial=ScanContext(complete.request,(partial_unit,),complete.shared_facts)
+        run=IpcInterfaceDetector().detect(partial,partial.units)
+        self.assertEqual(run.status,'blocked')
+        self.assertTrue(run.findings, 'a partial parse must not erase visible candidates')
+        self.assertTrue(all(f.evidence_obligations for f in run.findings))
+        self.assertTrue(all(
+            obligation.status == 'unknown'
+            for finding in run.findings for obligation in finding.evidence_obligations))
+
     def test_permission_binding_policy(self):
