+#!/usr/bin/env python3
+"""Native tool output -> normalized records (protocol P4/P6).
+
+Design rules
+------------
+* An adapter never invents a location. If the engine's own words carry no file,
+  the record says so (`file_attribution`) instead of pointing at line 1.
+* An adapter never upgrades evidence. Tool output is `pattern`/`syntax`; a tool
+  that advertises dataflow does not thereby make the row `dataflow`.
+* Family comes from the mechanism that is closest to the tool's own definition,
+  in this order of preference:
+    1. the tool's own rule metadata (`semgrep` ruleset `metadata.family`);
+    2. a declared id table in this file, marked `family_mapping_declared=True`;
+    3. `unmapped`, which is counted but excluded from intersection/difference.
+
+Every returned record is validated against the required key set before it leaves
+this module, so a silently-short record fails here rather than in a summary.
+"""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import re
+from pathlib import Path
+
+SCHEMA_VERSION = 1
+
+REQUIRED = (
+    "schema_version", "record_id", "kind", "tool", "tool_version", "command",
+    "repo", "commit", "file", "line", "rule_or_query_id", "message",
+    "artifact_sha256", "execution_status", "family", "identity_key",
+)
+
+# --- declared id tables (used only where the tool carries no family of its own)
+
+FAMILY_KEYS = ("AUTH-01", "AUTH-02", "AUTH-03", "AUTH-04", "DATA-01", "CAP-01")
+
+# The self-built artifact labels each candidate with its family in the message
+# ("AUTH-01 candidate: ...") but has no `family` field. The label is read, never
+# guessed; the rule-id table used to cross-check it is extracted from the
+# production detector's own emit() calls, so the two can only disagree if the
+# detector changed under the run.
+_EMIT_PAIR = re.compile(r'emit\(\s*"([A-Z]+-[0-9]+)"\s*,\s*"([a-z0-9.\-]+)"')
+_FAMILY_PREFIX = re.compile(r"^\s*([A-Z]+-[0-9]+)\b")
+
+DETECTOR_SOURCE_REL = "src/ohscanner/detectors/interface/analysis.py"
+
+
+def _find_detector_source() -> Path | None:
+    """Locate the production detector source by content, not by counting parents."""
+    for cand in [Path(__file__).resolve(), *Path(__file__).resolve().parents]:
+        p = cand / DETECTOR_SOURCE_REL if cand.is_dir() else None
+        if p and p.is_file():
+            return p
+    return None
+
+
+def production_rule_families(source: Path | None = None) -> dict:
+    """rule id -> family, read off the production detector's own `emit()` calls.
+
+    Returns {} (never a fallback table) when the source cannot be read; callers
+    must then record the rows as `unmapped` and say why.
+    """
+    src = source or _find_detector_source()
+    if not src or not Path(src).is_file():
+        return {}
+    text = Path(src).read_text(encoding="utf-8", errors="replace")
+    return {rule: fam for fam, rule in _EMIT_PAIR.findall(text)}
+
+
+# cppcheck / clang / gcc report CWE-generic defect classes, not IPC families.
+# Only the two bounds-related ids below have a defensible one-to-one reading into
+# DATA-01 ("Parcel length used as a bound"). Everything else stays `unmapped`,
+# which keeps it in the counts and out of the set comparison.
+DECLARED_FAMILY_MAP = {
+    # cppcheck
+    "bufferAccessOutOfBounds": "DATA-01",
+    "arrayIndexOutOfBounds": "DATA-01",
+    "arrayIndexOutOfBoundsCond": "DATA-01",
+    "negativeIndex": "DATA-01",
+    # clang static analyzer / clang-tidy
+    "clang-analyzer-security.ArrayBound": "DATA-01",
+    "clang-analyzer-security.ArrayBoundV2": "DATA-01",
+    "clang-analyzer-alpha.security.ArrayBoundV2": "DATA-01",
+    "clang-analyzer-unix.Malloc": "unmapped",
+    # gcc -fanalyzer / compiler diagnostics
+    "Wstringop-overflow": "DATA-01",
+    "Warray-bounds": "DATA-01",
+}
+
+
+def _sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def _record_id(**kw) -> str:
+    h = hashlib.sha256()
+    for k in sorted(kw):
+        h.update("{0}={1}\x00".format(k, kw[k]).encode("utf-8"))
+    return h.hexdigest()[:16]
+
+
+def _identity_key(family: str, file, line) -> str:
+    return "{0}|{1}|{2}".format(family, file if file is not None else "<none>",
+                                "" if line is None else line)
+
+
+def _finalize(rec: dict) -> dict:
+    for k in REQUIRED:
+        if k not in rec:
+            raise ValueError("adapter produced a record missing {0!r}: {1!r}".format(k, rec))
+    if rec["execution_status"] != "completed" and not rec.get("execution_reason"):
+        raise ValueError("non-completed record must carry execution_reason: {0!r}".format(rec))
+    return rec
+
+
+def _base(ctx: dict, **over) -> dict:
+    rec = {
+        "schema_version": SCHEMA_VERSION,
+        "kind": "tool_alert",
+        "tool": ctx["tool"],
+        "tool_version": ctx["tool_version"],
+        "tool_model_version": None,
+        "command": list(ctx["command"]),
+        "command_is_template": bool(ctx.get("command_is_template", False)),
+        "repo": ctx["repo"],
+        "commit": ctx["commit"],
+        "git_tree": ctx.get("git_tree"),
+        "file": None,
+        "line": None,
+        "column": None,
+        "symbol": None,
+        "file_attribution": "not_applicable",
+        "file_resolution": "none",
+        "rule_or_query_id": "",
+        "rule_version": None,
+        "message": "",
+        "severity": "unassessed",
+        "confidence": "unassessed",
+        "candidate_cwe": None,
+        "evidence_type": "pattern",
+        "family": "unmapped",
+        "family_mapping_declared": False,
+        "identity_key": "",
+        "execution_status": "completed",
+        "execution_reason": None,
+        "parse_status": "complete",
+        "match_status": "hit",
+        "exit_code": ctx.get("exit_code"),
+        "source_sha256": ctx.get("source_sha256"),
+        "artifact_sha256": ctx.get("artifact_sha256"),
+        "native_artifact": str(ctx["raw_path"]) if ctx.get("raw_path") else None,
+        "elapsed_seconds": ctx.get("elapsed_seconds"),
+        "limitations": [],
+    }
+    rec.update(over)
+    rec["identity_key"] = _identity_key(rec["family"], rec["file"], rec["line"])
+    rec["record_id"] = _record_id(kind=rec["kind"], tool=rec["tool"],
+                                  tool_version=rec["tool_version"],
+                                  commit=rec["commit"], file=rec["file"],
+                                  line=rec["line"],
+                                  rule_or_query_id=rec["rule_or_query_id"],
+                                  message=rec["message"][:80])
+    return _finalize(rec)
+
+
+def unexecuted_record(ctx: dict, reason: str, parse_status="not_run") -> dict:
+    """The first-class state. Never a zero, never a silence."""
+    return _base(ctx, execution_status="unexecuted", execution_reason=reason,
+                 parse_status=parse_status, match_status="not_run")
+
+
+# --------------------------------------------------------------------------
+# semgrep-core (native OSS engine, JSON output)
+
+def load_semgrep_family_map(ruleset_path: Path) -> dict:
+    """family per rule id, read from the ruleset's own metadata.
+
+    Mechanical, not declared: if the ruleset changes its metadata the mapping
+    changes with it, and `family_mapping_declared` stays False.
+    """
+    doc = json.loads(Path(ruleset_path).read_text(encoding="utf-8"))
+    rules = doc["rules"] if isinstance(doc, dict) else doc
+    out = {}
+    for r in rules:
+        fam = (r.get("metadata") or {}).get("family")
+        out[r["id"]] = fam if fam in {
+            "AUTH-01", "AUTH-02", "AUTH-03", "AUTH-04", "DATA-01", "CAP-01"} else "unmapped"
+    return out
+
+
+def adapt_semgrep_core(raw_path: Path, ctx: dict, family_map: dict) -> list:
+    doc = json.loads(Path(raw_path).read_text(encoding="utf-8"))
+    out = []
+    for m in doc.get("results", []):
+        extra = m.get("extra") or {}
+        rid = m.get("check_id", "")
+        fam = family_map.get(rid.rsplit(".", 1)[-1], family_map.get(rid, "unmapped"))
+        out.append(_base(
+            ctx,
+            file=m.get("path"),
+            line=(m.get("start") or {}).get("line"),
+            column=(m.get("start") or {}).get("col"),
+            file_attribution="resolved",
+            file_resolution="absolute_in_tree",
+            rule_or_query_id=rid,
+            message=extra.get("message", ""),
+            severity=extra.get("severity", "unassessed") or "unassessed",
+            candidate_cwe=((extra.get("metadata") or {}).get("cwe") or None),
+            evidence_type="pattern",
+            family=fam,
+            family_mapping_declared=False,
+        ))
+    for e in doc.get("errors", []) or []:
+        out.append(_base(ctx, execution_status="failed",
+                         execution_reason=json.dumps(e)[:400],
+                         parse_status="partial", match_status="not_run",
+                         rule_or_query_id="<engine-error>",
+                         message="semgrep-core reported a parse/engine error"))
+    return out
+
+
+# --------------------------------------------------------------------------
+# line-oriented diagnostics: cppcheck, clang-tidy, clang --analyze, g++ -fanalyzer
+
+_CPPCHECK_RE = re.compile(
+    r"^(?P<file>.+?):(?P<line>\d+):(?P<col>\d+):(?P<sev>\w+):(?P<id>[\w.:]+):(?P<msg>.*)$")
+_CLANG_TIDY_RE = re.compile(
+    r"^(?P<file>.+?):(?P<line>\d+):(?P<col>\d+):\s*(?P<sev>\w+):\s*(?P<msg>.*?)(?:\s*\[(?P<id>[^\]]+)\])?$")
+_GCC_RE = re.compile(
+    r"^(?P<file>.+?):(?P<line>\d+):(?P<col>\d+):\s*(?P<sev>warning|error|note):\s*(?P<msg>.*?)(?:\s*\[(?P<id>-W[\w=-]+)\])?$")
+
+
+def _adapt_lines(raw_path: Path, ctx: dict, rx, default_id: str) -> list:
+    out = []
+    text = Path(raw_path).read_text(encoding="utf-8", errors="replace")
+    for ln in text.splitlines():
+        m = rx.match(ln.strip())
+        if not m:
+            continue
+        g = m.groupdict()
+        rid = g.get("id") or default_id
+        fam = DECLARED_FAMILY_MAP.get(rid, "unmapped")
+        # A parse failure is not a finding. cppcheck's `syntaxError` id is the
+        # clearest case: it means the tool could not read the file, so the row is
+        # recorded with parse_status=partial and match_status=not_run. Counting it
+        # as a rule hit would turn "could not parse" into "reported something".
+        parse_failure = rid in ("syntaxError", "missingInclude", "missingIncludeSystem")
+        out.append(_base(
+            ctx,
+            file=g["file"],
+            line=int(g["line"]),
+            column=int(g["col"]),
+            file_attribution="resolved",
+            file_resolution="absolute_in_tree",
+            rule_or_query_id=rid,
+            message=g["msg"],
+            severity=g["sev"],
+            evidence_type=("unknown" if parse_failure else "pattern"),
+            family=fam,
+            family_mapping_declared=(fam != "unmapped"),
+            parse_status=("partial" if parse_failure else "complete"),
+            match_status=("not_run" if parse_failure else "hit"),
+        ))
+    return out
+
+
+def adapt_cppcheck(raw_path: Path, ctx: dict) -> list:
+    return _adapt_lines(raw_path, ctx, _CPPCHECK_RE, "<no-id>")
+
+
+def adapt_clang_tidy(raw_path: Path, ctx: dict) -> list:
+    return _adapt_lines(raw_path, ctx, _CLANG_TIDY_RE, "<no-check>")
+
+
+def adapt_gcc_analyzer(raw_path: Path, ctx: dict) -> list:
+    return _adapt_lines(raw_path, ctx, _GCC_RE, "<no-warning-flag>")
+
+
+def adapt_clang_sa(raw_path: Path, ctx: dict) -> list:
+    return _adapt_lines(raw_path, ctx, _GCC_RE, "<no-checker>")
+
+
+# --------------------------------------------------------------------------
+# CodeQL CSV
+
+def adapt_codeql_csv(raw_path: Path, ctx: dict) -> list:
+    """CodeQL's CSV is heterogeneous: a vendor query emits
+    name,description,severity,message,file,start_line,...; a hand-written
+    `@kind problem` query that selects a string emits no location at all.
+    Both are read honestly: the second yields file_attribution='not_applicable'
+    rather than a guessed line.
+    """
+    out = []
+    with open(raw_path, newline="", encoding="utf-8") as fh:
+        rows = list(csv.DictReader(fh))
+    for r in rows:
+        keys = {k.lower(): k for k in r.keys() if k}
+        def col(*names):
+            for n in names:
+                if n in keys:
+                    return r[keys[n]]
+            return None
+        f = col("file")
+        ln = col("start_line", "line")
+        rid = col("name") or ctx.get("query_id") or "<unnamed-query>"
+        raw_msg = col("message") or ""
+        desc = col("description") or ""
+        fam = DECLARED_FAMILY_MAP.get(rid, "unmapped")
+        out.append(_base(
+            ctx,
+            file=(f.lstrip("/") if isinstance(f, str) else None),
+            line=(int(ln) if ln not in (None, "") else None),
+            column=(int(col("start_col") or 0) or None),
+            file_attribution="resolved" if f else "not_applicable",
+            file_resolution="repo_relative" if f else "none",
+            rule_or_query_id=rid,
+            message=(raw_msg + (" — " + desc if desc else "")).strip(),
+            severity=(col("severity") or "unassessed"),
+            evidence_type="pattern",
+            family=fam,
+            family_mapping_declared=(fam != "unmapped"),
+            limitations=([] if f else [
+                "This query selects a bare entity name, not a Location, so the "
+                "record carries no file/line. Recorded as absent, not as line 1."]),
+        ))
+    return out
+
+
+# --------------------------------------------------------------------------
+# Joern (findings JSON written by joern-ipc.sc)
+
+def adapt_joern_json(raw_path: Path, ctx: dict) -> list:
+    doc = json.loads(Path(raw_path).read_text(encoding="utf-8"))
+    rows = doc if isinstance(doc, list) else doc.get("findings", [])
+    out = []
+    for r in rows:
+        f = r.get("file")
+        line = r.get("line")
+        placeholder = (f in (None, "", "<empty>") or not isinstance(f, str)
+                       or "<unresolved" in str(r.get("symbol", "")))
+        fam = {"AUTH-01": "AUTH-01", "AUTH-02": "AUTH-02",
+               "AUTH-03": "AUTH-03", "CAP-01": "CAP-01"}.get(r.get("family"), "unmapped")
+        out.append(_base(
+            ctx,
+            file=(None if placeholder else f),
+            line=(None if placeholder else line),
+            symbol=r.get("symbol"),
+            file_attribution=("unresolved_namespace" if placeholder else "resolved"),
+            file_resolution=("none" if placeholder else "absolute_in_tree"),
+            rule_or_query_id=r.get("rule") or r.get("rule_id") or "<joern-query>",
+            message=r.get("message", ""),
+            evidence_type="syntax",
+            family=fam,
+            family_mapping_declared=False,
+            limitations=([] if not placeholder else [
+                "Joern attributed this row to an unresolved namespace placeholder, "
+                "not to a source location. Countable; not a candidate at a location."]),
+        ))
+    return out
+
+
+# --------------------------------------------------------------------------
+# the first-party detector's own candidates
+
+def adapt_self_built(report_path: Path, ctx: dict) -> list:
+    doc = json.loads(Path(report_path).read_text(encoding="utf-8"))
+    rule_map = production_rule_families(ctx.get("detector_source"))
+    out = []
+    for c in doc.get("candidates", []):
+        fam, fam_note = _self_built_family(c, rule_map)
+        extra = [fam_note] if fam_note else []
+        out.append(_base(
+            dict(ctx, tool=c.get("interpretation_id", "ohscanner.interface.ipc"),
+                 tool_version=c.get("detector_version", ctx.get("tool_version", "")),
+                 command=list(ctx["command"]), artifact_sha256=str(report_path)),
+            kind="self_built_candidate",
+            tool_model_version=c.get("model_version"),
+            file=c.get("file"),
+            line=c.get("line"),
+            file_attribution="resolved",
+            file_resolution="repo_relative",
+            rule_or_query_id=c.get("rule_id", ""),
+            rule_version=c.get("rule_version"),
+            message=c.get("message", ""),
+            severity=c.get("severity", "unassessed"),
+            confidence=c.get("confidence", "unassessed"),
+            candidate_cwe=c.get("candidate_cwe"),
+            evidence_type=c.get("evidence_type", "syntax"),
+            family=fam,
+            family_mapping_declared=False,
+            family_mapping_source=("artifact_label+production_emit_table" if fam != "unmapped"
+                                   else "unmapped"),
+            source_sha256=c.get("source_sha256"),
+            limitations=["Self-built candidate: unverified evidence, not a vulnerability."] + extra,
+        ))
+    return out
+
+
+def _self_built_family(c: dict, rule_map: dict) -> tuple:
+    """(family, note). `unmapped` is returned with a note rather than silently."""
+    m = _FAMILY_PREFIX.match(c.get("message") or "")
+    by_label = m.group(1) if m and m.group(1) in FAMILY_KEYS else None
+    by_rule = rule_map.get(c.get("rule_id", ""))
+    if by_label and by_rule and by_label != by_rule:
+        return "unmapped", (
+            "family conflict for rule {0!r}: artifact label says {1}, the production emit() "
+            "table says {2}; recorded unmapped so the row cannot enter the set comparison"
+            .format(c.get("rule_id"), by_label, by_rule))
+    fam = by_label or by_rule
+    if fam:
+        return fam, None
+    if not rule_map:
+        return "unmapped", ("family unmapped: the production detector source was not readable, "
+                            "so only the artifact's own label was available and it carried none")
+    return "unmapped", ("family unmapped: rule id {0!r} has no emit() pair in the production "
+                        "detector and no family label in the message".format(c.get("rule_id")))
