+#!/usr/bin/env python3
+"""Run the tool matrix and emit normalized records + the comparison summary.
+
+    PYTHONPATH=. .venv/bin/python -m research.experiments.tool_matrix.run_matrix \
+        --components all --tools semgrep,cppcheck \
+        --selfbuilt-dir /home/audit/wtmp/tool_matrix/selfbuilt \
+        --out /home/audit/wtmp/tool_matrix/run-YYYYMMDD
+
+Writes, under --out (which must live OUTSIDE the repository):
+    raw/            native stdout/stderr per (component, tool), untouched
+    matrix.json     normalized records + per-component summary
+    matrix.md       the human table
+
+Hard rules enforced here, not just documented:
+  * every record's `artifact_sha256` is the hash of a file this process wrote;
+  * a tool that did not run produces `unexecuted` rows with its raw reason and
+    NEVER a zero;
+  * `--components all` requires every component to be present and pinned; a
+    missing tree is an error, not a skip;
+  * the tool file set is recorded separately from the corpus file set, so any
+    narrowing (e.g. semgrep is cpp-only, so .ets/.js/.ts are not passed to it) is
+    visible in the numbers instead of hidden in the plumbing.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+
+def find_repo_root(start: Path):
+    """Walk up to the directory that holds AGENTS.md and src/ohscanner.
+
+    Counting `parents[n]` is how this file first got the wrong root (it landed on
+    the parent of the worktree, so the self-built side failed to import for every
+    component). Identifying the repo by its contents removes that failure mode.
+    """
+    for cand in [start, *start.parents]:
+        if (cand / "AGENTS.md").is_file() and (cand / "src" / "ohscanner").is_dir():
+            return cand
+    return None
+
+
+REPO_ROOT = find_repo_root(HERE)
+if REPO_ROOT is None:
+    sys.stderr.write("FATAL: could not locate the repository root above {0}\n".format(HERE))
+    raise SystemExit(3)
+sys.path.insert(0, str(REPO_ROOT))
+
+import adapters as A  # noqa: E402
+import corpus as C  # noqa: E402
+
+CXX_SUFFIXES = (".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp")
+SEMGREP_CORE = Path("/home/audit/openharmony-audit/ipc-research/tools/semgrep-native/"
+                    "semgrep-1.180.0.data/purelib/semgrep/bin/semgrep-core")
+SEMGREP_RULES = HERE.parent / "interface" / "ipc" / "semgrep-rules.json"
+
+# Tools we know how to drive. A tool listed in `--tools` but present in
+# UNRUNNABLE gets honest `unexecuted` rows, not silence.
+UNRUNNABLE = {
+    "clang-tidy": (
+        "probe (2026-10-17) exit=1 on every real component file: the translation unit "
+        "cannot be parsed in this environment. The include closure stops at "
+        "'linux/ashmem.h: No such file or directory' (kernel UAPI header absent on Ubuntu 22.04) "
+        "after accesstoken_callback_stubs.h -> i_permission_state_callback.h -> iremote_broker.h. "
+        "Not run over the 10 components. This is NOT 'no findings'."),
+    "clang-sa": (
+        "probe (2026-10-17) exit=1 on every real component file, same include-closure failure as "
+        "clang-tidy. Not run over the 10 components. NOT 'no findings'."),
+    "gcc-analyzer": (
+        "probe (2026-10-17) exit=1 on every real component file, same include-closure failure. "
+        "Not run over the 10 components. NOT 'no findings'."),
+    "codeql": (
+        "requires a working build command: `codeql database create ... --command=g++ ...` exits 2 "
+        "when the same include closure fails. Database creation completed only on the self-contained "
+        "fixture. Not run over the 10 components. NOT 'no findings'."),
+    "joern": (
+        "parsed only the two probe samples (fixture.cpg, real.cpg). Not run over the 10 components "
+        "in this session. On the real sample its single row was an unresolved-namespace placeholder "
+        "carrying no file/line. NOT 'no findings'."),
+}
+
+
+def detector_identity():
+    """(version, model_version) of the first-party detector, or (None, None).
+
+    Needed because a 0-candidate report carries no candidate to read the version
+    from, and "0 candidates" must still say WHICH detector produced that zero.
+    """
+    try:
+        from src.ohscanner.detectors.interface.detector import IpcInterfaceDetector as D
+        return D.version, D.model_version
+    except Exception:
+        return None, None
+
+
+def sha256_file(p: Path) -> str:
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        for c in iter(lambda: fh.read(65536), b""):
+            h.update(c)
+    return h.hexdigest()
+
+
+def sha256_paths(paths) -> str:
+    h = hashlib.sha256()
+    for p in sorted(paths):
+        h.update(p.encode("utf-8"))
+        h.update(b"\n")
+    return h.hexdigest()
+
+
+def git_tree(root: Path):
+    try:
+        r = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD^{tree}"],
+                           capture_output=True, text=True, timeout=20)
+        return r.stdout.strip() or None if r.returncode == 0 else None
+    except Exception:
+        return None
+
+
+def run_tool(argv, cwd, timeout):
+    t0 = time.time()
+    try:
+        p = subprocess.run(argv, cwd=str(cwd), capture_output=True, text=True,
+                           errors="replace", timeout=timeout)
+        return p.returncode, p.stdout, p.stderr, time.time() - t0, None
+    except subprocess.TimeoutExpired as e:
+        return None, (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or ""), \
+               (e.stderr or ""), time.time() - t0, "timeout after {0}s".format(timeout)
+    except FileNotFoundError as e:
+        return None, "", str(e), time.time() - t0, "executable not found: {0}".format(argv[0])
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description="Tool matrix runner (protocol P1-P5).")
+    ap.add_argument("--corpus", default=str(Path.home() / "openharmony-audit" / "perf-corpus"))
+    ap.add_argument("--components", default="all", help="comma list, or 'all'")
+    ap.add_argument("--tools", default="semgrep,cppcheck")
+    ap.add_argument("--selfbuilt-dir", default=None,
+                    help="Directory of <component>.json detector reports. Absent => self-built side is unexecuted.")
+    ap.add_argument("--out", required=True, help="Output directory; MUST be outside the repository.")
+    ap.add_argument("--timeout", type=int, default=900, help="Per (component, tool) wall-clock cap, seconds.")
+    args = ap.parse_args(argv)
+
+    out = Path(args.out).resolve()
+    repo_root = REPO_ROOT.resolve()
+    if out == repo_root or repo_root in out.parents:
+        print("REFUSING: --out is inside the repository ({0}). Generated artifacts must not be "
+              "committable (AGENTS.md). Use a path under /home/audit/wtmp/.".format(out),
+              file=sys.stderr)
+        return 2
+    (out / "raw").mkdir(parents=True, exist_ok=True)
+
+    components = C.component_names() if args.components == "all" else args.components.split(",")
+    tools = [t.strip() for t in args.tools.split(",") if t.strip()]
+
+    fam_map = A.load_semgrep_family_map(SEMGREP_RULES)
+
+    matrix = {
+        "protocol_version": C.PROTOCOL_VERSION,
+        "corpus_root": args.corpus,
+        "selfbuilt_dir": args.selfbuilt_dir,
+        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "tools_requested": tools,
+        "components": [],
+        "records": [],
+    }
+
+    for comp in components:
+        root = Path(args.corpus) / comp
+        if not root.is_dir():
+            print("ERROR: pinned tree missing for {0}: {1}".format(comp, root), file=sys.stderr)
+            return 4
+        meta = C.component(comp)
+        fs = C.file_set_record(root, comp)
+        tree = git_tree(root)
+        cxx = [p for p in fs["files"] if p.endswith(CXX_SUFFIXES)]
+
+        entry = {
+            "component": comp, "repository": meta["repository"], "commit": meta["commit"],
+            "git_tree": tree, "root": str(root),
+            "file_count": fs["file_count"], "file_set_sha256": fs["file_set_sha256"],
+            "bytes": fs["bytes"],
+            "tools": {}, "self_built": {}, "unexecuted": [],
+            "comparison": {},
+        }
+        print("[{0}] files={1} sha={2} tree={3}".format(
+            comp, fs["file_count"], fs["file_set_sha256"][:12], (tree or "?")[:12]))
+
+        for tool in tools:
+            rec_ctx = {
+                "tool": tool, "tool_version": "?", "command": [],
+                "repo": meta["repository"], "commit": meta["commit"], "git_tree": tree,
+                "exit_code": None,
+            }
+            if tool in UNRUNNABLE:
+                reason = UNRUNNABLE[tool]
+                rec_ctx["command"] = ["<not executed>", tool]
+                # one unexecuted row per component; the file count is carried in
+                # the summary, not fabricated as rows.
+                r = A.unexecuted_record(rec_ctx, reason)
+                r["file"] = None
+                r["identity_key"] = A._identity_key("unmapped", "<not executed>", None)
+                matrix["records"].append(r)
+                entry["tools"][tool] = {"execution_status": "unexecuted",
+                                        "reason": reason, "records": 0}
+                entry["unexecuted"].append(tool)
+                print("    {0:<14} UNEXECUTED".format(tool))
+                continue
+
+            if tool == "semgrep":
+                # Profile: ONE INVOCATION PER TARGET FILE. semgrep-core 1.180.0
+                # refuses `-lang` with multiple targets (raw error captured
+                # 2026-10-17), and its `-targets` flag wants an ATD config, not a
+                # path list. Per-file is also the profile the existing first-party
+                # driver research/experiments/interface/ipc/run_semgrep.py uses, so
+                # the numbers stay comparable with the project's earlier results.
+                #
+                # The equivalence of this profile against a single-process run
+                # could not be tested, because no single-process form exists for
+                # this ruleset. Recorded as a limitation, not assumed.
+                version = "1.180.0"
+                adapter = lambda p, c: A.adapt_semgrep_core(p, c, fam_map)
+                raw_stdout = out / "raw" / "{0}.semgrep.json".format(comp)
+                perfile = out / "raw" / "{0}.semgrep.perfile".format(comp)
+                perfile.mkdir(parents=True, exist_ok=True)
+                agg = {"version": version, "aggregation": "one_invocation_per_target",
+                       "invocations": 0, "results": [], "errors": [],
+                       "paths": {"scanned": []}, "per_file_raw_dir": str(perfile)}
+                t0 = time.time()
+                fail = None
+                for i, rel in enumerate(cxx):
+                    one = [str(SEMGREP_CORE), "-rules", str(SEMGREP_RULES),
+                           "-lang", "cpp", "-json_nodots", "-j", "1", rel]
+                    code, so, se, el, err = run_tool(one, root, min(120, args.timeout))
+                    agg["invocations"] += 1
+                    agg["paths"]["scanned"].append(rel)
+                    (perfile / "{0:05d}.json".format(i)).write_text(so, encoding="utf-8")
+                    if err:
+                        agg["errors"].append({"path": rel, "error": err})
+                        fail = fail or err
+                        continue
+                    try:
+                        d = json.loads(so)
+                    except Exception as exc:
+                        agg["errors"].append({"path": rel, "error": "unparseable: {0!r}".format(exc)})
+                        continue
+                    agg["results"].extend(d.get("results", []))
+                    agg["errors"].extend(d.get("errors", []) or [])
+                raw_stdout.write_text(json.dumps(agg, indent=1), encoding="utf-8")
+                (out / "raw" / "{0}.semgrep.stderr.txt".format(comp)).write_text(
+                    json.dumps([e for e in agg["errors"]], indent=1), encoding="utf-8")
+                parse_target = raw_stdout
+                code = 0 if not fail else 1
+                err = fail
+                elapsed = time.time() - t0
+                so = ""
+                se = ""
+                raw_argv = ["{0} -rules {1} -lang cpp -json_nodots -j 1 <file>".format(
+                    SEMGREP_CORE, SEMGREP_RULES)]
+            elif tool == "cppcheck":
+                argv = ["cppcheck", "--enable=all", "--inconclusive", "--std=c++17", "-j", "8",
+                        "--template={file}:{line}:{column}:{severity}:{id}:{message}",
+                        "--quiet"] + cxx
+                version = subprocess.run(["cppcheck", "--version"], capture_output=True,
+                                         text=True).stdout.strip() or "?"
+                adapter = A.adapt_cppcheck
+                raw_stdout = out / "raw" / "{0}.cppcheck.captured.txt".format(comp)
+            else:
+                reason = ("no runner implemented in this skeleton for '{0}'; the tool is known to "
+                          "this matrix but was not driven over the file set in this run.".format(tool))
+                rec_ctx["command"] = ["<not executed>", tool]
+                r = A.unexecuted_record(rec_ctx, reason)
+                matrix["records"].append(r)
+                entry["tools"][tool] = {"execution_status": "unexecuted", "reason": reason, "records": 0}
+                entry["unexecuted"].append(tool)
+                print("    {0:<14} UNEXECUTED (no runner)".format(tool))
+                continue
+
+            tool_fs_sha = sha256_paths(cxx)
+            pre_ran = (tool == "semgrep")   # ran one invocation per target above
+            if not pre_ran:
+                code, so, se, elapsed, err = run_tool(argv, root, args.timeout)
+                record_argv = list(argv)
+            else:
+                record_argv = list(raw_argv)
+            (out / "raw" / "{0}.{1}.argv.json".format(comp, tool)).write_text(
+                json.dumps({"argv": record_argv, "cwd": str(root), "timeout_s": args.timeout,
+                            "file_set_sha256": tool_fs_sha, "file_count": len(cxx),
+                            "invocations": (len(cxx) if pre_ran else 1),
+                            "command_is_template": bool(pre_ran)},
+                           indent=2) + "\n", encoding="utf-8")
+
+            if pre_ran:
+                parse_target = raw_stdout       # aggregate written by the per-file loop
+            else:
+                (out / "raw" / "{0}.{1}.stdout.txt".format(comp, tool)).write_text(so, encoding="utf-8")
+                (out / "raw" / "{0}.{1}.stderr.txt".format(comp, tool)).write_text(se, encoding="utf-8")
+                raw_stdout.write_text(so + "\n" + se, encoding="utf-8")
+                parse_target = raw_stdout
+
+            art_sha = sha256_file(parse_target)
+            status = "completed" if (code == 0 and err is None) else ("timeout" if err else "failed")
+
+            rec_ctx = {
+                "tool": tool, "tool_version": version, "command": record_argv,
+                "command_is_template": bool(pre_ran),
+                "repo": meta["repository"], "commit": meta["commit"], "git_tree": tree,
+                "exit_code": code, "raw_path": parse_target,
+                "artifact_sha256": art_sha, "elapsed_seconds": round(elapsed, 3),
+            }
+            rows = []
+            if status == "completed" or (status == "failed" and parse_target.stat().st_size > 0):
+                try:
+                    rows = adapter(parse_target, rec_ctx)
+                except Exception as exc:
+                    rows = [A.unexecuted_record(rec_ctx, "adapter failed: {0!r}".format(exc),
+                                                parse_status="failed")]
+            if status != "completed":
+                for r in rows:
+                    r["execution_status"] = status
+                    r["execution_reason"] = err or "exit code {0}".format(code)
+                    r["parse_status"] = "partial" if rows else "failed"
+            if not rows:
+                rows = [A.unexecuted_record(
+                    rec_ctx,
+                    "engine produced no parseable rows (exit={0}); this records absence of output, "
+                    "which is not the same statement as 'the engine found nothing'.".format(code))]
+
+            matrix["records"].extend(rows)
+            by_fam = {}
+            for r in rows:
+                by_fam[r["family"]] = by_fam.get(r["family"], 0) + 1
+            entry["tools"][tool] = {
+                "execution_status": status,
+                "exit_code": code,
+                "exit_reason": err,
+                "tool_version": version,
+                "command": record_argv,
+                "command_is_template": bool(pre_ran),
+                "invocations": (len(cxx) if pre_ran else 1),
+                "artifact_sha256": art_sha,
+                "native_artifact": str(parse_target),
+                "tool_file_count": len(cxx),
+                "tool_file_set_sha256": tool_fs_sha,
+                "records": len(rows),
+                # rows whose meaning is "the engine could not parse this file":
+                # counted, reported, and never presented as findings.
+                "parse_error_rows": sum(1 for r in rows if r["parse_status"] == "partial"
+                                        and r["match_status"] == "not_run"),
+                "by_family": by_fam,
+                "elapsed_seconds": round(elapsed, 3),
+            }
+            print("    {0:<14} {1:<9} rows={2} exit={3} {4}s".format(tool, status, len(rows), code, round(elapsed, 1)))
+
+        # ---- self-built side -------------------------------------------------
+        sb_dir = Path(args.selfbuilt_dir) if args.selfbuilt_dir else None
+        sb_path = (sb_dir / "{0}.json".format(comp)) if sb_dir else None
+        if sb_path and sb_path.exists():
+            sb_doc = json.loads(sb_path.read_text(encoding="utf-8"))
+            _cand = (sb_doc.get("candidates") or [{}])[0]
+            ver = _cand.get("detector_version") or sb_doc.get("detector_version")
+            mv = _cand.get("model_version") or sb_doc.get("model_version")
+            vsrc = "artifact" if ver else None
+            if not ver:
+                _dv, _dm = detector_identity()
+                ver, mv, vsrc = _dv, _dm, ("live_import" if _dv else None)
+            command = sb_doc.get("scope", {}).get("command") or [
+                "python", "-m", "src.ohscanner.detectors.interface.audit",
+                "--repo-dir", str(root), "--repository", meta["repository"],
+                "--commit", meta["commit"], "--out-dir", str(sb_dir)]
+            rec_ctx = {
+                "tool": "ohscanner.interface.ipc",
+                "tool_version": ver or "(unknown)",
+                "command": command, "repo": meta["repository"], "commit": meta["commit"],
+                "git_tree": sb_doc.get("git_tree") or tree,
+                "artifact_sha256": sha256_file(sb_path),
+                "raw_path": sb_path,
+                "detector_source": str(REPO_ROOT / "src/ohscanner/detectors/interface/analysis.py"),
+            }
+            rows = A.adapt_self_built(sb_path, rec_ctx)
+            matrix["records"].extend(rows)
+            audited = sb_doc.get("counts", {}).get("source_files_audited")
+            conflict = (audited is not None and audited != fs["file_count"])
+            entry["self_built"] = {
+                "execution_status": "completed",
+                "report": str(sb_path),
+                "artifact_sha256": sha256_file(sb_path),
+                "candidates": len(rows),
+                "by_family": _by_family(rows),
+                "validated_vulnerability": sb_doc.get("validated_vulnerability"),
+                "detector_version": ver,
+                "model_version": mv,
+                "version_source": vsrc,
+                "files_audited": audited,
+                "file_count_conflict": conflict,
+            }
+            if ver is None:
+                entry["self_built"]["version_warning"] = (
+                    "detector version could not be recovered from the artifact (0 candidates carry "
+                    "it) and the detector module could not be imported; this zero is unlabelled.")
+            if conflict:
+                entry["self_built"]["conflict_detail"] = (
+                    "corpus enumerated {0} files, detector audited {1}; the two sides are NOT on the "
+                    "same file set and their counts must not be compared until this is resolved."
+                    .format(fs["file_count"], audited))
+            print("    {0:<14} candidates={1} (audited={2})".format(
+                "self-built", len(rows), audited))
+        else:
+            entry["self_built"] = {"execution_status": "unexecuted",
+                                   "reason": "no detector report at {0}".format(sb_path)}
+            print("    {0:<14} UNEXECUTED (no report)".format("self-built"))
+
+        entry["comparison"] = _compare(entry, matrix["records"], comp)
+        matrix["components"].append(entry)
+
+    (out / "matrix.json").write_text(json.dumps(matrix, indent=2), encoding="utf-8")
+    (out / "matrix.md").write_text(render_md(matrix), encoding="utf-8")
+    print("\nwrote {0} and {1}".format(out / "matrix.json", out / "matrix.md"))
+    return 0
+
+
+def _by_family(rows):
+    d = {}
+    for r in rows:
+        d[r["family"]] = d.get(r["family"], 0) + 1
+    return d
+
+
+def _compare(entry, all_records, comp):
+    """Per-item intersection/difference, strictly inside one family (protocol P6)."""
+    tool_rows = [r for r in all_records
+                 if r.get("repo") and r["commit"] == entry["commit"]
+                 and r["kind"] == "tool_alert" and r["execution_status"] == "completed"
+                 and r["match_status"] == "hit"]
+    sb_rows = [r for r in all_records
+               if r["kind"] == "self_built_candidate" and r["commit"] == entry["commit"]]
+    out = {}
+    loose_t = {(r["family"], r["file"]) for r in tool_rows if r["family"] != "unmapped" and r["file"]}
+    loose_s = {(r["family"], r["file"]) for r in sb_rows if r["family"] != "unmapped" and r["file"]}
+    strict_t = {(r["family"], r["file"], r["line"]) for r in tool_rows if r["family"] != "unmapped" and r["file"]}
+    strict_s = {(r["family"], r["file"], r["line"]) for r in sb_rows if r["family"] != "unmapped" and r["file"]}
+    out["tool_unmapped"] = sum(1 for r in tool_rows if r["family"] == "unmapped")
+    out["self_built_unmapped"] = sum(1 for r in sb_rows if r["family"] == "unmapped")
+    out["loose_family_file"] = {
+        "both": sorted(loose_t & loose_s), "tool_only": sorted(loose_t - loose_s),
+        "self_built_only": sorted(loose_s - loose_t)}
+    out["strict_family_file_line"] = {
+        "both": sorted(strict_t & strict_s), "tool_only": sorted(strict_t - strict_s),
+        "self_built_only": sorted(strict_s - strict_t)}
+    out["unexplained"] = "not attempted: unexplained differences require a review pass and are " \
+                         "never folded into the smallest bucket (protocol P8)."
+    return out
+
+
+def render_md(m):
+    L = []
+    L.append("# Tool matrix run\n")
+    L.append("protocol `{0}` · generated {1}\n".format(m["protocol_version"], m["generated_at_utc"]))
+    L.append("Tool-side and self-built counts are **separate columns on purpose**: one merged "
+             "number would hide which side a difference came from.\n")
+    L.append("| component | commit | files | " + " | ".join(m["tools_requested"]) +
+             " | self-built | unexecuted |")
+    L.append("|---" * (4 + len(m["tools_requested"])) + "|")
+    for e in m["components"]:
+        cells = []
+        for t in m["tools_requested"]:
+            info = e["tools"].get(t, {})
+            if info.get("execution_status") == "unexecuted":
+                cells.append("**unexecuted**")
+            else:
+                cells.append("{0}{1}{2}".format(
+                    info.get("records", 0),
+                    "" if info.get("execution_status") == "completed"
+                    else " ({0})".format(info.get("execution_status")),
+                    "" if not info.get("parse_error_rows")
+                    else " [{0} parse-err]".format(info["parse_error_rows"])))
+        sb = e.get("self_built", {})
+        sbc = "**unexecuted**" if sb.get("execution_status") != "completed" else str(sb.get("candidates", 0))
+        L.append("| {0} | `{1}` | {2} | {3} | {4} | {5} |".format(
+            e["component"], e["commit"][:12], e["file_count"], " | ".join(cells), sbc,
+            ", ".join(e["unexecuted"]) or "—"))
+    L.append("")
+    L.append("## Per-item comparison (inside one family; totals are not reported)\n")
+    for e in m["components"]:
+        c = e["comparison"]
+        if not c:
+            continue
+        L.append("### {0}\n".format(e["component"]))
+        L.append("loose `(family,file)` — both {0} · tool-only {1} · self-built-only {2}".format(
+            len(c["loose_family_file"]["both"]), len(c["loose_family_file"]["tool_only"]),
+            len(c["loose_family_file"]["self_built_only"])))
+        L.append("strict `(family,file,line)` — both {0} · tool-only {1} · self-built-only {2}\n".format(
+            len(c["strict_family_file_line"]["both"]), len(c["strict_family_file_line"]["tool_only"]),
+            len(c["strict_family_file_line"]["self_built_only"])))
+        L.append("unmapped rows — tool {0} · self-built {1}\n".format(
+            c["tool_unmapped"], c["self_built_unmapped"]))
+    return "\n".join(L) + "\n"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/research/experiments/tool_matrix/schema/normalized_record.schema.json b/research/experiments/tool_matrix/schema/normalized_record.schema.json
new file mode 100644
