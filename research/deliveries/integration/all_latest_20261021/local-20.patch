+++ b/research/experiments/tool_matrix/corpus.py
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+"""Corpus + file-set definition for the tool matrix.
+
+Runnable as:
+    .venv/bin/python -m research.experiments.tool_matrix.corpus --list
+    .venv/bin/python -m research.experiments.tool_matrix.corpus --files security_access_token
+
+Protocol P2: the file set has exactly one definition, and it is the one the
+first-party detector already uses in production scope. This module imports that
+definition; it never carries a copy. If the import fails we abort rather than
+fall back, because a fallback copy would turn "same file set" from a mechanical
+guarantee into a verbal promise, and the difference between the two is invisible
+in the resulting numbers.
+
+Outputs of anything run from here belong outside the repository (see README).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+from pathlib import Path
+
+# --- the single definition of the production scope -------------------------
+try:
+    from src.ohscanner.git_source import SOURCE_LANGUAGES
+    from src.ohscanner.detectors.interface.audit import PRODUCTION_EXCLUDED_SEGMENTS
+except Exception as exc:  # pragma: no cover - depends on the caller's cwd/sys.path
+    sys.stderr.write(
+        "FATAL: could not import the production scope definition.\n"
+        "  Imported from: src.ohscanner.git_source / src.ohscanner.detectors.interface.audit\n"
+        "  Error: {0!r}\n"
+        "  Run from the repository root with the project interpreter, e.g.\n"
+        "    PYTHONPATH=. .venv/bin/python -m research.experiments.tool_matrix.corpus --list\n"
+        "  Refusing to fall back to a private copy of the rule (protocol P2).\n".format(exc)
+    )
+    raise SystemExit(3)
+
+PROTOCOL_VERSION = "tool-matrix-protocol/1"
+
+# The 10 perf-corpus components, each pinned at the commit its tree sits at.
+# `commit` was read with `git -C <tree> rev-parse HEAD` on 2026-10-16.
+COMPONENTS = (
+    ("communication_ipc", "openharmony/communication_ipc",
+     "bbb92dbb2f52aca54ab268307c9476ac1802f3ff"),
+    ("inputmethod_imf", "openharmony/inputmethod_imf",
+     "7777cba9eb19085af8e7b90088531028d2937460"),
+    ("multimedia_camera_framework", "openharmony/multimedia_camera_framework",
+     "085a5d0e2dc1c90a4b676bad55675a1cf12a6380"),
+    ("multimedia_player_framework", "openharmony/multimedia_player_framework",
+     "9f9a285ff489afa66861a85dcc4213336a463b36"),
+    ("notification_common_event_service", "openharmony/notification_common_event_service",
+     "aaaaf6d10aa8e1f6bd28673f10d5791d7e9c9e3f"),
+    ("resourceschedule_background_task_mgr", "openharmony/resourceschedule_background_task_mgr",
+     "cff2ff475e3885ee814651f6a13d7f8a5782efdd"),
+    ("security_access_token", "openharmony/security_access_token",
+     "17d88bfb36bea6c9370ba919ac41a22d16dd66b3"),
+    ("telephony_call_manager", "openharmony/telephony_call_manager",
+     "6638d1b37f278d7ed380d907674820e7467cedf8"),
+    ("update_updateservice", "openharmony/update_updateservice",
+     "e4942a33cc5ed29040e5c720bea3b2a8e4a79221"),
+    ("window_window_manager", "openharmony/window_window_manager",
+     "8b0d8fe1b973d865904c942c286b3d2a3b9b08e7"),
+)
+
+SKIP_SEGMENTS = tuple(sorted(PRODUCTION_EXCLUDED_SEGMENTS))
+SOURCE_SUFFIXES = tuple(sorted(SOURCE_LANGUAGES))
+
+
+def component_names() -> list[str]:
+    return [c[0] for c in COMPONENTS]
+
+
+def component(name: str) -> dict:
+    for n, repo, commit in COMPONENTS:
+        if n == name:
+            return {"component": n, "repository": repo, "commit": commit}
+    raise KeyError("unknown component: {0!r}; known: {1}".format(name, ", ".join(component_names())))
+
+
+def file_set(root: Path) -> list[str]:
+    """Repo-relative source paths after the production skip rule.
+
+    Whole-segment matching, so `testing/` survives while `tests/` does not, and
+    `protest.cpp` is not caught by `test`. VCS and dot directories are pruned.
+    """
+    root = Path(root)
+    out: list[str] = []
+    skip = set(SKIP_SEGMENTS)
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames[:] = sorted(d for d in dirnames if d not in skip and not d.startswith("."))
+        for fn in sorted(filenames):
+            if fn.endswith(SOURCE_SUFFIXES):
+                out.append(os.path.relpath(os.path.join(dirpath, fn), root))
+    return sorted(out)
+
+
+def file_set_sha256(paths: list[str]) -> str:
+    h = hashlib.sha256()
+    for p in sorted(paths):
+        h.update(p.encode("utf-8"))
+        h.update(b"\n")
+    return h.hexdigest()
+
+
+def file_set_record(root: Path, comp: str) -> dict:
+    meta = component(comp)
+    paths = file_set(root)
+    total = 0
+    for p in paths:
+        try:
+            total += (Path(root) / p).stat().st_size
+        except OSError:
+            pass
+    return {
+        "protocol_version": PROTOCOL_VERSION,
+        "component": comp,
+        "repository": meta["repository"],
+        "commit": meta["commit"],
+        "root": str(root),
+        "profile": {
+            "skip_rule_source": "src.ohscanner.detectors.interface.audit.PRODUCTION_EXCLUDED_SEGMENTS",
+            "skip_segments": list(SKIP_SEGMENTS),
+            "language_rule_source": "src.ohscanner.git_source.SOURCE_LANGUAGES",
+            "suffixes": list(SOURCE_SUFFIXES),
+            "match": "whole_path_segment",
+        },
+        "file_count": len(paths),
+        "bytes": total,
+        "file_set_sha256": file_set_sha256(paths),
+        "files": paths,
+    }
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description="Tool-matrix corpus definition (protocol P1/P2).")
+    ap.add_argument("--corpus", default=str(Path.home() / "openharmony-audit" / "perf-corpus"),
+                    help="Root holding one directory per component.")
+    ap.add_argument("--list", action="store_true", help="Print the corpus manifest as JSON.")
+    ap.add_argument("--files", metavar="COMPONENT", help="Print the file set for one component.")
+    ap.add_argument("--json-out", default=None, help="Write the file-set record here.")
+    args = ap.parse_args(argv)
+
+    root = Path(args.corpus)
+    if args.files:
+        rec = file_set_record(root / args.files, args.files)
+        if args.json_out:
+            Path(args.json_out).write_text(json.dumps(rec, indent=2) + "\n", encoding="utf-8")
+        else:
+            print("\n".join(rec["files"]))
+        return 0
+
+    manifest = {"protocol_version": PROTOCOL_VERSION, "corpus_root": str(root), "components": []}
+    for name in component_names():
+        meta = component(name)
+        rec = file_set_record(root / name, name)
+        rec.pop("files")
+        recon = root / name
+        rec["tree_present"] = recon.is_dir()
+        rec["head_matches_pin"] = _head_matches(recon, meta["commit"])
+        manifest["components"].append(rec)
+
+    text = json.dumps(manifest, indent=2)
+    if args.json_out:
+        Path(args.json_out).write_text(text + "\n", encoding="utf-8")
+    print(text)
+    return 0
+
+
+def _head_matches(root: Path, commit: str):
+    """None when it cannot be checked, so 'unchecked' never reads as 'matches'."""
+    from subprocess import run
+    try:
+        r = run(["git", "-C", str(root), "rev-parse", "HEAD"],
+                capture_output=True, text=True, timeout=20)
+    except Exception:
+        return None
+    if r.returncode != 0:
+        return None
+    return r.stdout.strip() == commit
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
