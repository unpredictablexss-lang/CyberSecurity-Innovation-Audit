@@ -0,0 +1,38 @@
+/*
+ * Tool-matrix calibration fixture, 2026-10-17.
+ *
+ * NOT an OpenHarmony excerpt and NOT an IPC sample. It exists to calibrate the
+ * detection floor of each engine on a defect that every C/C++ analyzer claims to
+ * catch: a fixed-size stack buffer written from an unbounded source.
+ *
+ * Purpose: separate "the engine has no findings on our IPC fixtures" into
+ *   (i)  the engine is wired up, ran, and reported nothing, versus
+ *   (ii) the engine is wired up but its queries never reach this defect class.
+ * A run of the same engine over this file should produce at least one finding;
+ * if it does not, the engine's plugin path is suspect rather than the input.
+ *
+ * Synthetic input. Not a vulnerability report. Not derived from any component.
+ */
+
+#include <cstring>
+#include <cstdio>
+
+/* Case A (heuristic): the source is an unmodeled parameter, so whether any
+ * engine flags this depends on its unbounded-source model. */
+void CopyName(const char *untrusted)
+{
+    char name[16];
+    std::strcpy(name, untrusted);   /* fixed 16-byte buffer, unbounded copy */
+    std::printf("%s\n", name);
+}
+
+/* Positive control: the overflow is provable from this translation unit alone
+ * (literal longer than the destination). Any engine that runs at all and can
+ * emit a location must flag this. A zero here means the plugin path is broken,
+ * not that the input is clean. */
+void CopyLiteral(void)
+{
+    char small[4];
+    std::strcpy(small, "0123456789ABCDEF");   /* 16 bytes into 4 */
+    std::printf("%s\n", small);
+}
