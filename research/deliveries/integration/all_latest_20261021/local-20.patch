+/*
+ * Tool-matrix fixture, 2026-10-17. Variant of minimal_iremote_stub.cpp whose
+ * dispatcher is defined OUT OF LINE (`Class::OnRemoteRequest`), which is the
+ * shape the OpenHarmony components actually use and the shape the existing
+ * first-party Semgrep ruleset matches on.
+ *
+ * It exists to separate two different reasons for a zero-result run:
+ *   (i)  the tool parsed the file and found nothing;
+ *   (ii) the rule pattern could not match this file's syntactic shape.
+ * Run the same ruleset against both fixtures; the difference is the answer.
+ *
+ * Same three shapes as the in-class fixture: AUTH-01 (no interface-token
+ * check), AUTH-02 (unguarded sensitive effect), DATA-01 (Parcel length as loop
+ * bound). Synthetic input, not a component excerpt, not a vulnerability.
+ */
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace OHOS {
+
+class IRemoteObject;
+
+class MessageParcel {
+public:
+    std::u16string ReadInterfaceToken() { return std::u16string(); }
+    int32_t ReadInt32() { return 0; }
+    uint32_t ReadUint32() { return 0; }
+    std::u16string ReadString16() { return std::u16string(); }
+    bool WriteInt32(int32_t value) { (void)value; return true; }
+    bool WriteRemoteObject(const IRemoteObject* object) { (void)object; return true; }
+};
+
+class MessageOption {
+public:
+    bool IsRemote() const { return true; }
+};
+
+class IRemoteObject {
+public:
+    virtual ~IRemoteObject() = default;
+    virtual int OnRemoteRequest(uint32_t code, MessageParcel& data,
+                                MessageParcel& reply, MessageOption& option) = 0;
+};
+
+template <typename T>
+class IRemoteStub : public IRemoteObject {
+public:
+    static const std::u16string& GetDescriptor();
+};
+
+class IPlatformCallback : public IRemoteObject {
+public:
+    static const std::u16string& GetDescriptor();
+    enum : uint32_t { NOTIFY_EVENT = 1 };
+};
+
+class PlatformCallbackStub : public IRemoteStub<IPlatformCallback> {
+public:
+    int OnRemoteRequest(uint32_t code, MessageParcel& data,
+                        MessageParcel& reply, MessageOption& option) override;
+
+private:
+    int NotifyEvent(int32_t eventId, uint32_t userId,
+                    const std::vector<std::u16string>& eventContent);
+};
+
+/* AUTH-01: no ReadInterfaceToken() anywhere on this path. */
+int PlatformCallbackStub::OnRemoteRequest(uint32_t code, MessageParcel& data,
+                                          MessageParcel& reply, MessageOption& option)
+{
+    (void)option;
+    switch (code) {
+        case IPlatformCallback::NOTIFY_EVENT: {
+            int32_t eventId = data.ReadInt32();
+            uint32_t userId = data.ReadUint32();
+
+            /* DATA-01: Parcel-derived length used directly as a loop bound. */
+            int32_t size = data.ReadInt32();
+            std::vector<std::u16string> eventContent;
+            for (int32_t i = 0; i < size; i++) {
+                eventContent.push_back(data.ReadString16());
+            }
+
+            /* AUTH-02: sensitive effect with no caller-authorization guard. */
+            return NotifyEvent(eventId, userId, eventContent);
+        }
+        case 2: {
+            reply.WriteInt32(0);
+            return 0;
+        }
+        default:
+            return -1;
+    }
+}
+
+int PlatformCallbackStub::NotifyEvent(int32_t eventId, uint32_t userId,
+                                      const std::vector<std::u16string>& eventContent)
+{
+    (void)userId;
+    (void)eventContent;
+    return eventId;
+}
+
+} // namespace OHOS
