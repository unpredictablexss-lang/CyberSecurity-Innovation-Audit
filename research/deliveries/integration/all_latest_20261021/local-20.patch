@@ -0,0 +1,130 @@
+/*
+ * Minimal, self-contained replica of the OpenHarmony IPC stub shape used by the
+ * OHScanner B-line tool matrix (tool-matrix session, 2026-10-17).
+ *
+ * Purpose: give every tool under test a translation unit that needs ZERO
+ * OpenHarmony include resolution, so that "the tool produced no finding" can
+ * never be confused with "the tool could not parse the file". It carries the
+ * same three shapes the B-line detector models on the real components:
+ *
+ *   AUTH-01  a dispatcher that never reads/compares the interface token
+ *   AUTH-02  a sensitive operation reached with no caller-authorization guard
+ *   DATA-01  a Parcel-derived length used directly as a loop bound
+ *
+ * This file is a SYNTHETIC INPUT, not a vulnerability and not a component
+ * excerpt. It is deliberately NOT registered in any expected-finding manifest:
+ * it exists so tools produce raw output that can be normalized and compared.
+ */
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace OHOS {
+
+class IRemoteObject;
+
+class MessageParcel {
+public:
+    std::u16string ReadInterfaceToken() { return std::u16string(); }
+    int32_t ReadInt32() { return 0; }
+    uint32_t ReadUint32() { return 0; }
+    std::u16string ReadString16() { return std::u16string(); }
+    bool WriteInt32(int32_t value) { (void)value; return true; }
+    bool WriteRemoteObject(const IRemoteObject* object) { (void)object; return true; }
+};
+
+class MessageOption {
+public:
+    bool IsRemote() const { return true; }
+};
+
+class IRemoteObject {
+public:
+    virtual ~IRemoteObject() = default;
+    virtual int OnRemoteRequest(uint32_t code, MessageParcel& data,
+                                MessageParcel& reply, MessageOption& option) = 0;
+};
+
+template <typename T>
+class IRemoteStub : public IRemoteObject {
+public:
+    static const std::u16string& GetDescriptor();
+};
+
+class IPlatformCallback : public IRemoteObject {
+public:
+    static const std::u16string& GetDescriptor() { return descriptor_; }
+    enum : uint32_t { NOTIFY_EVENT = 1 };
+
+private:
+    static const std::u16string descriptor_;
+};
+
+/*
+ * AUTH-01 shape: the dispatcher below never calls ReadInterfaceToken() and
+ * never compares against IPlatformCallback::GetDescriptor(), so any transaction
+ * number in range is served. This mirrors the defect shape of
+ * openharmony/inputmethod_imf @ e663b470 services/src/platform_callback_stub.cpp.
+ */
+class PlatformCallbackStub : public IRemoteStub<IPlatformCallback> {
+public:
+    int OnRemoteRequest(uint32_t code, MessageParcel& data,
+                        MessageParcel& reply, MessageOption& option) override
+    {
+        (void)option;
+        switch (code) {
+            case IPlatformCallback::NOTIFY_EVENT: {
+                int32_t eventId = data.ReadInt32();
+                uint32_t userId = data.ReadUint32();
+
+                /* DATA-01 shape: Parcel-derived length used directly as a loop bound. */
+                int32_t size = data.ReadInt32();
+                std::vector<std::u16string> eventContent;
+                for (int32_t i = 0; i < size; i++) {
+                    eventContent.push_back(data.ReadString16());
+                }
+
+                /* AUTH-02 shape: sensitive effect reached with no caller check. */
+                return NotifyEvent(eventId, userId, eventContent);
+            }
+            case 2: {
+                reply.WriteInt32(0);
+                return 0;
+            }
+            default:
+                return -1;
+        }
+    }
+
+private:
+    int NotifyEvent(int32_t eventId, uint32_t userId,
+                    const std::vector<std::u16string>& eventContent)
+    {
+        (void)userId;
+        (void)eventContent;
+        return eventId;
+    }
+};
+
+/*
+ * CAP-01 shape: an internal remote object handed back to the caller of the
+ * transaction, on a path with no permission predicate and no caller check.
+ */
+class RenderSessionHolder : public IRemoteStub<IPlatformCallback> {
+public:
+    int OnRemoteRequest(uint32_t code, MessageParcel& data,
+                        MessageParcel& reply, MessageOption& option) override
+    {
+        (void)code;
+        (void)data;
+        (void)option;
+        reply.WriteRemoteObject(renderSession_);
+        return 0;
+    }
+
+private:
+    IRemoteObject* renderSession_ = nullptr;
+};
+
+} // namespace OHOS
