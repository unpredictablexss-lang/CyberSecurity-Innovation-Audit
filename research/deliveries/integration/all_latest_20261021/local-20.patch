--- /dev/null
+++ b/research/experiments/tool_matrix/schema/normalized_record.schema.json
@@ -0,0 +1,104 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "ohscanner/research/tool_matrix/normalized_record.schema.json",
+  "title": "Tool-matrix normalized record",
+  "description": "One finding-shaped row, from any tool or from the first-party detector. Provenance fields are mandatory: a row without a real command and a real raw-artifact hash must not be written.",
+  "type": "object",
+  "required": [
+    "schema_version", "record_id", "kind", "tool", "tool_version", "command",
+    "repo", "commit", "file", "line", "rule_or_query_id", "message",
+    "artifact_sha256", "execution_status", "family", "identity_key"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "schema_version": { "const": 1 },
+
+    "record_id": {
+      "type": "string",
+      "description": "Deterministic id: sha256 over (kind, tool, tool_version, command, repo, commit, file, line, rule_or_query_id), first 16 hex chars."
+    },
+
+    "kind": { "enum": ["tool_alert", "self_built_candidate"] },
+
+    "tool": {
+      "type": "string",
+      "description": "Tool identity. For the first-party detector this is 'ohscanner.interface.ipc'."
+    },
+    "tool_version": {
+      "type": "string",
+      "description": "Version string as the tool itself reports it. For the detector: '0.8.0'."
+    },
+    "tool_model_version": {
+      "type": ["string", "null"],
+      "description": "Model/ruleset generation where the project has one (detector: 'oh-ipc-2026.10-v6'). Equal in standing to tool_version for the self-built side."
+    },
+    "command": {
+      "type": "array",
+      "items": { "type": "string" },
+      "minItems": 1,
+      "description": "The invocation, verbatim, as an argv list. Never a shell string. A record whose command was not actually executed must carry execution_status=unexecuted."
+    },
+    "command_is_template": {
+      "type": "boolean",
+      "description": "True when the profile is one invocation per target file, so `command` is the argv with '<file>' standing for one target and the real invocation count is in the run summary. A template is recorded rather than disguised as a single literal command."
+    },
+
+    "repo": { "type": "string", "description": "Declared repository, e.g. openharmony/security_access_token. A declaration, not an identity." },
+    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
+    "git_tree": { "type": ["string", "null"] },
+
+    "file": {
+      "type": ["string", "null"],
+      "description": "Repo-relative path. Null only when the engine could not attribute the finding to a file (e.g. Joern unresolved-namespace placeholders) — and then file_attribution must say why."
+    },
+    "line": { "type": ["integer", "null"], "minimum": 1 },
+    "column": { "type": ["integer", "null"], "minimum": 1 },
+    "symbol": { "type": ["string", "null"] },
+    "file_attribution": {
+      "enum": ["resolved", "empty_placeholder", "unresolved_namespace", "not_applicable"],
+      "description": "'empty_placeholder' records a tool result that names no real source location. Such a row is countable but is not a candidate at a location."
+    },
+    "file_resolution": {
+      "enum": ["repo_relative", "absolute_in_tree", "none"],
+      "description": "CodeQL's CSV emits paths like '/calibration_overflow.cpp' (tree-relative, leading slash); adapters must record how they mapped it, not silently rewrite it."
+    },
+
+    "rule_or_query_id": { "type": "string" },
+    "rule_version": { "type": ["string", "null"] },
+    "message": { "type": "string" },
+    "severity": { "type": "string" },
+    "confidence": { "type": "string" },
+
+    "candidate_cwe": { "type": ["string", "null"] },
+    "evidence_type": {
+      "enum": ["pattern", "syntax", "dataflow", "control_flow", "symbolic", "historical",
+               "runtime", "permission", "web_dynamic", "human_review", "unknown"]
+    },
+
+    "family": {
+      "enum": ["AUTH-01", "AUTH-02", "AUTH-03", "AUTH-04", "DATA-01", "CAP-01", "unmapped"],
+      "description": "Comparison family. 'unmapped' is counted but excluded from intersection/difference."
+    },
+    "family_mapping_declared": {
+      "type": "boolean",
+      "description": "True when family came from the adapter's explicit rule-id table rather than from the tool's own words."
+    },
+    "identity_key": { "type": "string", "description": "(family, file, line) rendered canonically." },
+
+    "execution_status": { "enum": ["completed", "failed", "timeout", "unexecuted"] },
+    "execution_reason": { "type": ["string", "null"], "description": "Raw reason/error text. Required when execution_status != completed." },
+    "parse_status": { "enum": ["complete", "partial", "failed", "not_run", "not_applicable"] },
+    "match_status": { "enum": ["hit", "no_match", "not_run"] },
+    "exit_code": { "type": ["integer", "null"] },
+
+    "source_sha256": { "type": ["string", "null"], "description": "sha256 of the analysed source revision. Required for self_built_candidate; required for tool_alert when a pinned blob was analysed." },
+    "artifact_sha256": {
+      "type": ["string", "null"],
+      "description": "sha256 of the raw native output file this row was parsed from. Null is legal only for self_built_candidate rows, which point at their own report artifact instead."
+    },
+    "native_artifact": { "type": ["string", "null"], "description": "Path to that raw output file." },
+
+    "elapsed_seconds": { "type": ["number", "null"] },
+    "limitations": { "type": "array", "items": { "type": "string" } }
+  }
+}
diff --git a/research/experiments/tool_matrix/selfcheck.py b/research/experiments/tool_matrix/selfcheck.py
new file mode 100644
index 00000000..6386111e
--- /dev/null
+++ b/research/experiments/tool_matrix/selfcheck.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""Self-check: run the matrix over the 10 perf-corpus components and check that
+the protocol's invariants actually hold in the produced artifacts.
+
+A self-check that only prints a table proves nothing. This one asserts, and a
+failed assertion is a failed self-check even if the table looks tidy.
+
+    PYTHONPATH=. .venv/bin/python -m research.experiments.tool_matrix.selfcheck \
+        --out /home/audit/wtmp/tool_matrix/selfcheck-20261017
+
+Steps:
+  1. self-built side, at the CURRENT detector version, all 10 components;
+  2. tool side, over the same file set, with the tools that can actually run;
+  3. every tool that cannot run is asked for by name, so it lands in the table as
+     `unexecuted` with its raw reason instead of vanishing;
+  4. the invariants below.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+
+import run_matrix as RM  # noqa: E402
+import corpus as C  # noqa: E402
+
+REPO = RM.REPO_ROOT
+
+PY = Path("/home/audit/openharmony-audit/CyberSecurity-Innovation-Audit-b/.venv/bin/python")
+if not PY.exists():   # the worktree itself has no venv; any project venv will do
+    import glob
+    cands = glob.glob("/home/audit/openharmony-audit/*/.venv/bin/python")
+    if not cands:
+        sys.stderr.write("FATAL: no project virtualenv found; the detector cannot be re-run.\n")
+        raise SystemExit(3)
+    PY = Path(cands[0])
+
+# Asked for by name on purpose: these must appear in the table as unexecuted.
+ALL_TOOLS = "semgrep,cppcheck,clang-tidy,clang-sa,gcc-analyzer,codeql,joern"
+
+
+def run_self_built(corpus_root: Path, comp: str, out_dir: Path) -> dict:
+    meta = C.component(comp)
+    argv = [str(PY), "-m", "src.ohscanner.detectors.interface.audit",
+            "--repo-dir", str(corpus_root / comp),
+            "--repository", meta["repository"],
+            "--commit", meta["commit"],
+            "--passes", "complete-ast,all-files",
+            "--out-dir", str(out_dir)]
+    t0 = time.time()
+    env = dict(os.environ)
+    env["PYTHONPATH"] = str(REPO)
+    env["PYTHONUNBUFFERED"] = "1"
+    p = subprocess.run(argv, cwd=str(REPO), capture_output=True, text=True,
+                       errors="replace", env=env)
+    return {"argv": argv, "exit": p.returncode, "stdout": p.stdout[-2000:],
+            "stderr": p.stderr[-2000:], "elapsed_seconds": round(time.time() - t0, 2)}
+
+
+def check(matrix: dict) -> list:
+    """Returns a list of (ok:bool, label:str, detail:str)."""
+    res = []
+    comps = matrix["components"]
+    req = matrix["tools_requested"]
+
+    res.append((len(comps) == 10, "all 10 components present",
+                "got {0}".format(len(comps))))
+    res.append((all(e.get("file_set_sha256") and e.get("file_count") for e in comps),
+                "every component has a pinned file set (count + sha256)", "protocol P1"))
+    res.append((all(e.get("commit") and len(e["commit"]) == 40 for e in comps),
+                "every component carries a full 40-hex commit", "protocol P1"))
+
+    missing = [(e["component"], t) for e in comps for t in req
+               if t not in e["tools"] and t not in e["unexecuted"]]
+    res.append((not missing, "no requested tool vanished from the summary",
+                "missing: {0}".format(missing[:5])))
+
+    unex = [(e["component"], t) for e in comps for t in e["unexecuted"]]
+    res.append((bool(unex), "at least one tool is recorded as unexecuted (not silently zero)",
+                "{0} cells".format(len(unex))))
+
+    bad = [r["record_id"] for r in matrix["records"]
+           if r["kind"] == "tool_alert" and r["execution_status"] == "completed"
+           and not r.get("artifact_sha256")]
+    res.append((not bad, "every completed tool row traces to a raw artifact hash",
+                "offenders: {0}".format(bad[:3])))
+
+    nonet = [(e["component"], t) for e in comps for t in e["unexecuted"]
+             if not e["tools"].get(t, {}).get("reason")]
+    res.append((not nonet, "every unexecuted cell carries its raw reason",
+                "cells without a reason: {0}".format(nonet[:5])))
+
+    # The first version of the self-built adapter read the family off `rule_id`
+    # as if the rule id WERE the family, so every self-built row landed in
+    # `unmapped` and the intersection read "self-built-only 0" for reasons that
+    # had nothing to do with the corpus. Assert against that shape explicitly.
+    import adapters as A
+    rule_map = A.production_rule_families()
+    res.append((bool(rule_map), "the production emit() family table was readable",
+                "{0} rule ids".format(len(rule_map))))
+    stuck = [(e["component"], r["rule_or_query_id"]) for e in comps
+             for r in matrix["records"]
+             if r["kind"] == "self_built_candidate" and r["family"] == "unmapped"
+             and rule_map.get(r["rule_or_query_id"])]
+    res.append((not stuck, "no self-built row is unmapped while its rule id has a known family",
+                "offenders: {0}".format(stuck[:3])))
+
+    conflict = [(e["component"], e["self_built"].get("files_audited"), e["file_count"])
+                for e in comps if e.get("self_built", {}).get("file_count_conflict")]
+    res.append((not conflict, "self-built file count agrees with the corpus file set",
+                "conflicts: {0}".format(conflict)))
+
+    sbrun = [e["component"] for e in comps
+             if e.get("self_built", {}).get("execution_status") == "completed"]
+    res.append((len(sbrun) == len(comps), "self-built side ran on every component",
+                "ran on {0}/{1}".format(len(sbrun), len(comps))))
+
+    md = (Path(matrix["_out"]) / "matrix.md")
+    text = md.read_text(encoding="utf-8") if md.exists() else ""
+    res.append(("self-built" in text and "unexecuted" in text,
+                "the rendered table keeps tool and self-built counts in separate columns",
+                "protocol P6"))
+    return res
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--corpus", default=str(Path.home() / "openharmony-audit" / "perf-corpus"))
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--tools", default=ALL_TOOLS)
+    ap.add_argument("--skip-selfbuilt", action="store_true")
+    args = ap.parse_args(argv)
+
+    out = Path(args.out).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    sb = out / "selfbuilt"
+    sb.mkdir(exist_ok=True)
+    log = []
+
+    if not args.skip_selfbuilt:
+        print("== step 1: self-built side, current detector version, 10 components ==")
+        for comp in C.component_names():
+            r = run_self_built(Path(args.corpus), comp, sb)
+            log.append({"component": comp, **{k: r[k] for k in ("argv", "exit", "elapsed_seconds")}})
+            tail = [l for l in r["stdout"].splitlines() if "candidates:" in l or "audited files" in l]
+            print("  {0:<38} exit={1} {2}s {3}".format(comp, r["exit"], r["elapsed_seconds"],
