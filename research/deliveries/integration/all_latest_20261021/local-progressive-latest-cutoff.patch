+            raise ValueError("triage operation does not match its audit authorization batch")
+        keys = [uuid.uuid4().hex for _ in specs]
+        stamp = record.get("created_at", now())
+        with self.store.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
