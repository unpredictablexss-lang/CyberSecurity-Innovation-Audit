+"""Deterministic, explainable evidence ranking with family coverage quotas."""
+
+_SEVERITY = {"critical": 24, "high": 18, "medium": 11, "low": 4}
+
+
+def _score(group):
+    finding = group.get("finding", {})
+    components = {
+        "source_binding": 20 if group.get("source_binding_verified") else 0,
+        "evidence": min(24, 6 * len(finding.get("evidence", [])) +
+                         4 * len(finding.get("evidence_obligations", []))),
+        "severity": _SEVERITY.get(str(finding.get("severity", "")).lower(), 0),
+        "entry_or_sink": 8 if finding.get("has_entry_or_sink_evidence") else 0,
+        "change_signal": 5 if finding.get("changed_in_range") else 0,
+        "uncertainty_penalty": -8 if group.get("coverage_unknown") else 0,
+    }
+    return sum(components.values()), components
+
+
+def rank_groups(groups):
+    ranked = []
+    for group in groups:
+        score, components = _score(group)
+        ranked.append({**group, "score": score, "score_components": components})
+    return sorted(ranked, key=lambda x: (-x["score"], x["family_bucket"], x["group_id"]))
+
+
+def select_groups(ranked, limit, family_quotas=True):
+    if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
+        raise ValueError("selection limit must be a nonnegative integer")
+    ordered = list(ranked)
+    selected, chosen, quota_selected = [], set(), set()
+    if family_quotas and limit:
+        buckets = {}
+        for group in ordered:
+            buckets.setdefault(group["family_bucket"], []).append(group)
+        # One deterministic representative per populated family before filling by score.
+        for family in sorted(buckets):
+            if len(selected) == limit:
+                break
+            group = buckets[family][0]
+            selected.append(group); chosen.add(group["group_id"])
+            quota_selected.add(group["group_id"])
+    for group in ordered:
+        if len(selected) >= limit:
+            break
+        if group["group_id"] not in chosen:
+            selected.append(group); chosen.add(group["group_id"])
+    selected_ids = {item["group_id"] for item in selected}
+    result = []
+    for group in ordered:
+        selected_here = group["group_id"] in selected_ids
+        if selected_here:
+            reason = "family_coverage_quota" if group["group_id"] in quota_selected else "top_evidence_score"
+        elif family_quotas and not any(item["family_bucket"] == group["family_bucket"] for item in selected):
+            reason = "family_coverage_quota"
+        else:
+            reason = "selection_limit_reached"
+        result.append({**group, "rank": len(result) + 1, "selected": selected_here,
+            "reason_codes": [reason]})
+    return result
