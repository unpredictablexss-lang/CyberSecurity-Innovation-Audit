+import React, { useEffect, useState } from "react";
+import { Alert, Button, Card, Descriptions, Form, InputNumber, Select, Space, Tag, message } from "antd";
+import { api, apiPut } from "../../api";
+
+const labels: Record<string, string> = { economy: "经济模式", standard: "标准模式", deep: "深度模式", custom: "自定义" };
+const fields: Array<[string, string]> = [
+  ["quick_screen_limit", "快速研判组数（整个任务）"],
+  ["deep_investigation_limit", "深度调查组数（整个任务）"],
+  ["max_tool_steps_per_deep_group", "每组跨文件工具步数"],
+  ["max_model_concurrency", "模型请求并发"],
+  ["max_ai_duration_seconds", "AI 调查时间预算（秒）"],
+  ["max_input_tokens", "最大输入 Token"], ["max_output_tokens", "最大输出 Token"],
+  ["max_model_calls", "模型调用总数"],
+];
+
+export default function IntelligentAuditPolicySettings() {
+  const [saved, setSaved] = useState<any>(null);
+  const [profile, setProfile] = useState("standard");
+  const [limits, setLimits] = useState<any>({});
+  const [cost, setCost] = useState(25);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const refresh = async () => {
+    setError("");
+    try {
+      const current = await api("/agent/triage-policy");
+      setSaved(current); setProfile(current.policy.profile); setLimits(current.policy.limits || {});
+      setCost(Number(current.policy.limits?.max_cost_usd || 0));
+    } catch (e) { setError(String(e)); }
+  };
+  useEffect(() => { void refresh(); }, []);
+  const changeProfile = async (next: string) => {
+    setProfile(next);
+    if (next === "custom") return;
+    try {
+      const data = await api("/agent/triage-policy/preview", { audit_mode: "intelligent", policy: { profile: next }, candidate_count: 0 });
+      setLimits(data.policy.limits); setCost(Number(data.policy.limits.max_cost_usd || 0));
+    } catch (e) { setError(String(e)); }
+  };
+  const save = async () => {
+    setBusy(true); setError("");
+    try {
+      const policy = await apiPut("/agent/triage-policy", { profile, limits: profile === "custom" ? { ...limits, max_cost_usd: cost.toFixed(2) } : {}, family_quotas: profile === "standard" || profile === "deep" });
+      setSaved(policy); message.success("智能审计策略已保存到本机服务");
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  };
+  return <Card title="智能审计策略与资源预算" extra={<Button onClick={() => void refresh()} disabled={busy}>刷新</Button>}>
+    <Alert type="info" showIcon className="section-gap" message="当前设置先持久化策略；任务 Worker 接线尚未完成。"
