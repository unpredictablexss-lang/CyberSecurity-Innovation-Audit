+"""Settings API for local progressive-triage policy."""
+import hashlib
+import json
+from datetime import datetime, timezone
+from fastapi import APIRouter, FastAPI
+from pydantic import BaseModel, ConfigDict, Field
+
+from .contracts import PRESETS, policy_hash, resolve_policy
+from .grouping import build_groups
+from .ledger import BudgetLedger
+from .policy_store import PolicyStore
+from .ranking import rank_groups, select_groups
+from .. import service
+
+
+class StrictPolicyInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    profile: str = Field(default="standard", max_length=20)
+    limits: dict = Field(default_factory=dict)
+    family_quotas: bool | None = None
+
+
+class TriagePreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    audit_mode: str = Field(pattern="^(static_only|intelligent)$")
+    endpoint_count: int = Field(default=1, ge=1, le=8)
+    policy: StrictPolicyInput | None = None
+    candidate_count: int = Field(default=0, ge=0, le=10000)
+
+
+class QuickScreenPreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    group_ids: list[str] = Field(min_length=1, max_length=100)
+    consent_nonce: str = Field(pattern="^[a-f0-9]{32}$")
+
+
+class QuickScreenStartInput(QuickScreenPreviewInput):
+    expected_preview_sha256: str = Field(pattern="^[a-f0-9]{64}$")
+
+
+class DeepInvestigationPreviewInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    group_id: str = Field(min_length=16, max_length=128)
+    consent_nonce: str = Field(pattern="^[a-f0-9]{32}$")
+
+
+class DeepInvestigationStartInput(DeepInvestigationPreviewInput):
+    expected_preview_sha256: str = Field(pattern="^[a-f0-9]{64}$")
+
+
+def install_routes(app: FastAPI, settings, scan_store=None):
+    router = APIRouter(prefix="/api/v1/agent/triage-policy")
+    store = PolicyStore(settings.data_dir)
+
+    @router.get("")
+    def get_policy():
+        return {**store.get(), "presets": PRESETS,
+                "worker_enforcement": "not_connected",
+                "cost_hard_cap": False}
+
+    @router.put("")
+    def put_policy(body: StrictPolicyInput):
+        saved = store.put(body.model_dump(exclude_none=True))
+        return {**saved, "presets": PRESETS,
+                "worker_enforcement": "not_connected",
+                "cost_hard_cap": False}
+
+    @router.post("/preview")
+    def preview_policy(body: TriagePreviewInput):
+        policy = resolve_policy(body.policy.model_dump(exclude_none=True)
+                                if body.policy else store.get()["policy"])
+        mode = body.audit_mode
+        limits = policy["limits"] if mode == "intelligent" else {}
+        return {"audit_mode": mode, "endpoint_count": body.endpoint_count,
+                "policy": policy, "policy_sha256": store.get()["policy_sha256"]
+                    if body.policy is None else policy_hash(policy),
+                "max_quick_screen_groups_for_entire_task":
+                    limits.get("quick_screen_limit", 0),
+                "max_deep_investigation_groups_for_entire_task":
+                    limits.get("deep_investigation_limit", 0),
+                "source_disclosure": mode == "intelligent" and policy["profile"] != "static",
+                "model_calls_allowed": mode == "intelligent" and policy["profile"] != "static",
+                "cost_enforcement": ("provider_cap_required_for_hard_cap"
+                                     if mode == "intelligent" else "no_model_calls"),
+                "worker_enforcement": "not_connected",
+                "raw_candidates_retained": body.candidate_count}
+
+    @app.get("/api/v1/audits/{audit_id}/triage-groups")
+    def triage_groups(audit_id: str, offset: int = 0, limit: int = 100):
+        if scan_store is None:
+            raise ValueError("scan report store is unavailable")
+        if offset < 0 or not 1 <= limit <= 200:
+            raise ValueError("invalid triage group pagination")
+        job = scan_store.job(audit_id)
+        if job["status"] not in {"completed", "completed_with_limitations"} or not job.get("report_sha256"):
+            raise ValueError("triage groups require a completed fixed report")
+        report = service.read_report(settings, job)
+        inventory = {item.get("file"): item for item in
+                     report.get("_workbench", {}).get("source_inventory", [])
+                     if isinstance(item, dict) and isinstance(item.get("file"), str)}
+        findings = []
+        for item in service.findings(report):
+            file = item.get("file")
+            source = inventory.get(file, {})
+            source_sha = item.get("source_sha256")
+            findings.append({**item, "candidate_id": item.get("id"),
+                "repository": report.get("repository"), "commit": report.get("commit"),
+                "report_sha256": job["report_sha256"],
+                "source_binding_verified": bool(source_sha and source.get("sha256") == source_sha
+                    and report.get("repository") and report.get("commit")),
+                "coverage_unknown": item.get("coverage_status") in {"partial", "blocked", "not_analyzed"},
+                "has_entry_or_sink_evidence": bool(item.get("evidence_obligations")),
+                "changed_in_range": bool(item.get("change_status") in {"added", "changed"})})
+        manifest = build_groups(findings)
+        ranked = rank_groups(manifest["groups"])
+        current_policy = store.get()
+        static_only = job.get("spec", {}).get("audit_mode") == "static_only"
+        ledger = BudgetLedger(settings.data_dir)
+        try:
+            budget = ledger.summary(audit_id)
+            quick_results = ledger.quick_results(audit_id)
+            # Once the user authorizes a task, its exact policy is immutable even
+            # if an administrator changes the system default while it is running.
+            policy = budget["policy_snapshot"]
+            policy_sha = budget["policy_sha256"]
+        except KeyError:
+            budget, quick_results = None, {}
+            policy, policy_sha = current_policy["policy"], current_policy["policy_sha256"]
+        selected = select_groups(ranked,
+            policy["limits"].get("quick_screen_limit", 0) if not static_only else 0,
+            policy["family_quotas"])
+        for row in selected:
+            recorded = quick_results.get(row["group_id"])
+            row["quick_screen_status"] = (recorded["result"].get("quick_status")
+                                           if recorded else "not_started")
+            row["quick_assessment"] = (recorded["result"].get("quick_assessment")
+                                       if recorded else None)
+        page = selected[offset:offset + limit]
+        return {"audit_id": audit_id, "report_sha256": job["report_sha256"],
+            "policy_sha256": policy_sha,
+            "status": ("static_only" if static_only else
+                "quick_screening" if budget and budget["quick_screen_groups_attempted"] else
+                "local_ranked_not_dispatched"),
+            "raw_candidate_count": manifest["raw_candidate_count"],
+            "group_count": len(manifest["groups"]),
+            "selected_quick_screen_group_count": sum(1 for row in selected if row["selected"]),
+            "unreviewed_candidate_count": manifest["raw_candidate_count"],
+            "group_manifest_sha256": manifest["manifest_sha256"],
+            "budget": budget,
+            "items": page, "offset": offset, "limit": limit,
+            "worker_enforcement": "quick_screen_connected_deep_agent_not_connected",
+            "candidate_state_changes": False}
+
+    def _quick_screen_preview(audit_id, group_ids, consent_nonce):
+        if scan_store is None:
+            raise ValueError("scan report store is unavailable")
+        job = scan_store.job(audit_id)
+        if (job["status"] not in {"completed", "completed_with_limitations"} or
+                not job.get("report_sha256") or job.get("spec", {}).get("audit_mode") == "static_only"):
+            raise ValueError("AI quick screen requires a completed intelligent audit")
+        report = service.read_report(settings, job)
+        policy_record = store.get()["policy"]
+        policy_sha = store.get()["policy_sha256"]
+        try:
+            existing_budget = BudgetLedger(settings.data_dir).summary(audit_id)
+        except KeyError:
+            existing_budget = None
+        if existing_budget:
+            policy_record = existing_budget["policy_snapshot"]
+            policy_sha = existing_budget["policy_sha256"]
+            binding = BudgetLedger(settings.data_dir).task_binding(audit_id)
+            if (not isinstance(binding, dict) or
+                    sorted(binding.get("selected_group_ids", [])) != sorted(set(group_ids)) or
+                    binding.get("consent_nonce") != consent_nonce):
+                raise ValueError("this audit already has an immutable quick-screen authorization for a different group set")
+        policy = policy_record
+        limit = policy["limits"].get("quick_screen_limit", 0)
+        ids = sorted(set(group_ids))
+        if len(ids) != len(group_ids) or len(ids) > limit:
+            raise ValueError("selected groups exceed the current task quick-screen policy")
+        inventory = {item.get("file"): item for item in
+                     report.get("_workbench", {}).get("source_inventory", [])
+                     if isinstance(item, dict) and isinstance(item.get("file"), str)}
+        findings = []
+        for item in service.findings(report):
+            source = inventory.get(item.get("file"), {})
+            findings.append({**item, "candidate_id": item.get("id"),
+                "repository": report.get("repository"), "commit": report.get("commit"),
+                "report_sha256": job["report_sha256"],
+                "source_binding_verified": bool(item.get("source_sha256") and
+                    source.get("sha256") == item.get("source_sha256") and report.get("commit")),
+                "coverage_unknown": item.get("coverage_status") in {"partial", "blocked", "not_analyzed"},
+                "has_entry_or_sink_evidence": bool(item.get("evidence_obligations"))})
+        manifest = build_groups(findings)
+        ranking = select_groups(rank_groups(manifest["groups"]), limit,
+                                policy["family_quotas"])
+        by_id = {group["group_id"]: group for group in ranking if group["selected"]}
+        if any(group_id not in by_id for group_id in ids):
+            raise ValueError("one or more groups are not selected by the local evidence ranking")
+        from ..agent import ProviderConfig, _prepare_candidate_context, REDACTION_POLICY_VERSION
+        provider = ProviderConfig.from_env(settings.data_dir)
+        if not provider.configured:
+            raise ValueError("LLM Provider is not configured")
+        items = []
+        for group_id in ids:
+            group = by_id[group_id]
+            finding = group["finding"]
+            prepared = _prepare_candidate_context(settings, scan_store, job, report, finding)
+            context = prepared["initial_context"]
+            excerpt = context["source_excerpt"]
+            evidence = {"evidence_id": prepared["initial_evidence_id"],
+                "repository": report["repository"], "commit": report["commit"],
+                "report_sha256": job["report_sha256"], "file": finding["file"],
+                "source_sha256": prepared["source"]["sha256"], "excerpt": excerpt,
+                "excerpt_sha256": hashlib.sha256(excerpt.encode("utf-8")).hexdigest(),
+                "source_binding_verified": True, "redaction_applied": True,
+                "redaction_policy_version": REDACTION_POLICY_VERSION,
+                "start_line": context["source_excerpt_start_line"],
+                "end_line": context["source_excerpt_end_line"]}
+            items.append({"group_id": group_id, "member_candidate_ids": group["member_candidate_ids"],
+                "candidate_summary": {"rule_id": finding.get("rule_id"), "cwe": finding.get("cwe"),
+                    "severity": finding.get("severity"),
+                    "evidence_obligations": finding.get("evidence_obligations", [])},
+                "evidence": [evidence], "source_excerpt_for_review": excerpt,
+                "source_file": finding["file"],
+                "source_lines": [evidence["start_line"], evidence["end_line"]]})
+        binding = {"audit_id": audit_id, "repository": report["repository"],
+            "commit": report["commit"], "report_sha256": job["report_sha256"],
+            "provider_fingerprint": provider.fingerprint, "model": provider.model,
+            "policy_sha256": policy_sha, "redaction_policy_version": REDACTION_POLICY_VERSION,
+            "consent_nonce": consent_nonce, "selected_group_ids": ids,
+            "selected_candidate_ids": [item["member_candidate_ids"] for item in items],
+            "evidence_manifest": [{"group_id": item["group_id"],
+                "evidence_id": item["evidence"][0]["evidence_id"], "file": item["source_file"],
+                "source_sha256": item["evidence"][0]["source_sha256"],
+                "excerpt_sha256": item["evidence"][0]["excerpt_sha256"]} for item in items],
+            "limits": {**policy_record["limits"], "max_output_tokens_per_quick_screen": 512,
+                       "max_retries": 0, "tools": []}, "cost_hard_cap": False}
+        preview = {**binding, "policy_snapshot": policy_record, "items": items,
+            "source_disclosure": "The listed redacted excerpts will be sent once per selected group; no tools or full repository upload.",
+            "cost_notice": "USD policy is an estimate. Provider-side hard spend cap is not verified.",
+            "candidate_state_effect": "none"}
+        digest = hashlib.sha256(json.dumps(preview, ensure_ascii=False, sort_keys=True,
+            separators=(",", ":")).encode("utf-8")).hexdigest()
+        authorization = {"audit_mode": "intelligent", "authorized": True,
+            "consent_sha256": digest, "repository": report["repository"], "commit": report["commit"],
+            "report_sha256": job["report_sha256"], "provider_fingerprint": provider.fingerprint,
+            "model": provider.model, "redaction_policy_version": REDACTION_POLICY_VERSION}
+        return {"preview": preview, "preview_sha256": digest, "authorization": authorization}
+
+    @app.post("/api/v1/audits/{audit_id}/quick-screen/preview")
+    def quick_screen_preview(audit_id: str, body: QuickScreenPreviewInput):
+        value = _quick_screen_preview(audit_id, body.group_ids, body.consent_nonce)
+        return {"preview": value["preview"], "preview_sha256": value["preview_sha256"]}
+
+    @app.post("/api/v1/audits/{audit_id}/quick-screen/start", status_code=202)
+    def quick_screen_start(audit_id: str, body: QuickScreenStartInput):
+        value = _quick_screen_preview(audit_id, body.group_ids, body.consent_nonce)
+        if value["preview_sha256"] != body.expected_preview_sha256:
+            raise ValueError("quick-screen preview changed; review the new source/provider/policy binding")
+        from ..operations_store import Operations
+        ops = Operations(scan_store)
+        auth = value["authorization"]
+        binding = {**auth, "policy_sha256": value["preview"]["policy_sha256"],
+                   "selected_group_ids": value["preview"]["selected_group_ids"],
+                   "consent_nonce": value["preview"]["consent_nonce"]}
+        ledger = BudgetLedger(settings.data_dir)
+        ledger.create_task(audit_id, value["preview"]["policy_snapshot"], consent_binding=binding)
+        operation_ids = []
+        for item in value["preview"]["items"]:
+            spec = {"audit_id": audit_id, "group_id": item["group_id"],
+                "report_sha256": auth["report_sha256"], "authorization": auth,
+                "policy_snapshot": value["preview"]["policy_snapshot"],
+                "evidence": item["evidence"], "candidate_summary": item["candidate_summary"],
+                "idempotency_key": auth["consent_sha256"] + ":" + item["group_id"],
+                "timeout_seconds": 90}
+            operation_ids.append(ops.create("progressive_quick_screen", spec)["id"])
+        scan_store.event(audit_id, "progressive_quick_screen_queued",
+            f"Authorized quick-screen operations queued: {len(operation_ids)}; candidates remain unconfirmed")
+        return {"audit_id": audit_id, "preview_sha256": value["preview_sha256"],
+                "operation_ids": operation_ids, "status": "queued", "budget": ledger.summary(audit_id)}
+
+    def _deep_investigation_preview(audit_id, group_id, consent_nonce):
+        if scan_store is None:
+            raise ValueError("scan report store is unavailable")
+        ledger = BudgetLedger(settings.data_dir)
+        budget = ledger.summary(audit_id)
+        task_binding = ledger.task_binding(audit_id)
+        if (task_binding.get("audit_mode") != "intelligent" or
+                task_binding.get("report_sha256") is None):
+            raise ValueError("deep investigation requires the task's explicit intelligent-audit consent")
+        job = scan_store.job(audit_id)
+        if (job["status"] not in {"completed", "completed_with_limitations"} or
+                job.get("report_sha256") != task_binding.get("report_sha256") or
+                job.get("spec", {}).get("audit_mode") == "static_only"):
+            raise ValueError("deep investigation fixed report is no longer available")
+        quick_result = ledger.quick_results(audit_id).get(group_id)
+        if (not quick_result or quick_result["result"].get("quick_status") != "completed" or
+                quick_result["result"].get("quick_assessment") != "investigate"):
+            raise ValueError("L3 is available only after a completed L2 investigate recommendation")
+        if budget["deep_groups_attempted"] >= budget["policy_snapshot"]["limits"]["deep_investigation_limit"]:
+            raise ValueError("task deep-investigation group budget is exhausted")
+        report = service.read_report(settings, job)
+        inventory = {item.get("file"): item for item in
+                     report.get("_workbench", {}).get("source_inventory", [])
+                     if isinstance(item, dict) and isinstance(item.get("file"), str)}
+        findings = []
+        for item in service.findings(report):
+            source = inventory.get(item.get("file"), {})
+            findings.append({**item, "candidate_id": item.get("id"),
+                "repository": report.get("repository"), "commit": report.get("commit"),
+                "report_sha256": job["report_sha256"],
+                "source_binding_verified": bool(item.get("source_sha256") and
+                    source.get("sha256") == item.get("source_sha256") and report.get("commit")),
+                "coverage_unknown": item.get("coverage_status") in {"partial", "blocked", "not_analyzed"},
+                "has_entry_or_sink_evidence": bool(item.get("evidence_obligations"))})
+        manifest = build_groups(findings)
+        group = next((row for row in manifest["groups"] if row["group_id"] == group_id), None)
+        if not group:
+            raise ValueError("group is absent from the fixed report")
+        candidate = group["finding"]
+        from .. import agent
+        provider = agent.ProviderConfig.from_env(settings.data_dir)
+        if not provider.configured or provider.fingerprint != task_binding.get("provider_fingerprint"):
+            raise ValueError("Provider/model differs from the task's reviewed L2 consent")
+        policy = budget["policy_snapshot"]
+        limits = policy["limits"]
+        per_group_input = max(1000, min(36000, limits["max_input_tokens"] //
+                                        max(1, limits["deep_investigation_limit"])))
+        per_group_output = max(256, min(5200, limits["max_output_tokens"] //
+                                        max(1, limits["deep_investigation_limit"])))
+        agent_spec = {"mode": "tool_agent", "max_steps": limits["max_tool_steps_per_deep_group"],
+            "max_output_tokens": min(1000, per_group_output),
+            "max_total_input_tokens": per_group_input,
+            "max_total_output_tokens": per_group_output,
+            "timeout_seconds": min(240, limits["max_ai_duration_seconds"]),
+            "max_provider_retries": 1, "consent_nonce": consent_nonce,
+            "r1_operation_id": None}
+        prepared = agent._prepare_candidate_context(settings, scan_store, job, report, candidate)
+        consent = agent.consent_preview(settings, scan_store, job, report, candidate,
+                                        agent_spec, provider, prepared=prepared)
+        if not consent["agent_execution"]["eligible"]:
+            raise ValueError(consent["agent_execution"]["reason"])
+        deep_budget = consent["budgets"]
+        possible_calls = ((deep_budget["max_steps"] + 1 + agent.MAX_VALIDATION_REPAIRS) *
+                          (1 + deep_budget["max_provider_retries"]))
+        preview = {"audit_id": audit_id, "group_id": group_id,
+            "candidate_id": candidate["id"], "report_sha256": job["report_sha256"],
+            "policy_sha256": budget["policy_sha256"], "policy_snapshot": policy,
+            "quick_result_sha256": quick_result["result_sha256"],
+            "quick_assessment": "investigate", "provider": consent["provider"],
+            "consent": consent, "agent_spec": agent_spec,
+            "aggregate_budget_reservation": {"max_model_calls": possible_calls,
+                "max_input_tokens": agent_spec["max_total_input_tokens"],
+                "max_output_tokens": agent_spec["max_total_output_tokens"],
+                "max_tool_steps": agent_spec["max_steps"]},
+            "scope_notice": "现有固定 Commit 只读 Agent；包含所列初始源码、报告义务、固定仓库清单内受限符号/调用者/守卫读取、Skeptic/结构校验（如现有流程触发）。不开放 Shell、任意 URL、仓库外路径或写操作。",
+            "candidate_effect": "模型结论仅是固定源码范围内的待复核意见；候选仍保留，validated_vulnerability 不变。"}
+        digest = hashlib.sha256(json.dumps(preview, ensure_ascii=False, sort_keys=True,
+            separators=(",", ":")).encode("utf-8")).hexdigest()
+        preview["preview_sha256"] = digest
+        return {"preview": preview, "preview_sha256": digest, "consent": consent,
+                "candidate": candidate, "provider": provider, "agent_spec": agent_spec,
+                "possible_calls": possible_calls, "quick_result": quick_result}
+
+    @app.post("/api/v1/audits/{audit_id}/deep-investigation/preview")
+    def deep_investigation_preview(audit_id: str, body: DeepInvestigationPreviewInput):
+        value = _deep_investigation_preview(audit_id, body.group_id, body.consent_nonce)
+        return {"preview": value["preview"], "preview_sha256": value["preview_sha256"]}
+
+    @app.post("/api/v1/audits/{audit_id}/deep-investigation/start", status_code=202)
+    def deep_investigation_start(audit_id: str, body: DeepInvestigationStartInput):
+        value = _deep_investigation_preview(audit_id, body.group_id, body.consent_nonce)
+        if value["preview_sha256"] != body.expected_preview_sha256:
+            raise ValueError("deep-investigation preview changed; review source, tools, provider and budget again")
+        from ..operations_store import Operations
+        ops = Operations(scan_store)
+        agent_spec, consent, candidate = value["agent_spec"], value["consent"], value["candidate"]
+        job = scan_store.job(audit_id)
+        report = service.read_report(settings, job)
+        ledger = BudgetLedger(settings.data_dir)
+        ledger.add_task_consent(audit_id, {"consent_sha256": consent["consent_sha256"],
+            "scope": "existing bounded read-only tool Agent", "group_id": body.group_id,
+            "candidate_id": candidate["id"], "preview_sha256": value["preview_sha256"]})
+        auth = {"job_id": audit_id, "candidate_id": candidate["id"],
+            "case_id": None, "experiment_id": None, **agent_spec,
+            "source_submission_approved": True,
+            "source_consent_sha256": consent["consent_sha256"],
+            "consent_preview_version": consent["consent_preview_version"],
+            "redaction_policy_version": consent["redaction_policy_version"],
+            "provider": value["provider"].provider, "provider_model": value["provider"].model,
+            "provider_host": value["provider"].endpoint_host,
+            "provider_fingerprint": value["provider"].fingerprint,
+            "prompt_version": consent["prompt_version"],
+            "tool_policy_version": consent["tool_policy_version"],
+            "candidate_source_sha256": consent["binding"]["source_sha256"],
+            "source_commit": report["commit"], "report_sha256": job["report_sha256"],
+            "progressive_task_id": audit_id, "progressive_group_id": body.group_id,
+            "progressive_reservation_calls": value["possible_calls"],
+            "progressive_reservation_input": agent_spec["max_total_input_tokens"],
+            "progressive_reservation_output": agent_spec["max_total_output_tokens"],
+            "quick_result_sha256": value["quick_result"]["result_sha256"],
+            "source_submission_approved_at": datetime.now(timezone.utc).isoformat(),
+            "idempotency_key": consent["consent_sha256"]}
+        reservation = ledger.reserve(audit_id, stage="deep_agent", group_id=body.group_id,
+            idempotency_key="deep:" + consent["consent_sha256"],
+            input_tokens=agent_spec["max_total_input_tokens"],
+            output_tokens=agent_spec["max_total_output_tokens"], calls=value["possible_calls"],
+            cost_upper_estimate_usd=(consent.get("budget_cost_estimate") or {}).get("maximum_usd"))
+        if not reservation.get("reserved"):
+            raise ValueError("deep-investigation budget reservation failed: " +
+                             str(reservation.get("stop_reason", "budget_exhausted")))
+        auth["progressive_reservation_id"] = reservation["reservation_id"]
+        try:
+            operation = ops.create("agent_investigation", auth)
+        except Exception:
+            ledger.settle(audit_id, reservation["reservation_id"], outcome="failed_before_dispatch")
+            raise
+        return {"audit_id": audit_id, "group_id": body.group_id,
+            "operation_id": operation["id"], "status": "queued",
+            "preview_sha256": value["preview_sha256"], "budget": ledger.summary(audit_id)}
+
+    @app.get("/api/v1/audits/{audit_id}/ai-usage")
+    def triage_usage(audit_id: str):
+        ledger = BudgetLedger(settings.data_dir)
+        try:
+            return ledger.summary(audit_id)
+        except KeyError:
+            return {"task_id": audit_id, "status": "not_started",
+                    "stop_reason": None, "model_calls": 0, "cost_hard_cap": False,
+                    "worker_enforcement": "not_connected"}
+
+    app.include_router(router)
+    return store
diff --git a/src/workbench/progressive_triage/contracts.py b/src/workbench/progressive_triage/contracts.py
new file mode 100755
index 00000000..23dc2063
--- /dev/null
+++ b/src/workbench/progressive_triage/contracts.py
@@ -0,0 +1,78 @@
+"""Versioned, strictly validated policy contract for progressive audit triage."""
+from decimal import Decimal, InvalidOperation
+import hashlib
+import json
+
+POLICY_VERSION = "progressive-triage-v1"
+PRESETS = {
+    "economy": {"quick_screen_limit": 10, "deep_investigation_limit": 2,
+        "max_tool_steps_per_deep_group": 6, "max_model_concurrency": 1,
+        "max_ai_duration_seconds": 900, "max_input_tokens": 100000,
+        "max_output_tokens": 25000, "max_model_calls": 40, "max_cost_usd": "5.00"},
+    "standard": {"quick_screen_limit": 30, "deep_investigation_limit": 6,
+        "max_tool_steps_per_deep_group": 8, "max_model_concurrency": 2,
+        "max_ai_duration_seconds": 1800, "max_input_tokens": 400000,
+        "max_output_tokens": 100000, "max_model_calls": 120, "max_cost_usd": "25.00"},
+    "deep": {"quick_screen_limit": 100, "deep_investigation_limit": 20,
+        "max_tool_steps_per_deep_group": 12, "max_model_concurrency": 3,
+        "max_ai_duration_seconds": 5400, "max_input_tokens": 1200000,
+        "max_output_tokens": 300000, "max_model_calls": 400, "max_cost_usd": "100.00"},
+}
+_BOUNDS = {
+    "quick_screen_limit": (1, 1000), "deep_investigation_limit": (0, 200),
+    "max_tool_steps_per_deep_group": (1, 32), "max_model_concurrency": (1, 8),
+    "max_ai_duration_seconds": (60, 14400), "max_input_tokens": (1000, 5000000),
+    "max_output_tokens": (256, 1000000), "max_model_calls": (1, 10000),
+}
+
+
+def _canonical(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def policy_hash(value):
+    return hashlib.sha256(_canonical(value).encode("utf-8")).hexdigest()
+
+
+def resolve_policy(value=None, *, admin_limits=None):
+    value = value or {"profile": "standard"}
+    if not isinstance(value, dict) or set(value) - {"profile", "limits", "family_quotas"}:
+        raise ValueError("policy must contain only profile, limits and family_quotas")
+    profile = value.get("profile", "standard")
+    if profile not in {*PRESETS, "custom", "static"}:
+        raise ValueError("unsupported policy profile")
+    limits = {} if profile == "static" else dict(PRESETS.get(profile, PRESETS["standard"]))
+    supplied = value.get("limits", {})
+    if not isinstance(supplied, dict) or set(supplied) - (set(_BOUNDS) | {"max_cost_usd"}):
+        raise ValueError("unsupported policy limit")
+    if profile == "custom" and set(supplied) != set(_BOUNDS) | {"max_cost_usd"}:
+        raise ValueError("custom policy must specify every limit")
+    limits.update(supplied)
+    if profile != "static":
+        for key, (low, high) in _BOUNDS.items():
+            number = limits.get(key)
+            if isinstance(number, bool) or not isinstance(number, int) or not low <= number <= high:
+                raise ValueError(f"{key} must be an integer from {low} to {high}")
+        try:
+            cost = Decimal(str(limits["max_cost_usd"]))
+        except (InvalidOperation, KeyError):
+            raise ValueError("max_cost_usd must be a finite nonnegative decimal") from None
+        if not cost.is_finite() or cost < 0 or cost > Decimal("1000000"):
+            raise ValueError("max_cost_usd must be between 0 and 1000000")
+        limits["max_cost_usd"] = format(cost.quantize(Decimal("0.01")), "f")
+        if limits["deep_investigation_limit"] > limits["quick_screen_limit"]:
+            raise ValueError("deep investigation limit cannot exceed quick-screen limit")
+        if limits["max_model_calls"] < limits["quick_screen_limit"]:
+            raise ValueError("model call limit cannot be lower than quick-screen group limit")
+        for key, maximum in (admin_limits or {}).items():
+            if key in limits and isinstance(limits[key], int) and limits[key] > maximum:
+                raise ValueError(f"{key} exceeds the administrator limit")
+            if key == "max_cost_usd" and Decimal(limits[key]) > Decimal(str(maximum)):
+                raise ValueError("max_cost_usd exceeds the administrator limit")
+    quotas = value.get("family_quotas", profile in {"standard", "deep"})
+    if not isinstance(quotas, bool):
+        raise ValueError("family_quotas must be a boolean")
+    return {"policy_version": POLICY_VERSION, "profile": profile,
+            "limits": limits, "family_quotas": quotas,
+            "preserve_unreviewed_candidates": True,
+            "cost_enforcement": "provider_cap_required_for_hard_cap"}
diff --git a/src/workbench/progressive_triage/grouping.py b/src/workbench/progressive_triage/grouping.py
new file mode 100755
index 00000000..bd3d40bd
--- /dev/null
+++ b/src/workbench/progressive_triage/grouping.py
@@ -0,0 +1,74 @@
+"""Conservative, reversible grouping of exact observations and root-cause hints."""
+import hashlib
+import json
+
+
+def _hash(value):
+    raw = json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
+
+def _strong_key(item):
+    # Require complete immutable source/report identity before deduplicating.
+    fields = ("repository", "commit", "report_sha256", "file", "source_sha256",
+              "detector_id", "rule_id", "candidate_id")
+    if any(not item.get(field) for field in fields):
+        return None
+    return tuple(item[field] for field in fields[:-1]) + (
+        item.get("symbol") or "", item.get("line"), item.get("evidence_fingerprint") or "")
+
+
+def _family(item):
+    detector = str(item.get("detector_id", "")).lower()
+    cwe = str(item.get("cwe", "")).lower()
+    if "ipc" in detector or cwe in {"cwe-285", "cwe-862", "cwe-863"}:
+        return "ipc_authorization"
+    if any(value in detector for value in ("cpp", "memory", "bounds", "lifetime")) or cwe in {
+            "cwe-119", "cwe-120", "cwe-125", "cwe-787", "cwe-416", "cwe-190"}:
+        return "cpp_memory_safety"
+    if any(value in detector for value in ("arkts", "javascript", "typescript")):
+        return "arkts_js"
+    if "log" in detector or cwe in {"cwe-532", "cwe-200"}:
+        return "sensitive_data"
+    if "cve" in detector:
+        return "disclosed_vulnerability"
+    return "other"
+
+
+def build_groups(findings):
+    """Return immutable manifest and groups; uncertain correlations remain separate."""
+    items = [dict(item) for item in findings]
+    if len(items) > 10000:
+        raise ValueError("candidate count exceeds progressive triage limit of 10000")
+    items.sort(key=lambda x: str(x.get("candidate_id", "")))
+    seen, unique = {}, []
+    duplicate_map = {}
+    for item in items:
+        key = _strong_key(item)
+        if key is not None and key in seen:
+            duplicate_map.setdefault(seen[key], []).append(item.get("candidate_id"))
+            continue
+        if key is not None:
+            seen[key] = item.get("candidate_id")
+        unique.append(item)
+    groups = []
+    for item in unique:
+        cid = item.get("candidate_id")
+        members = [cid, *duplicate_map.get(cid, [])]
+        identity = {"repository": item.get("repository"), "commit": item.get("commit"),
+                    "report_sha256": item.get("report_sha256"), "members": sorted(members)}
+        gid = _hash(identity)[:32]
+        source_verified = bool(item.get("source_binding_verified") is True
+                               and item.get("source_sha256") and item.get("commit"))
+        groups.append({"group_id": gid, "member_candidate_ids": sorted(members),
+            "representative_candidate_id": cid, "family_bucket": _family(item),
+            "grouping_basis": "exact_source_observation" if len(members) > 1 else "single_candidate",
+            "grouping_confidence": "strong_identity" if len(members) > 1 else "unclustered",
+            "coverage_unknown": bool(item.get("coverage_unknown") or item.get("parse_status") in
+                {"partial", "blocked", "not_analyzed", "unknown"} or not source_verified),
+            "source_binding_verified": source_verified, "finding": item})
+    manifest = {"schema": "triage-group-manifest-v1", "groups": groups,
+                "raw_candidate_count": len(items), "unique_observation_count": len(groups),
+                "unreviewed_candidates_preserved": True}
+    manifest["manifest_sha256"] = _hash(manifest)
+    return manifest
