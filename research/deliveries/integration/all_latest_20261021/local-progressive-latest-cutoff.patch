+                "cost_estimate_status_counts": {}, "cost_estimate_aggregates": {},
+                "wall_seconds": [], "child_execution_seconds": [], "process_peak_rss_bytes": [],
+                "wall_unknown": 0, "child_wall_unknown": 0, "rss_unknown": 0,
