+def create_app(settings=None):
+    settings = settings or Settings.from_env()
+    settings.initialize()
+    store = Store(settings.data_dir)
+    app = FastAPI(title="OHScanner Local Audit Workbench", version="0.1.0")
+    app.state.store = store
