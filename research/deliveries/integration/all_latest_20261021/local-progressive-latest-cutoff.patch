+            elif kind == "progressive_quick_screen" and spec.get("idempotency_key"):
+                prior = db.execute("SELECT id FROM operations WHERE kind=? ORDER BY created_at DESC",
+                                   (kind,)).fetchall()
+                for row in prior:
+                    existing = db.execute("SELECT * FROM operations WHERE id=?", (row[0],)).fetchone()
+                    if json.loads(existing["spec"]).get("idempotency_key") == spec["idempotency_key"]:
+                        return self.row(existing)
