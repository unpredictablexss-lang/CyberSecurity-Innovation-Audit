+export async function apiPut(path: string, body: unknown): Promise<any> {
+  const r = await fetch("/api/v1" + path, {
+    method: "PUT",
+    headers: { "Content-Type": "application/json", "X-OHScanner-Client": "workbench-v1" },
+    body: JSON.stringify(body),
+  });
+  if (!r.ok) {
+    const e = await r.json().catch(() => ({ detail: r.statusText }));
+    throw new Error(typeof e.detail === "string" ? e.detail : JSON.stringify(e.detail));
+  }
+  return r.json();
+}
