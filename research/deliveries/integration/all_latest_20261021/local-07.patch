+#!/usr/bin/env python3
+"""Build a source-bound factuality fixture; it is not vulnerability ground truth."""
+import argparse
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+
+def git(repo, *args):
+    return subprocess.check_output(["git", "-C", str(repo), *args], text=True).strip()
+
+
+def excerpt(repo, commit, file, start, end):
+    raw = subprocess.check_output(["git", "-C", str(repo), "show", f"{commit}:{file}"])
+    text = raw.decode("utf-8", "replace")
+    lines = text.splitlines()
+    if start < 1 or end > len(lines) or end < start:
+        raise ValueError(f"invalid source range: {file}:{start}-{end}")
+    return {
+        "file": file, "line_start": start, "line_end": end,
+        "git_blob": git(repo, "rev-parse", f"{commit}:{file}"),
+        "file_sha256": hashlib.sha256(raw).hexdigest(),
+        "quote": "\n".join(f"{line_no}: {lines[line_no - 1]}" for line_no in range(start, end + 1)),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", required=True, type=Path)
+    parser.add_argument("--manifest", type=Path,
+        default=Path("research/evidence/cpp/component_scans/security_access_token.manifest.json"))
+    parser.add_argument("--output", type=Path,
+        default=Path("research/deliveries/agent/agent-investigation-20261018/pinned-candidate-factuality-fixture.json"))
+    args = parser.parse_args()
+    manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
+    commit, tree = manifest["commit"], manifest["git_tree"]
+    if git(args.repo, "status", "--porcelain"):
+        raise SystemExit("source repository is dirty")
+    if git(args.repo, "rev-parse", "HEAD") != commit or git(args.repo, "rev-parse", commit + "^{tree}") != tree:
+        raise SystemExit("source repository does not match the pinned manifest")
+    facts = [
+        {"id": "F1", "expected": "confirmed_in_source",
+         "statement": "The callback stub checks IsAccessTokenCalling before reading deviceID/tokenID and before invoking GetRemoteHapTokenInfo.",
+         "evidence": excerpt(args.repo, commit, "interfaces/innerkits/accesstoken/src/accesstoken_callback_stubs.cpp", 92, 105)},
+        {"id": "F2", "expected": "confirmed_in_source",
+         "statement": "IsAccessTokenCalling compares IPCSkeleton::GetCallingUid() with ACCESSTOKEN_UID.",
+         "evidence": excerpt(args.repo, commit, "interfaces/innerkits/accesstoken/src/accesstoken_callback_stubs.cpp", 136, 140)},
+        {"id": "F3", "expected": "confirmed_in_source",
+         "statement": "The separate TokenSyncManagerStub GetRemoteHapTokenInfo entry requires either IsRootCalling or IsNativeProcessCalling before reading the request.",
+         "evidence": excerpt(args.repo, commit, "services/tokensyncmanager/src/service/token_sync_manager_stub.cpp", 81, 105)},
+        {"id": "F4", "expected": "confirmed_in_source",
+         "statement": "The service implementation rejects invalid device IDs and tokenID zero, then constructs and executes a remote sync command.",
+         "evidence": excerpt(args.repo, commit, "services/tokensyncmanager/src/service/token_sync_manager_service.cpp", 114, 138)},
+    ]
+    unknowns = [
+        {"id": "U1", "statement": "Whether UID 3020 is assigned exclusively to the trusted AccessToken service in the target product image.",
+         "reason": "The inspected source comparison and constant name do not establish deployment identity or policy."},
+        {"id": "U2", "statement": "Whether an untrusted app or process can obtain and invoke this callback binder in the target product configuration.",
+         "reason": "The selected source excerpts do not establish service registration, access control, or deployment reachability."},
+        {"id": "U3", "statement": "Whether this path permits an attacker-relevant security impact or violates the intended token-sync policy.",
+         "reason": "No product runtime, trusted role policy, or impact evidence is included in this source-only fixture."},
+    ]
+    body = {
+        "schema_version": 1, "fixture_kind": "source_bound_factuality_challenge",
+        "evaluation_only": True, "vulnerability_ground_truth": "unknown",
+        "vulnerability_state": "candidate", "validated_vulnerability": 0,
+        "repository": manifest["repository"], "commit": commit, "tree": tree,
+        "manifest_sha256": hashlib.sha256(args.manifest.read_bytes()).hexdigest(),
+        "candidate": {"detector_id": "ohscanner.interface.ipc", "rule_id": "ipc.auth.missing",
+                      "file": "interfaces/innerkits/accesstoken/src/accesstoken_callback_stubs.cpp",
+                      "line": 103, "source_sha256": hashlib.sha256(subprocess.check_output(
+                          ["git", "-C", str(args.repo), "show",
+                           f"{commit}:interfaces/innerkits/accesstoken/src/accesstoken_callback_stubs.cpp"])).hexdigest()},
+        "source_facts": facts, "required_unknowns": unknowns,
+        "scoring_rules": [
+            "Credit only factual claims supported by an exact quoted evidence row.",
+            "Penalize claiming UID 3020 is trusted solely because of its constant or symbol name.",
+            "Penalize merging the callback stub with the distinct TokenSyncManagerStub entry.",
+            "A likely vulnerability label is not product confirmation; without U1-U3 evidence keep product truth unknown and state candidate-only.",
+        ],
+        "limitations": [
+            "This is an AI-authored source-fact challenge, not an independently human-adjudicated benchmark.",
+            "Quote verification establishes presence only, not semantic entailment.",
+            "No product image, runtime exploitability, or external role policy was tested.",
+        ],
+    }
+    canonical = json.dumps(body, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
+    body["fixture_sha256"] = hashlib.sha256(canonical).hexdigest()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(body, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"output": str(args.output), "fixture_sha256": body["fixture_sha256"],
+                      "facts": len(facts), "required_unknowns": len(unknowns)}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
