+            "assessment": "needs_more_evidence",
+            "supported_claims": [],
+            "obligation_reviews": _unresolved_obligation_reviews(payload),
+            "unsupported_claims": ["A static fixture does not prove a product vulnerability."],
+            "unknowns": ["Product reachability", "Attacker control", "CIA impact"],
+            "next_steps": ["Human review of the fixed source and product path"],
+        }
+        return {"status": "completed", "output": [{"type": "message", "content": [
+            {"type": "output_text", "text": json.dumps(final)}]}],
+            "usage": {"input_tokens": 100, "output_tokens": 80, "total_tokens": 180}}
+
+
+def _unresolved_obligation_reviews(payload):
+    for item in payload.get("input", []):
+        if item.get("role") != "user":
+            continue
+        for content in item.get("content", []):
+            if content.get("type") != "input_text":
+                continue
+            try:
+                context = json.loads(content.get("text", "{}"))
+            except (TypeError, json.JSONDecodeError):
+                continue
+            obligations = context.get("evidence_obligations", [])
+            return [{"obligation_index": index, "disposition": "unresolved", "citations": []}
+                    for index, _ in enumerate(obligations)]
+    return []
+
+
+def git(repo, *args):
+    return subprocess.check_output(["git", "-C", str(repo), *args], text=True).strip()
+
+
+def main():
+    root = Path(tempfile.mkdtemp(prefix="ohscanner-agent-blind-pair-"))
+    try:
+        repo = root / "repo"
+        repo.mkdir()
+        fixture = Path(__file__).resolve().parents[4] / "tests/detectors/fixtures/cpp_unsafe_calls/positive_unsafe.cpp"
+        shutil.copyfile(fixture, repo / "positive_unsafe.cpp")
+        subprocess.run(["git", "init", "-q", str(repo)], check=True)
+        git(repo, "config", "user.name", "OHScanner controlled test")
+        git(repo, "config", "user.email", "ohscanner-test@example.invalid")
+        git(repo, "add", "positive_unsafe.cpp")
+        git(repo, "commit", "-qm", "synthetic fixture only")
+        commit = git(repo, "rev-parse", "HEAD")
+        registry = build_registry(("ohscanner.cpp.unsafe_memory_call",))
+        report = run_reviewed_detectors(repo, "controlled/unsafe-calls", commit,
+                                        ("positive_unsafe.cpp",), registry)
+        assert report["diagnostic_count"] >= 5, report["diagnostic_count"]
+        blob = git(repo, "rev-parse", commit + ":positive_unsafe.cpp")
+        source_bytes = (repo / "positive_unsafe.cpp").read_bytes()
+        report["_workbench"] = {"source_inventory": [{"file": "positive_unsafe.cpp", "blob": blob,
+            "sha256": hashlib.sha256(source_bytes).hexdigest()}]}
+
+        settings = Settings(root / "data", (root,))
+        app = create_app(settings)
+        store = app.state.store
+        repo_row = store.add_repository("controlled/unsafe-calls", str(repo))
+        job_id = "a" * 32
+        spec = {"commit": commit, "git_tree": report["git_tree"],
+                "include_paths": ["positive_unsafe.cpp"]}
+        report_bytes = (json.dumps(report, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
+        artifact = service.artifact_dir(settings, job_id)
+        artifact.mkdir(parents=True)
+        (artifact / "report.json").write_bytes(report_bytes)
+        with store.connect() as db:
+            db.execute("INSERT INTO jobs(id,repository_id,spec,status,stage,created_at,report_sha256) "
+                       "VALUES(?,?,?,?,?,?,?)", (job_id, repo_row["id"], json.dumps(spec), "completed",
+                       "complete", "2026-10-18T00:00:00Z", hashlib.sha256(report_bytes).hexdigest()))
+        job = store.job(job_id)
+        candidate = service.findings(report)[0]
+        source = {"sha256": candidate["source_sha256"], "blob": blob,
+                  "text": (repo / "positive_unsafe.cpp").read_text()}
+        ops = Operations(store)
+        experiment_id = "synthetic-blind-pair"
+        headers = {"x-ohscanner-client": "workbench-v1"}
+        env = {"OHSCANNER_LLM_MODEL": "synthetic-fake-only",
+               "OHSCANNER_LLM_API_KEY": "synthetic-not-a-secret"}
+        operation_ids = []
+        fake_calls = {"single_shot": 0, "tool_agent": 0}
+
+        with patch.dict(os.environ, env, clear=False), TestClient(app) as client, \
+             patch.object(api_service, "read_report", return_value=report), \
+             patch.object(api_service, "finding", return_value=candidate), \
+             patch.object(api_service, "source", return_value=source), \
+             patch.object(agent.service, "read_report", return_value=report), \
+             patch.object(agent.service, "finding", return_value=candidate), \
+             patch.object(agent.service, "source", return_value=source):
+            baseline = client.post("/api/v1/agent/baseline-reviews", headers=headers, json={
+                "job_id": job_id, "candidate_id": candidate["id"], "experiment_id": experiment_id,
+                "reviewer": "synthetic-workflow-fixture", "disposition": "unknown",
+                "notes": "Synthetic workflow record only; not a human review or truth label."})
+            assert baseline.status_code == 201, baseline.text
+
+            for mode in ("single_shot", "tool_agent"):
+                request = {"job_id": job_id, "candidate_id": candidate["id"],
+                    "experiment_id": experiment_id, "mode": mode, "max_steps": 2,
+                    "max_output_tokens": 256, "max_total_input_tokens": 24000,
+                    "max_total_output_tokens": 512, "timeout_seconds": 90}
+                preview = client.post("/api/v1/operations/agent-investigations/preview",
+                                      headers=headers, json=request)
+                assert preview.status_code == 200, preview.text
+                consent = preview.json()
+                queued = client.post("/api/v1/operations/agent-investigations", headers=headers,
+                    json={**request, "source_submission_approved": True,
+                          "consent_sha256": consent["consent_sha256"]})
+                assert queued.status_code == 201, queued.text
+                task = ops.claim()
+                assert task["id"] == queued.json()["id"]
+                fake = FakeResponses(mode)
+                with patch.object(agent, "ResponsesClient", return_value=fake):
+                    result = operations.execute(settings, store, ops, task)
+                ops.finish(task["id"], result=result)
+                assert result["vulnerability_state"] == "candidate"
+                assert result["validated_vulnerability"] == 0
+                assert result["agent_assessment"]["assessment"] == "needs_more_evidence"
+                operation_ids.append(task["id"])
+                fake_calls[mode] = fake.calls
+
+            blind_review = "not exercised: blind-session API is not in this mainline base"
+
+        print(json.dumps({
+            "evidence_class": "synthetic_scanner_fixture_and_fake_provider_only",
+            "fixture": "positive_unsafe.cpp", "commit": commit,
+            "detector_id": candidate["detector_id"], "candidate_id": candidate["id"],
+            "diagnostic_count": report["diagnostic_count"],
+            "R0": "synthetic workflow fixture; not human baseline",
+            "R1_R2": {mode: {"fake_model_calls": fake_calls[mode],
+                             "assessment": "needs_more_evidence", "vulnerability_state": "candidate",
+                             "validated_vulnerability": 0} for mode in fake_calls},
+            "blind_review": blind_review,
+            "network_provider_calls": 0,
+        }, ensure_ascii=False))
+    finally:
+        shutil.rmtree(root, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
