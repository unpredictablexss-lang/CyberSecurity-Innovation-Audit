+"""Offline real-source wiring smoke for R1/R2; never calls an external provider."""
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import tempfile
+from pathlib import Path
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+from src.ohscanner.detectors.catalog import build_registry, default_detector_ids
+from src.ohscanner.execution import run_reviewed_detectors
+from src.ohscanner.git_source import load_git_sources
+from src.workbench import agent, operations, service
+from src.workbench.api import create_app
+from src.workbench.operations_store import Operations
+from src.workbench.settings import Settings
+
+
+class FakeResponses:
+    def __init__(self, mode, symbol, range_file, range_start_line, followup_symbol="ACCESSTOKEN_UID"):
+        self.mode = mode
+        self.symbol = symbol
+        self.range_file = range_file
+        self.range_start_line = range_start_line
+        self.followup_symbol = followup_symbol
+        self.calls = 0
+        self.queried_symbols = []
+        self.tool_actions = []
+        self.citation_verified = False
+
+    def create(self, payload):
+        self.calls += 1
+        if self.mode == "tool_agent" and self.calls == 1:
+            self.queried_symbols.append(self.symbol)
+            self.tool_actions.append("lookup_symbol_in_fixed_commit")
+            return {"status": "completed", "output": [{"type": "function_call",
+                "name": "lookup_symbol_in_fixed_commit",
+                "arguments": json.dumps({"symbol": self.symbol}),
+                "call_id": "real-source-smoke-call-" + str(self.calls)}],
+                "usage": {"input_tokens": 90, "output_tokens": 20, "total_tokens": 110}}
+        if self.mode == "tool_agent" and self.calls == 2:
+            self.tool_actions.append("read_candidate_enclosing_function")
+            return {"status": "completed", "output": [{"type": "function_call",
+                "name": "read_candidate_enclosing_function", "arguments": "{}",
+                "call_id": "real-source-smoke-call-" + str(self.calls)}],
+                "usage": {"input_tokens": 90, "output_tokens": 20, "total_tokens": 110}}
+        if self.mode == "tool_agent" and self.calls == 3:
+            self.tool_actions.append("read_fixed_source_range")
+            return {"status": "completed", "output": [{"type": "function_call",
+                "name": "read_fixed_source_range",
+                "arguments": json.dumps({"file": self.range_file,
+                    "start_line": self.range_start_line, "line_count": 8}),
+                "call_id": "real-source-smoke-call-" + str(self.calls)}],
+                "usage": {"input_tokens": 90, "output_tokens": 20, "total_tokens": 110}}
+        claims = []
+        final = {"summary": "Offline wiring smoke only; product behavior and impact remain unverified.",
+                 "assessment": "needs_more_evidence", "supported_claims": claims,
+                 "obligation_reviews": _unresolved_obligation_reviews(payload),
+                 "unsupported_claims": ["This scan does not establish a product vulnerability."],
+                 "unknowns": ["reachability", "attacker control", "security impact"],
+                 "next_steps": ["Independent source and product-path review"]}
+        return {"status": "completed", "output": [{"type": "message", "content": [
+            {"type": "output_text", "text": json.dumps(final)}]}],
+            "usage": {"input_tokens": 110, "output_tokens": 80, "total_tokens": 190}}
+
+
+def _unresolved_obligation_reviews(payload):
+    for item in payload.get("input", []):
+        if item.get("role") != "user":
+            continue
+        for content in item.get("content", []):
+            if content.get("type") != "input_text":
+                continue
+            try:
+                context = json.loads(content.get("text", "{}"))
+            except (TypeError, json.JSONDecodeError):
+                continue
+            obligations = context.get("evidence_obligations", [])
+            return [{"obligation_index": index, "disposition": "unresolved", "citations": []}
+                    for index, _ in enumerate(obligations)]
+    return []
+
+
+def git(repo, *args):
+    return subprocess.check_output(["git", "-C", str(repo), *args], text=True).strip()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", required=True, type=Path, help="read-only Git clone at the manifest commit")
+    parser.add_argument("--manifest", type=Path,
+                        default=Path("research/evidence/cpp/component_scans/security_access_token.manifest.json"))
+    parser.add_argument("--output", type=Path,
+                        default=Path("research/deliveries/agent/agent-investigation-20261018/pinned-source-fake-smoke.json"))
+    args = parser.parse_args()
+    manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
+    commit, expected_tree = manifest["commit"], manifest["git_tree"]
+    if git(args.repo, "status", "--porcelain"):
+        raise SystemExit("source repository is dirty; refusing to scan an ambiguous worktree")
+    if git(args.repo, "rev-parse", "HEAD") != commit:
+        raise SystemExit("source HEAD does not match the pinned manifest commit")
+    if git(args.repo, "rev-parse", commit + "^{tree}") != expected_tree:
+        raise SystemExit("source Git tree does not match the pinned manifest")
+    includes = tuple(path for shard in manifest["shards"] for path in shard["paths"])
+    if len(includes) != manifest["counts"]["selected_files"]:
+        raise SystemExit("manifest scope count does not match selected files")
+    report = run_reviewed_detectors(args.repo, manifest["repository"], commit, includes,
+                                    build_registry(default_detector_ids()))
+    actual_commit, actual_tree, sources, _ = load_git_sources(args.repo, commit, includes)
+    if actual_commit != commit or actual_tree != expected_tree:
+        raise SystemExit("source changed during the offline scan")
+    report["_workbench"] = {"source_inventory": [
+        {"file": source.path, "blob": source.oid,
+         "sha256": hashlib.sha256(source.data).hexdigest()} for source in sources]}
+    candidates = service.findings(report)
+    selected = next((item for item in candidates
+                     if item["detector_id"] == "ohscanner.interface.ipc"
+                     and item["file"] == "interfaces/innerkits/accesstoken/src/accesstoken_callback_stubs.cpp"), None)
+    if selected is None:
+        raise SystemExit("pinned scan produced no matching IPC candidate; no Agent operation was queued")
+    candidate_symbol = selected.get("symbol")
+    if not candidate_symbol:
+        raise SystemExit("candidate has no bounded symbol for the R2 text-search smoke")
+    selected_source = next(source for source in sources if source.path == selected["file"])
+    uid_guard_line = next((number for number, line in enumerate(
+        selected_source.data.decode("utf-8", "replace").splitlines(), 1)
+        if "ACCESSTOKEN_UID" in line and "==" in line), None)
+    if uid_guard_line is None:
+        raise SystemExit("pinned source no longer contains the reviewed UID comparison line")
+    range_start_line = max(1, uid_guard_line - 2)
+
+    with tempfile.TemporaryDirectory(prefix="ohscanner-real-source-agent-smoke-") as temp:
+        root = Path(temp)
+        settings = Settings(root / "data", (args.repo.parent,))
+        app = create_app(settings)
+        store = app.state.store
+        repository = store.add_repository(manifest["repository"], str(args.repo))
+        job_id = hashlib.sha256((manifest["repository"] + commit).encode()).hexdigest()[:32]
+        artifact = service.artifact_dir(settings, job_id)
+        artifact.mkdir(parents=True)
+        report_bytes = (json.dumps(report, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
+        (artifact / "report.json").write_bytes(report_bytes)
+        job_spec = {"commit": commit, "git_tree": expected_tree, "include_paths": list(includes)}
+        with store.connect() as db:
+            db.execute("INSERT INTO jobs(id,repository_id,spec,status,stage,created_at,report_sha256) "
+                       "VALUES(?,?,?,?,?,?,?)", (job_id, repository["id"], json.dumps(job_spec),
+                       "completed", "complete", "2026-10-18T00:00:00Z",
+                       hashlib.sha256(report_bytes).hexdigest()))
+        ops = Operations(store)
+        output = {"evidence_class": "real_pinned_product_source_with_fake_provider_only",
+                  "repository": manifest["repository"], "commit": commit, "tree": expected_tree,
+                  "manifest_selected_files": len(includes), "static_status": report["status"],
+                  "ephemeral_job_id": job_id,
+                  "report_sha256": hashlib.sha256(report_bytes).hexdigest(),
+                  "detector_count": report["detector_count"],
+                  "diagnostic_count": report["diagnostic_count"],
+                  "detector_runs": [{"detector": run["tool"], "status": run["status"],
+                                     "diagnostics": run["diagnostic_count"]}
+                                    for run in report["detector_runs"]],
+                  "candidate": {key: selected.get(key) for key in
+                                ("id", "detector_id", "detector_version", "rule_id", "file", "line", "symbol", "source_sha256")},
+                  "validated_vulnerability": 0, "real_r0_human_baseline": False,
+                  "network_provider_calls": 0, "arms": []}
+        env = {"OHSCANNER_LLM_BASE_URL": "https://api.openai.com/v1",
+               "OHSCANNER_LLM_MODEL": "synthetic-fake-only",
+               "OHSCANNER_LLM_API_KEY": "synthetic-not-a-secret",
+               "OHSCANNER_LLM_PROXY_URL": ""}
+        headers = {"x-ohscanner-client": "workbench-v1"}
+        with patch.dict(os.environ, env, clear=False), TestClient(app) as client, \
+             patch.object(agent.service, "read_report", return_value=report), \
+             patch.object(agent.service, "finding", return_value=selected):
+            for mode in ("single_shot", "tool_agent"):
+                request = {"job_id": job_id, "candidate_id": selected["id"], "mode": mode,
+                           "max_steps": 3, "max_output_tokens": 256,
+                           "max_total_input_tokens": 60000, "max_total_output_tokens": 4096,
+                           "timeout_seconds": 90}
+                preview = client.post("/api/v1/operations/agent-investigations/preview",
+                                      headers=headers, json=request)
+                if preview.status_code != 200:
+                    raise SystemExit("real-source consent preview failed: " + preview.text)
+                queued = client.post("/api/v1/operations/agent-investigations", headers=headers,
+                    json={**request, "source_submission_approved": True,
+                          "consent_nonce": preview.json()["consent_nonce"],
+                          "consent_sha256": preview.json()["consent_sha256"]})
+                if queued.status_code != 201:
+                    raise SystemExit("real-source fake-provider operation enqueue failed: " + queued.text)
+                task = ops.claim()
+                fake = FakeResponses(mode, candidate_symbol, selected["file"], range_start_line)
+                with patch.object(agent, "ResponsesClient", return_value=fake):
+                    result = operations.execute(settings, store, ops, task)
+                ops.finish(task["id"], result=result)
+                detail = client.get("/api/v1/operations/" + task["id"], headers=headers).json()
+                if result["validated_vulnerability"] != 0 or result["vulnerability_state"] != "candidate":
+                    raise SystemExit("Agent changed the candidate-only state invariant")
+                evidence_kinds = {result["initial_evidence"]["evidence_id"]: result["initial_evidence"]["evidence_kind"]}
+                evidence_kinds.update({item["evidence_id"]: item["evidence_kind"]
+                                       for item in result["tool_calls"]})
+                cited_evidence_ids = sorted({citation["evidence_id"]
+                    for claim in result["agent_assessment"]["supported_claims"]
+                    for citation in claim["citations"]} | {citation["evidence_id"]
+                    for review in result["agent_assessment"]["obligation_reviews"]
+                    for citation in review["citations"]})
+                citations_source_only = bool(cited_evidence_ids) and all(
+                    evidence_kinds.get(item) == "source_code" for item in cited_evidence_ids)
+                context = result["initial_evidence"]["context"]
+                routing = context.get("evidence_routing", {})
+                source_review_indices = set(routing.get("agent_source_review_indices", []))
+                obligation_reviews = result["agent_assessment"]["obligation_reviews"]
+                non_source_reviews_stayed_unresolved = all(
+                    review["obligation_index"] in source_review_indices
+                    or (review["disposition"] == "unresolved" and not review["citations"])
+                    for review in obligation_reviews)
+                if not non_source_reviews_stayed_unresolved:
+                    raise SystemExit("Agent resolved an obligation outside the source-review route")
+                output["arms"].append({"mode": mode, "fake_model_calls": fake.calls,
+                    "prompt_version": result["prompt_version"],
+                    "consent_preview_version": result["source_submission"]["consent_preview_version"],
+                    "redaction_policy_version": result["source_submission"]["redaction_policy_version"],
+                    "evidence_routing": routing,
+                    "obligation_reviews": obligation_reviews,
+                    "non_source_reviews_stayed_unresolved": non_source_reviews_stayed_unresolved,
+                    "assessment": result["agent_assessment"]["assessment"],
+                    "agent_verdict": result["agent_verdict"],
+                    "workflow": result["workflow"],
+                    "structured_answer_validation": result["structured_answer_validation"],
+                    "vulnerability_state": result["vulnerability_state"],
+                    "validated_vulnerability": result["validated_vulnerability"],
+                    "tool_call_count": len(result["tool_calls"]),
+                    "queried_symbols": fake.queried_symbols,
+                    "tool_actions": fake.tool_actions,
+                    "enclosing_function": next(({"status": call["result"].get("status"),
+                        "function_name": call["result"].get("function_name"),
+                        "start_line": call["result"].get("function_start_line"),
+                        "end_line": call["result"].get("function_end_line"),
+                        "source_excerpt_bytes": len(call["result"].get("text", "").encode("utf-8"))}
+                        for call in result["tool_calls"]
+                        if call["tool"] == "read_candidate_enclosing_function"), None),
+                    "source_range": {"file": selected["file"], "start_line": range_start_line,
+                                     "line_count": 8} if mode == "tool_agent" else None,
+                    "citation_verified_by_service": bool(fake.citation_verified),
+                    "citation_evidence_policy": result["citation_evidence_policy"],
+                    "cited_evidence_ids": cited_evidence_ids,
+                    "citations_source_only": citations_source_only,
