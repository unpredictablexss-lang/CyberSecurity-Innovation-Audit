diff --git a/research/deliveries/agent/agent-investigation-20261018/reproduce-libtiff-704-asan.sh b/research/deliveries/agent/agent-investigation-20261018/reproduce-libtiff-704-asan.sh
new file mode 100755
index 00000000..e32af674
--- /dev/null
+++ b/research/deliveries/agent/agent-investigation-20261018/reproduce-libtiff-704-asan.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -eu
+
+if [ "$#" -ne 1 ]; then
+    echo "usage: $0 /path/to/libtiff-clone-with-src-4.7.0-and-src-4.7.1" >&2
+    exit 64
+fi
+source_root=$1
+harness_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+work_dir=$(mktemp -d /tmp/ohscanner-libtiff-crop.XXXXXX)
+echo "build and logs: $work_dir"
+
+for version in 4.7.0 4.7.1; do
+    cmake -S "$source_root/src-$version" -B "$work_dir/build-$version" -G Ninja \
+        -Dtiff-tools=OFF -Dtiff-tests=OFF -Dtiff-docs=OFF -Dtiff-contrib=OFF \
+        -Dtiff-install=OFF -Dcxx=OFF -DBUILD_SHARED_LIBS=OFF \
+        -DCMAKE_BUILD_TYPE=Debug \
+        -DCMAKE_C_FLAGS="-O1 -g -fsanitize=address -fno-omit-frame-pointer" \
+        -DCMAKE_EXE_LINKER_FLAGS="-fsanitize=address" >"$work_dir/cmake-$version.log"
+    cmake --build "$work_dir/build-$version" --target tiff -j2 >>"$work_dir/cmake-$version.log"
+    gcc -O1 -g -fsanitize=address -fno-omit-frame-pointer \
+        -I"$source_root/src-$version/libtiff" \
+        -I"$work_dir/build-$version/libtiff" \
+        "$harness_dir/libtiff-crop-raster.c" \
+        "$work_dir/build-$version/libtiff/libtiff.a" -lz -lm \
+        -o "$work_dir/crop-$version"
+done
+
+ulimit -c 0
+cd "$work_dir"
+if ASAN_OPTIONS=halt_on_error=1:detect_leaks=0 \
+    "$work_dir/crop-4.7.0" "$work_dir/palette-16x16.tif" \
+    >"$work_dir/v4.7.0-asan.log" 2>&1; then
+    echo "unexpected: v4.7.0 crop returned successfully" >&2
+    cat "$work_dir/v4.7.0-asan.log" >&2
+    exit 1
+fi
+if ! grep -q "put8bitcmaptile" "$work_dir/v4.7.0-asan.log"; then
+    echo "unexpected v4.7.0 failure; inspect $work_dir/v4.7.0-asan.log" >&2
+    cat "$work_dir/v4.7.0-asan.log" >&2
+    exit 1
+fi
+echo "v4.7.0: expected sanitizer failure in put8bitcmaptile"
+sed -n '1,18p' "$work_dir/v4.7.0-asan.log"
+
+if ! ASAN_OPTIONS=halt_on_error=1:detect_leaks=0 \
+    "$work_dir/crop-4.7.1" "$work_dir/palette-16x16.tif" \
+    >"$work_dir/v4.7.1-asan.log" 2>&1; then
+    echo "unexpected: v4.7.1 crop failed; inspect $work_dir/v4.7.1-asan.log" >&2
+    cat "$work_dir/v4.7.1-asan.log" >&2
+    exit 1
+fi
+grep -qx "read=1" "$work_dir/v4.7.1-asan.log"
+if grep -q "AddressSanitizer" "$work_dir/v4.7.1-asan.log"; then
+    echo "unexpected: v4.7.1 emitted an AddressSanitizer report" >&2
+    cat "$work_dir/v4.7.1-asan.log" >&2
+    exit 1
+fi
+echo "v4.7.1: same crop returned read=1 without an AddressSanitizer report"
