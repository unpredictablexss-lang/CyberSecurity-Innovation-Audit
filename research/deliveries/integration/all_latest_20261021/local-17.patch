+import unittest
+
+from src.workbench.api import ReviewInput
+from src.workbench.confidence import confidence_review
+
+
+class ConfidenceTriageTests(unittest.TestCase):
+    def setUp(self):
+        self.candidate = {"id": "c1", "file": "src/service.cpp", "source_sha256": "a" * 64}
+        self.binding = {
+            "job_id": "j1", "candidate_id": "c1", "repository": "openharmony/demo",
+            "commit": "b" * 40, "git_tree": "c" * 40, "report_sha256": "d" * 64,
+            "source_file": "src/service.cpp", "source_sha256": "a" * 64,
+        }
+        self.result = {
+            "kind": "smart_investigation", "status": "completed", "model_called": True,
+            "binding": dict(self.binding),
+            "source_bindings": {"src/guard.cpp": "e" * 64},
+            "assessment": {
+                "conclusion": "supports_candidate",
+                "summary": "敏感操作前没有找到有效授权检查。",
+                "supporting_evidence": [{
+                    "file": "src/guard.cpp", "start_line": 18, "end_line": 24,
+                    "source_sha256": "e" * 64,
+                }],
+                "counterevidence": [], "unknowns": ["产品入口是否可达"],
+            },
+        }
+
+    def test_no_counterevidence_allows_high_confidence_review_with_unknowns(self):
+        result = confidence_review(self.candidate, self.result, self.binding)
+        self.assertEqual(result["level"], "high_confidence_review")
+        self.assertEqual(result["validated_vulnerability"], 0)
+        self.assertEqual(result["unknowns"], ["产品入口是否可达"])
+
+    def test_read_only_investigation_never_promotes(self):
+        result = confidence_review(
+            self.candidate,
+            {**self.result, "kind": "read_only_investigation", "model_called": False},
+            self.binding,
+        )
+        self.assertEqual(result["level"], "candidate")
+
+    def test_counterevidence_blocks_high_confidence(self):
+        assessment = {
+            **self.result["assessment"],
+            "counterevidence": [{"reason": "authorization check found"}],
+        }
+        result = confidence_review(
+            self.candidate, {**self.result, "assessment": assessment}, self.binding
+        )
+        self.assertEqual(result["level"], "candidate")
+
+    def test_wrong_commit_or_unbound_evidence_blocks_high_confidence(self):
+        wrong_binding = {**self.result, "binding": {**self.binding, "commit": "f" * 40}}
+        self.assertEqual(confidence_review(self.candidate, wrong_binding, self.binding)["level"], "candidate")
+        wrong_source = {
+            **self.result,
+            "source_bindings": {"src/guard.cpp": "0" * 64},
+        }
+        self.assertEqual(confidence_review(self.candidate, wrong_source, self.binding)["level"], "candidate")
+
+    def test_human_actions_are_review_states(self):
+        for status in ("human_confirmed_candidate", "human_false_positive"):
+            record = ReviewInput(status=status, reviewer="reviewer", notes="人工已检查证据。")
+            self.assertEqual(record.status, status)
+
+
+if __name__ == "__main__":
+    unittest.main()
