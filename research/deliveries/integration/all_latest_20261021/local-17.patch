index 00000000..938b1801
--- /dev/null
+++ b/src/workbench/confidence.py
@@ -0,0 +1,81 @@
+"""Human-review triage for detector findings and bound AI investigations."""
+
+
+def confidence_review(candidate, investigation, expected_binding):
+    """Return a display-only tier; this never confirms a vulnerability."""
+    base = {
+        "level": "candidate",
+        "label": "候选",
+        "summary": "尚无完整且绑定到本次源码版本的智能调查结论。",
+        "supporting_evidence": [],
+        "counterevidence": [],
+        "unknowns": [],
+        "human_review_required": True,
+        "validated_vulnerability": 0,
+    }
+    if not isinstance(investigation, dict):
+        return base
+    if (
+        investigation.get("kind") != "smart_investigation"
+        or investigation.get("status") != "completed"
+        or investigation.get("model_called") is not True
+    ):
+        return {**base, "summary": "智能调查未完整调用模型；静态命中仍作为候选复核。"}
+    binding = investigation.get("binding")
+    if not isinstance(binding, dict) or not expected_binding:
+        return {**base, "summary": "智能调查缺少候选与源码版本绑定。"}
+    if any(not value or binding.get(key) != value for key, value in expected_binding.items()):
+        return {**base, "summary": "智能调查与当前候选或源码版本不一致。"}
+
+    assessment = investigation.get("assessment")
+    if not isinstance(assessment, dict):
+        return {**base, "summary": "智能调查没有结构化的支持与反证结论。"}
+    counterevidence = assessment.get("counterevidence")
+    if not isinstance(counterevidence, list):
+        return {**base, "summary": "智能调查没有明确记录反向证据检查结果。"}
+    unknowns = assessment.get("unknowns", [])
+    if counterevidence:
+        return {
+            **base,
+            "summary": "智能调查发现反向证据，暂不列为高可信。",
+            "counterevidence": counterevidence[:20],
+            "unknowns": unknowns[:20] if isinstance(unknowns, list) else [],
+        }
+    if assessment.get("conclusion") != "supports_candidate":
+        return {**base, "summary": "智能调查未明确支持该候选，暂保留候选状态。"}
+
+    summary = assessment.get("summary")
+    refs = assessment.get("supporting_evidence")
+    source_bindings = investigation.get("source_bindings")
+    if not isinstance(summary, str) or not summary.strip() or not isinstance(refs, list) or not refs or not isinstance(source_bindings, dict):
+        return {**base, "summary": "智能调查缺少可展示的源码证据或结论摘要。"}
+
+    validated = []
+    for item in refs[:20]:
+        if not isinstance(item, dict):
+            return {**base, "summary": "智能调查的源码支持证据格式无法核验。"}
+        file, start, end, digest = item.get("file"), item.get("start_line"), item.get("end_line"), item.get("source_sha256")
+        if (
+            not isinstance(file, str) or not file
+            or not isinstance(start, int) or not isinstance(end, int)
+            or start < 1 or end < start
+            or not isinstance(digest, str)
+            or source_bindings.get(file) != digest
+        ):
+            return {**base, "summary": "智能调查的源码支持证据未绑定到固定源码对象。"}
+        validated.append({
+            "file": file, "start_line": start, "end_line": end,
+            "source_sha256": digest, "reason": str(item.get("reason") or "")[:500],
+        })
+    if not isinstance(unknowns, list):
+        unknowns = ["部分调查问题尚未解决"]
+    return {
+        "level": "high_confidence_review",
+        "label": "高可信 · 待人工复核",
+        "summary": summary.strip()[:1000],
+        "supporting_evidence": validated,
+        "counterevidence": [],
+        "unknowns": [str(x)[:500] for x in unknowns[:20]],
+        "human_review_required": True,
+        "validated_vulnerability": 0,
+    }
