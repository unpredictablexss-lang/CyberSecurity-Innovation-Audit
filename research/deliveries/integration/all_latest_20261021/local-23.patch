+            result = {"quick_status": "quick_unknown", "quick_assessment": "insufficient_context",
+                "reason": "provider_or_schema_failure", "error_type": type(exc).__name__,
+                "finding_state": "candidate", "validated_vulnerability": 0}
+        ledger.record_quick_result(task_id, group_id,
+            consent_sha256=authorization["consent_sha256"],
+            provider_fingerprint=authorization["provider_fingerprint"], model=authorization["model"],
+            prompt_version=PROMPT_VERSION, schema_version=SCHEMA_VERSION,
+            evidence_manifest=[{"evidence_id": item["evidence_id"], "file": item["file"],
+                "source_sha256": item["source_sha256"], "excerpt_sha256": item["excerpt_sha256"]}
+                for item in prepared], result=result)
+        return result
+    except Exception as exc:
+        return {"quick_status": "quick_unknown", "quick_assessment": "insufficient_context",
+                "reason": "authorization_or_input_rejected", "error_type": type(exc).__name__,
+                "finding_state": "candidate", "validated_vulnerability": 0}
