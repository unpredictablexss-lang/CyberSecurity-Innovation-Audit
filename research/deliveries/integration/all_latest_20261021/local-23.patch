+                    "provider_fingerprint": authorization["provider_fingerprint"],
+                    "model": authorization["model"], "prompt_version": PROMPT_VERSION,
+                    "schema_version": SCHEMA_VERSION, "provider_usage": usage,
+                    "budget_settlement": settled}
+        except Exception as exc:
