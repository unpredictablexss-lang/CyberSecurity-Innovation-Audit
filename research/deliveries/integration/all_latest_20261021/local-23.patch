+  });
+  if (!response.ok) {
+    const error = await response.json().catch(() => ({ detail: response.statusText }));
+    throw new Error(typeof error.detail === "string" ? error.detail : JSON.stringify(error.detail));
+  }
+  return response.json();
+}
