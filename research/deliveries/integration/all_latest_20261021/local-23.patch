+                parsed = json.loads(_response_text(response))
+                answer = _result_shape(parsed, allowed_ids)
+                result = {**answer, "quick_status": "completed", "review_status": "model_unverified",
+                    "finding_state": "candidate", "validated_vulnerability": 0,
+                    "source_binding": {key: authorization[key] for key in
